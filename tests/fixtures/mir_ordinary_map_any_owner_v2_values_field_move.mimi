type Label { text: string }

func main() -> i32 {
    let label = Label { text: "expected" }
    match map_new() {
        Ok(empty) => {
    match map_set(empty, "label", label) {
        Ok(root) => {
            let snapshot = values(root)
            let item = snapshot[0] as Label
            let text = item.text
            drop(snapshot)
            drop(empty)
            drop(root)
            drop(label)
            let matches = text == "expected"
            let differs = text != "unexpected"
            println(matches)
            println(differs)
            drop(text)
            0
        },
        Err(status) => {
        drop(empty)
        status
        },
    }
        },
        Err(status) => {
        status
        },
    }
}
