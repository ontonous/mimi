// S176 positive: a four-field mixed-ABI owned update carries three residual moves.
type Patch<T> { value: T, label: string, note: string, tail: string }

func replace<T>(patch: Patch<T>) -> Patch<T> {
    Patch { label: "replaced", ..patch }
}

func main() -> i32 {
    ensures: result == result
    let patch = Patch { value: 41, label: "old", note: "note", tail: "tail" }
    let updated = replace(patch)
    drop(updated)
    41
}
