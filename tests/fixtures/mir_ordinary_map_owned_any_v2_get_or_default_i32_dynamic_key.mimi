use std::maps;

func main() -> i32 {
    let empty_result: Result<Record, i32> = map_new()
    match empty_result {
        Ok(empty) => {
            let root_result: Result<Record, i32> = map_set(empty, "hits", 0)
            match root_result {
                Ok(root) => {
                    let prefix = "h"
                    let suffix = "its"
                    let dynamic_key = prefix + suffix
                    let observed = get_or_default::<i32>(root, dynamic_key, 73)
                    drop(empty)
                    drop(root)
                    println(observed)
                    0
                },
                Err(status) => {
                    drop(empty)
                    status
                },
            }
        },
        Err(status) => status,
    }
}
