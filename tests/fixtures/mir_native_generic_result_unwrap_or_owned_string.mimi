// Generic Result<T, i32>.unwrap_or specialized to the canonical consuming
// Result<string, i32> fallback contract.
func unwrap_or<T>(value: Result<T, i32>, fallback: T) -> T {
    value.unwrap_or(fallback)
}

func main() -> i32 {
    ensures: result == result
    let value: Result<string, i32> = Ok("owned")
    let out = unwrap_or(value, "fallback")
    drop(out)
    41
}
