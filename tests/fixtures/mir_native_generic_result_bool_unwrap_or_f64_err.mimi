// Generic heterogeneous Result<T, bool> unwrap_or selects the explicit f64
// fallback on Err.
func unwrap_or<T>(value: Result<T, bool>, fallback: T) -> T {
    value.unwrap_or(fallback)
}

func main() -> i64 {
    let value: Result<f64, bool> = Err(true)
    let out = unwrap_or(value, 7.25)
    42
}
