// Float output remains outside the scalar stdout effect contract and must
// fail closed under --mir; only bool, signed i32/i64 and (since R6-1050) the
// owned StringHandle print face are admitted.
func main() -> i32 {
    ensures: result == 0
    let values: Set<i32> = {4, 1}
    println(contains(values, 1))
    println(0.5)
    drop(values)
    0
}
