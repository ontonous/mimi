// R6-1072: the comparison operand domain admits face-closure calls — the
// callee is one face edge from main's float print, and the compared call
// rides the verifier's symbolic execution of the callee body.  Direct
// comparison, arithmetic over the call, and negate over the call all
// route canonical with the native MIR binary agreeing byte-for-byte.
// Expected stdout: "0.5\n7\n8\n11\n" (all three predicates hold:
// 0.5 < 1.5, 1.0 < 1.5, -0.5 < 0.0).
func value() -> f64 {
    0.5
}
func main() -> i32 {
    println(0.5)
    if value() < 1.5 {
        println(7)
    }
    if value() * 2.0 < 1.5 {
        println(8)
    }
    if -value() < 0.0 {
        println(11)
    }
    0
}
