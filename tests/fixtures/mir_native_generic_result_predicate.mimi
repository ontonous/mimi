func is_ok<T>(value: Result<T, i32>) -> bool {
    value.is_ok()
}

func is_err<T>(value: Result<T, i32>) -> bool {
    value.is_err()
}

func main() -> i32 {
    ensures: result == result
    let ok: Result<i32, i32> = Ok(41)
    let err: Result<i32, i32> = Err(7)
    if is_ok(ok) && is_err(err) { 41 } else { 0 }
}
