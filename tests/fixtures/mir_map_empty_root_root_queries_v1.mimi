func main() -> i32 {
    match map_new() {
        Ok(root) => {
            let pair = map_get(root, "missing")
            let snapshot = values(root)
            let count = snapshot.len()
            drop(pair)
            drop(count)
            drop(snapshot)
            drop(root)
            0
        },
        Err(status) => status,
    }
}
