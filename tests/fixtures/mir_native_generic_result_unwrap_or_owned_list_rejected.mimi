// Result<List<string>, i32> remains outside the admitted List<Copy scalar>
// move glue family and must fail closed before all consumers.
func unwrap_or<T>(value: Result<T, i32>, fallback: T) -> T {
    value.unwrap_or(fallback)
}

func main() -> i32 {
    let values: List<string> = ["owned"]
    let value: Result<List<string>, i32> = Ok(values)
    let fallback: List<string> = ["fallback"]
    let out = unwrap_or(value, fallback)
    drop(out)
    0
}
