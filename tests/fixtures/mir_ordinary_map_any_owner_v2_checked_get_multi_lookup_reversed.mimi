func main() -> bool {
    match map_new() {
        Ok(empty) => {
        match map_set(empty, "text", "owned\0 payload λ") {
            Ok(root) => {
        let miss_pair = map_get(root, "absent")
        let hit_pair = map_get(root, "text")

        drop(empty)
        drop(root)

        let miss_found = miss_pair.0
        let miss_payload = unpack_i32(miss_pair.1)
        let hit_found = hit_pair.0
        let hit_payload = unpack_string(hit_pair.1)
        drop(miss_pair)
        drop(hit_pair)

        let hit_text_matches = hit_payload == "owned\0 payload λ"
        let miss_is_zero = miss_payload == 0
        drop(hit_payload)
        let outcome = (hit_found != miss_found) && hit_text_matches && miss_is_zero
        outcome
            },
            Err(status) => {
            drop(empty)
            false
            },
        }
        },
        Err(status) => {
        false
        },
    }
}
