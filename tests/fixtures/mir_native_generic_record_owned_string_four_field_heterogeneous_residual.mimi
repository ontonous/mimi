// Canonical generic MIR candidate: move one owned String field while three
// fixed owned String siblings are discharged by the residual receipt.
type QuadTagged<T> { value: T, note: string, tail: string, spare: string }

func take_value<T>(quad: QuadTagged<T>) -> T {
    quad.value
}

func main() -> i32 {
    ensures: result == result
    let quad = QuadTagged { value: "selected", note: "note", tail: "tail", spare: "spare" }
    let picked = take_value(quad)
    drop(picked)
    41
}
