use std::maps;

func main() -> i32 {
    let payload = "stored hit"
    let empty_result = map_new()
    match empty_result {
        Ok(empty) => {
            let initial_result = map_set(empty, "hits", payload)
            match initial_result {
                Ok(initial) => {
                    let root_result = map_set(initial, "extra", "additional value")
                    match root_result {
                        Ok(root) => {
                            let observed = get_or_default::<string>(root, "hits", "fallback")
                            println(observed)
                            drop(observed)
                            drop(empty)
                            drop(initial)
                            drop(root)
                            drop(payload)
                            0
                        },
                        Err(status) => {
                            drop(empty)
                            drop(initial)
                            drop(payload)
                            status
                        },
                    }
                },
                Err(status) => {
                    drop(empty)
                    drop(payload)
                    status
                },
            }
        },
        Err(status) => {
            drop(payload)
            status
        },
    }
}
