use std::maps;

actor Reader {
    func lookup() -> i32 {
        let empty_result = map_new()
        match empty_result {
            Ok(empty) => {
                let root_result = map_set(empty, "hits", 0)
                match root_result {
                    Ok(root) => {
                        let observed = get_or_default::<i32>(root, "hits", 99)
                        drop(empty)
                        drop(root)
                        observed
                    },
                    Err(status) => {
                        drop(empty)
                        status
                    },
                }
            },
            Err(status) => status,
        }
    }
}

func main() -> i32 {
    let reader = Reader.spawn()
    reader.lookup()
}
