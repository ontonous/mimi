// Generic Result<T, bool>.unwrap specialized to the canonical move-owned
// String Ok payload while the Err slot remains a distinct Copy bool.
func unwrap_bool_owned<T>(value: Result<T, bool>) -> T {
    value.unwrap()
}

func main() -> i32 {
    ensures: result == result
    let value: Result<string, bool> = Ok("owned")
    let out = unwrap_bool_owned(value)
    drop(out)
    41
}
