// Canonical generic MIR candidate: consume one owned String field from Box<T>.
type Box<T> { value: T }

func take<T>(boxed: Box<T>) -> T {
    boxed.value
}

func main() -> i32 {
    ensures: result == result
    let boxed = Box { value: "owned" }
    let picked = take(boxed)
    drop(picked)
    41
}
