// S209 negative: mixed List/String residual count exceeds the bounded shape.
type Quad<T> { value: T, tail: List<i32>, note: string, spare: List<i32> }

func take<T>(quad: Quad<T>) -> T {
    quad.value
}

func main() -> i64 {
    let quad: Quad<List<i32>> = Quad { value: [1, 2], tail: [3, 4], note: "residual", spare: [5, 6] }
    let picked = take(quad)
    drop(picked)
    42
}
