func checked_map_size(value: i32) -> i32 {
    requires: value >= 0
    ensures: result == 1 || result == 2 || result == 3
    match map_new() {
        Ok(root) => match map_set(root, "answer", value) {
            Ok(updated) => {
                let size = map_size(updated)
                drop(root)
                drop(updated)
                size
            },
            Err(status) => {
                drop(root)
                status
            },
        },
        Err(status) => status,
    }
}

func main() -> i32 {
    let size = checked_map_size(73)
    println(size)
    0
}
