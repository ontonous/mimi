use std::maps;

func main() -> i32 {
    let payload = "stored hit"
    let empty_result = map_new()
    match empty_result {
        Ok(empty) => {
            let root_result = map_set(empty, "hits", payload)
            match root_result {
                Ok(root) => {
                    let first = get_or_default::<string>(root, "hits", "first fallback")
                    let second = get_or_default::<string>(root, "other", "second fallback")
                    println(first)
                    println(second)
                    drop(first)
                    drop(second)
                    drop(empty)
                    drop(root)
                    drop(payload)
                    0
                },
                Err(status) => {
                    drop(empty)
                    drop(payload)
                    status
                },
            }
        },
        Err(status) => {
            drop(payload)
            status
        },
    }
}
