// S175 negative: owned generic updates stay bounded to three residual fields.
type WidePatch<T> { value: T, label: string, extra: string, tail: string }

func replace<T>(patch: WidePatch<T>) -> WidePatch<T> {
    WidePatch { label: "replaced", ..patch }
}

func main() -> i32 {
    ensures: result == result
    let patch = WidePatch { value: "payload", label: "old", extra: "extra", tail: "tail" }
    let updated = replace(patch)
    drop(updated)
    41
}
