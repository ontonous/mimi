// R6-1068: the f64 comparison face is admitted across the consumer
// triangle — the plain IEEE ordered predicates (ordering, equality, and
// the +0.0 == -0.0 identity the reference executor must decode to f64
// before comparing) all route canonical and print 1 on every backend.
func main() -> i32 {
    if 0.5 < 1.5 {
        println(1)
    } else {
        println(0)
    }
    let a = 2.5
    if a == 2.5 {
        println(1)
    } else {
        println(0)
    }
    if 0.5 != 1.5 {
        println(1)
    } else {
        println(0)
    }
    let x = -1.0 * 0.0
    if x == 0.0 {
        println(1)
    } else {
        println(0)
    }
    0
}
