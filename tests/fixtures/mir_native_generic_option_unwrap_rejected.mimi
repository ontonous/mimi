func unwrap<T>(value: Option<T>) -> T {
    value.unwrap()
}

func main() -> i32 {
    // Managed/nested payloads remain outside the generic Option projection
    // island even though Copy f64 is now admitted by the dedicated receipt.
    let value: Option<List<f64>> = Some([41.0])
    let out = unwrap(value)
    41
}
