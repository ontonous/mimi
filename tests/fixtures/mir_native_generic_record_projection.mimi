// Canonical generic MIR candidate: borrow one Copy scalar field from Box<T>.
type Box<T> { value: T }

func get<T>(boxed: Box<T>) -> T {
    boxed.value
}

func main() -> i32 {
    // The verifier proves the identity contract; reference/native return 41.
    ensures: result == result
    let boxed = Box { value: 41 }
    let picked = get(boxed)
    picked
}
