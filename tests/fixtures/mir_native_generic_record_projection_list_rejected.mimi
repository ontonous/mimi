// Generic Record<T> nested List projection remains outside the managed record
// projection ABI. The current move-owned record island admits List<Copy
// scalar>, but nested containers require a dedicated record-field ABI receipt.
type Box<T> { value: T }

func get<T>(boxed: Box<T>) -> T {
    boxed.value
}

func main() -> i64 {
    let boxed: Box<List<List<i32>>> = Box { value: [[41]] }
    let picked = get(boxed)
    drop(picked)
    42
}
