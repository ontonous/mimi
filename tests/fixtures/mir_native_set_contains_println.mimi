// Canonical effect contract: SetOp::Contains feeds the Copy-bool
// BuiltinCall::PrintlnBool stdout-line effect.
func main() -> i32 {
    ensures: result == 0
    let values: Set<i32> = {4, 1, 1}
    println(contains(values, 1))
    println(contains(values, 7))
    println(contains(values, 4))
    drop(values)
    0
}
