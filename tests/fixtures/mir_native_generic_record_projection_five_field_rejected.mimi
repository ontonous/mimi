// Outside S170: generic Copy record projection with five fields remains
// rejected before any backend or legacy route.
type Quint<T> { value: T, tag: i32, enabled: bool, extra: i64, tail: i32 }

func get_value<T>(quint: Quint<T>) -> T {
    quint.value
}

func main() -> i32 {
    ensures: result == result
    let quint = Quint { value: 41, tag: 7, enabled: true, extra: 9, tail: 11 }
    get_value(quint)
}
