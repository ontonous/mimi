// A bare List construction is outside the ordinary Map/Any scalar-tail
// receipt.  The route must reject this composition before either backend is
// selected; `drop(values)` is deliberately the only List use so no ListOp
// candidate can hide the collection boundary.
func main() -> i32 {
    match map_new() {
        Ok(empty) => {
            match map_set(empty, "answer", 1) {
                Ok(root) => {
                    let typed = map_get_i32(root, "answer")
                    match typed {
                        Ok(value) => { drop(value) },
                        Err(status) => { drop(status) },
                    }

                    let values = [1, 2, 3]
                    println(1)
                    drop(values)
                    drop(empty)
                    drop(root)
                    0
                },
                Err(status) => {
                    drop(empty)
                    status
                },
            }
        },
        Err(status) => { status },
    }
}
