// Canonical MIR verifier: Copy Option/Result construction, exhaustive Switch,
// payload binding, branch merge, and concrete reference/native execution.
func classify_option(value: Option<i32>) -> i32 {
    ensures: result >= 0
    match value {
        Some(v) => if v >= 0 { 1 } else { 0 },
        None => 0
    }
}

func classify_option_default(value: Option<i32>) -> i32 {
    ensures: result >= 0
    match value {
        Some(v) => if v >= 0 { 1 } else { 0 },
        _ => 0
    }
}

func classify_result(value: Result<i32, i32>) -> i32 {
    ensures: result >= 0
    match value {
        Ok(v) => if v >= 0 { 1 } else { 0 },
        Err(e) => if e >= 0 { 1 } else { 0 }
    }
}

func main() -> i32 {
    let option = Some(-41)
    let option_score = classify_option(option)
    let default_score = classify_option_default(option)
    let result: Result<i32, i32> = Err(-7)
    option_score + default_score + classify_result(result)
}
