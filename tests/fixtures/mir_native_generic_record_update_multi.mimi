// S172 positive: two concrete Copy-scalar overrides with declaration-order receipt.
type Patch<T> { value: T, tag: i32, enabled: bool }

func retag<T>(patch: Patch<T>) -> Patch<T> {
    Patch { enabled: true, tag: 9, ..patch }
}

func main() -> i32 {
    ensures: result == result
    let patch = Patch { value: 41, tag: 7, enabled: false }
    let updated = retag(patch)
    updated.value
}
