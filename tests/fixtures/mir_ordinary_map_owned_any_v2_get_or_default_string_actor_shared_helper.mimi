use std::maps;

func lookup() -> Result<string, i32> {
    let payload = "helper hit"
    let empty_result = map_new()
    match empty_result {
        Ok(empty) => {
            let root_result = map_set(empty, "hits", payload)
            match root_result {
                Ok(root) => {
                    let observed = get_or_default::<string>(root, "hits", "fallback")
                    drop(empty)
                    drop(root)
                    drop(payload)
                    Ok(observed)
                },
                Err(status) => {
                    drop(empty)
                    drop(payload)
                    Err(status)
                },
            }
        },
        Err(status) => {
            drop(payload)
            Err(status)
        },
    }
}

actor Reader {
    func lookup_from_actor() -> i32 {
        match lookup() {
            Ok(actor_value) => {
                drop(actor_value)
                0
            },
            Err(status) => status,
        }
    }
}

func main() -> i32 {
    let reader = Reader.spawn()
    let actor_status = reader.lookup_from_actor()
    match lookup() {
        Ok(observed) => {
            println(observed)
            drop(observed)
            actor_status
        },
        Err(status) => status,
    }
}
