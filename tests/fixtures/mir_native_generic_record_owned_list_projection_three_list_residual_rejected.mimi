// S208 negative: three concrete List residuals exceed the bounded contract.
type Quad<T> { value: T, tail: List<i32>, spare: List<i32>, extra: List<i32> }

func take<T>(quad: Quad<T>) -> T {
    quad.value
}

func main() -> i64 {
    let quad: Quad<List<i32>> = Quad { value: [1, 2], tail: [3, 4], spare: [5, 6], extra: [7, 8] }
    let picked = take(quad)
    drop(picked)
    42
}
