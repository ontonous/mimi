// Canonical MIR Copy Result<i32, i32> match face (binding arms).
func pick(r: Result<i32, i32>) -> i32 {
    ensures: result >= 0
    match r {
        Ok(x) => 41,
        Err(e) => 7,
    }
}

func main() -> i32 {
    let ok: Result<i32, i32> = Ok(1)
    let bad: Result<i32, i32> = Err(2)
    pick(ok) + pick(bad) - 48
}
