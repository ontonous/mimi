func main() -> bool {
    match map_new() {
        Ok(empty) => {
        match map_set(empty, "hit", 0) {
            Ok(root) => {
        let hit_pair = map_get(root, "hit")
        let miss_pair = map_get(root, "absent")

        drop(empty)
        drop(root)

        let hit_found = hit_pair.0
        let hit_payload = unpack_i32(hit_pair.1)
        let miss_found = miss_pair.0
        let miss_payload = unpack_i32(miss_pair.1)
        drop(hit_pair)
        drop(miss_pair)

        let outcome: bool = hit_found && hit_payload == 0 && !miss_found && miss_payload == 0
        println(outcome)
        outcome
            },
            Err(status) => {
            drop(empty)
            false
            },
        }
        },
        Err(status) => {
        false
        },
    }
}
