type Label { text: string }

func main() -> i32 {
    let label = Label { text: "owned label" }
    match map_new() {
        Ok(empty) => {
            match map_set(empty, "answer", 42) {
                Ok(one) => {
                    match map_set(one, "label", label) {
                        Ok(two) => {
                            match map_set(two, "label", 99) {
                                Ok(overwritten) => {
                                    let removed = map_remove(two, "label")
                                    map_size(empty)
                                    map_size(one)
                                    map_size(two)
                                    map_size(overwritten)
                                    map_size(removed)
                                    has_key(two, "label")
                                    has_key(overwritten, "label")
                                    has_key(removed, "label")
                                    println(label.text)
                                    drop(empty)
                                    drop(one)
                                    drop(two)
                                    drop(overwritten)
                                    drop(removed)
                                    drop(label)
                                    0
                                },
                                Err(status) => {
                                    drop(empty)
                                    drop(one)
                                    drop(two)
                                    drop(label)
                                    status
                                },
                            }
                        },
                        Err(status) => {
                            drop(empty)
                            drop(one)
                            drop(label)
                            status
                        },
                    }
                },
                Err(status) => {
                    drop(empty)
                    drop(label)
                    status
                },
            }
        },
        Err(status) => {
            drop(label)
            status
        },
    }
}
