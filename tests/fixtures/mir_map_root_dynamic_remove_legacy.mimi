func main() -> i32 {
    match map_new() {
        Ok(root) => {
            match map_set(root, "answer", 42) {
                Ok(inserted) => {
                    drop(root)
                    let key = "answer"
                    let removed = map_remove(inserted, key)
                    drop(key)
                    drop(inserted)
                    drop(removed)
                    0
                },
                Err(status) => {
                    drop(root)
                    status
                },
            }
        },
        Err(status) => status,
    }
}
