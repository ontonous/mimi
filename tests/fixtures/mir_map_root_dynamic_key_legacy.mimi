func main() -> i32 {
    match map_new() {
        Ok(root) => {
            let key = "answer"
            match map_set(root, key, 42) {
                Ok(updated) => {
                    drop(root)
                    drop(updated)
                    0
                },
                Err(status) => {
                    drop(root)
                    status
                },
            }
        },
        Err(status) => {
            status
        },
    }
}
