// Generic Result<T, i32>.unwrap specialized to the canonical move-owned String ABI.
func unwrap<T>(value: Result<T, i32>) -> T {
    value.unwrap()
}

func main() -> i32 {
    ensures: result == result
    let value: Result<string, i32> = Ok("owned")
    let out = unwrap(value)
    drop(out)
    41
}
