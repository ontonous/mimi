func main() -> bool {
    let prefix = args()[0]
    let suffix = "\0雪"
    let key = prefix + suffix
    match map_new() {
        Ok(empty) => {
    match map_set(empty, key, 0) {
        Ok(root) => {
            let miss_pair = map_get(empty, key)
            let snapshot = keys(root)
            let copied = snapshot[0]
            let hit_pair = map_get(root, key)

            drop(empty)
            drop(root)
            drop(snapshot)
            drop(prefix)
            drop(suffix)
            drop(key)

            let miss_found = miss_pair.0
            let miss_payload = unpack_i32(miss_pair.1)
            let hit_found = hit_pair.0
            let hit_payload = unpack_i32(hit_pair.1)
            drop(miss_pair)
            drop(hit_pair)
            println(copied)
            drop(copied)

            let outcome = hit_found && hit_payload == 0 && !miss_found && miss_payload == 0
            println(outcome)
            outcome
        },
        Err(status) => {
        drop(empty)
        false
        },
    }
        },
        Err(status) => {
        false
        },
    }
}
