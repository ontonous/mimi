// Direct concrete Result<f64, i32> remains outside the promoted generic
// fallback island; only the generic envelope may admit this f64 ABI.
func unwrap_or(value: Result<f64, i32>, fallback: f64) -> f64 {
    value.unwrap_or(fallback)
}

func main() -> i64 {
    let value: Result<f64, i32> = Ok(41.5)
    let out = unwrap_or(value, 7.25)
    42
}
