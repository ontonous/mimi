// Generic Result<T, T> unwrap_or with an admitted Copy bool specialization.
func unwrap_or<T>(value: Result<T, T>, fallback: T) -> T {
    value.unwrap_or(fallback)
}

func main() -> i32 {
    ensures: result == result
    let selected = unwrap_or(Err(true), false)
    if selected { 1 } else { 0 }
}
