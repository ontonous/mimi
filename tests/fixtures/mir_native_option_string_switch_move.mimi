func consume(value: Option<string>) -> i32 {
    ensures: result >= 0
    match value {
        Some(_) => 41,
        None => 0
    }
}

func discard(value: Option<string>) -> i32 {
    ensures: result >= 0
    match value {
        Some(_) => 7,
        None => 8
    }
}

func main() -> i32 {
    let first: Option<string> = Some("owned")
    let second: Option<string> = Some("discard")
    let a = consume(first)
    let b = discard(second)
    a + b
}
