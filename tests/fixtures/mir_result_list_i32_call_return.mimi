func make_ok() -> Result<List<i32>, i32> {
    Ok([1, 2, 3])
}

func make_err() -> Result<List<i32>, i32> {
    Err(7)
}

func use_ok() -> i32 {
    ensures: result == 41
    let value = make_ok()
    match value {
        Ok(_) => 41,
        Err(code) => code
    }
}

func use_err() -> i32 {
    ensures: result == 7
    let value = make_err()
    match value {
        Ok(_) => 41,
        Err(code) => code
    }
}

func main() -> i32 {
    use_ok() + use_err()
}
