// Configuration JSON parser boundary. C1 can replace this file with another
// implementation of the same public parse signature without changing the
// command, file loop, or report builder.

pub func config_whitespace(ch: string) -> bool {
    ch == " " || ch == "\n" || ch == "\r" || ch == "\t"
}

pub func config_has_unicode_nul(raw: string) -> bool {
    let mut in_string = false
    let mut escaped = false
    let mut found = false
    let mut i = 0
    while i < len(raw) && !found {
        let ch = char_at(raw, i)
        if in_string {
            if escaped {
                if ch == "u"
                    && i + 4 < len(raw)
                    && char_at(raw, i + 1) == "0"
                    && char_at(raw, i + 2) == "0"
                    && char_at(raw, i + 3) == "0"
                    && char_at(raw, i + 4) == "0" {
                    found = true
                }
                escaped = false
            } else if ch == "\\" {
                escaped = true
            } else if ch == "\"" {
                in_string = false
            }
        } else if ch == "\"" {
            in_string = true
        }
        i = i + 1
    }
    found
}

// JSON builtins discard duplicate-key information. This scanner decodes each
// top-level key token and identifies repeats before field access.
pub func config_duplicate_top_level_key(raw: string) -> string {
    let mut seen: List<string> = []
    let mut duplicate = ""
    let mut depth = 0
    let mut in_string = false
    let mut escaped = false
    let mut string_start = 0
    let mut i = 0
    while i < len(raw) && duplicate == "" {
        let ch = char_at(raw, i)
        if in_string {
            if escaped {
                escaped = false
            } else if ch == "\\" {
                escaped = true
            } else if ch == "\"" {
                in_string = false
                if depth == 1 {
                    let mut next = i + 1
                    while next < len(raw) && config_whitespace(char_at(raw, next)) {
                        next = next + 1
                    }
                    if next < len(raw) && char_at(raw, next) == ":" {
                        let key_json = "\"" + str_substring(raw, string_start + 1, i) + "\""
                        let key = from_json::<string>(key_json)
                        let mut repeated = false
                        for earlier in seen {
                            if earlier == key { repeated = true }
                        }
                        if repeated {
                            duplicate = key
                        } else {
                            push(seen, key)
                        }
                    }
                }
            }
        } else if ch == "\"" {
            in_string = true
            string_start = i
        } else if ch == "{" {
            depth = depth + 1
        } else if ch == "}" {
            depth = depth - 1
        }
        i = i + 1
    }
    duplicate
}

// Raw scalar extraction lets the parser reject a quoted number instead of
// relying on json_get_int's runtime trap for a schema type mismatch.
pub func config_field_raw_value(raw: string, target: string) -> string {
    let mut depth = 0
    let mut in_string = false
    let mut escaped = false
    let mut string_start = 0
    let mut i = 0
    let mut result = ""
    while i < len(raw) && result == "" {
        let ch = char_at(raw, i)
        if in_string {
            if escaped {
                escaped = false
            } else if ch == "\\" {
                escaped = true
            } else if ch == "\"" {
                in_string = false
                if depth == 1 {
                    let mut next = i + 1
                    while next < len(raw) && config_whitespace(char_at(raw, next)) {
                        next = next + 1
                    }
                    if next < len(raw) && char_at(raw, next) == ":" {
                        let key_json = "\"" + str_substring(raw, string_start + 1, i) + "\""
                        let key = from_json::<string>(key_json)
                        if key == target {
                            let mut value_start = next + 1
                            while value_start < len(raw)
                                && config_whitespace(char_at(raw, value_start)) {
                                value_start = value_start + 1
                            }
                            if value_start < len(raw) && char_at(raw, value_start) == "\"" {
                                let mut value_end = value_start + 1
                                let mut value_escaped = false
                                let mut closed = false
                                while value_end < len(raw) && !closed {
                                    let value_ch = char_at(raw, value_end)
                                    if value_escaped {
                                        value_escaped = false
                                    } else if value_ch == "\\" {
                                        value_escaped = true
                                    } else if value_ch == "\"" {
                                        closed = true
                                    }
                                    if !closed { value_end = value_end + 1 }
                                }
                                if closed {
                                    result = str_substring(raw, value_start, value_end + 1)
                                }
                            } else if value_start < len(raw)
                                && (char_at(raw, value_start) == "["
                                    || char_at(raw, value_start) == "{") {
                                let mut value_end = value_start
                                let mut value_depth = 0
                                let mut value_in_string = false
                                let mut value_escaped = false
                                let mut closed = false
                                while value_end < len(raw) && !closed {
                                    let value_ch = char_at(raw, value_end)
                                    if value_in_string {
                                        if value_escaped {
                                            value_escaped = false
                                        } else if value_ch == "\\" {
                                            value_escaped = true
                                        } else if value_ch == "\"" {
                                            value_in_string = false
                                        }
                                    } else if value_ch == "\"" {
                                        value_in_string = true
                                    } else if value_ch == "[" || value_ch == "{" {
                                        value_depth = value_depth + 1
                                    } else if value_ch == "]" || value_ch == "}" {
                                        value_depth = value_depth - 1
                                        if value_depth == 0 { closed = true }
                                    }
                                    value_end = value_end + 1
                                }
                                if closed {
                                    result = str_substring(raw, value_start, value_end)
                                }
                            } else if value_start < len(raw) {
                                let mut value_end = value_start
                                while value_end < len(raw)
                                    && char_at(raw, value_end) != ","
                                    && char_at(raw, value_end) != "}" {
                                    value_end = value_end + 1
                                }
                                result = str_trim(str_substring(raw, value_start, value_end))
                            }
                        }
                    }
                }
            }
        } else if ch == "\"" {
            in_string = true
            string_start = i
        } else if ch == "{" {
            depth = depth + 1
        } else if ch == "}" {
            depth = depth - 1
        }
        i = i + 1
    }
    result
}

pub func parse(raw: string) -> Result<(string, i64, List<string>), string> {
    if !json_is_valid(raw) { return Err("InvalidJson") }
    if config_has_unicode_nul(raw) { return Err("InvalidUnicodeNul") }
    let duplicate = config_duplicate_top_level_key(raw)
    if duplicate != "" { return Err("DuplicateKey:" + duplicate) }
    if !json_has_key(raw, "name") { return Err("MissingField:name") }
    if !json_has_key(raw, "retries") { return Err("MissingField:retries") }
    if !json_has_key(raw, "files") { return Err("MissingField:files") }

    let name_json = config_field_raw_value(raw, "name")
    if len(name_json) < 2
        || char_at(name_json, 0) != "\""
        || char_at(name_json, len(name_json) - 1) != "\"" {
        return Err("InvalidField:name")
    }
    let name = from_json::<string>(name_json)
    if len(name) == 0 { return Err("InvalidField:name") }

    let retries_text = config_field_raw_value(raw, "retries")
    let parsed_retries = str_parse_int(retries_text)
    if !parsed_retries.0 { return Err("InvalidField:retries") }
    let retries = parsed_retries.1
    if retries < 0 || retries > 100 { return Err("InvalidField:retries") }

    let files_json = str_trim(config_field_raw_value(raw, "files"))
    if len(files_json) < 2
        || char_at(files_json, 0) != "["
        || char_at(files_json, len(files_json) - 1) != "]" {
        return Err("InvalidField:files")
    }
    let file_count = json_array_length(files_json)
    if file_count > 10000 { return Err("TooManyFiles") }
    let mut files: List<string> = []
    let mut i = 0
    while i < file_count {
        let item_json = str_trim(json_get_element(files_json, i))
        if len(item_json) < 2
            || char_at(item_json, 0) != "\""
            || char_at(item_json, len(item_json) - 1) != "\"" {
            return Err("InvalidField:files")
        }
        let item = from_json::<string>(item_json)
        if item == "" { return Err("InvalidField:files") }
        push(files, item)
        i = i + 1
    }
    Ok((name, retries, files))
}
