// SEQ-W2/D3: ChecksumMismatch extends the existing export error set. The
// error is produced by comparing bytes read back from a staged file against
// the exact snapshot serialization; older write failures keep their variant.

type NodeId { store_id: i32, slot: i32, generation: i32 }
type DocumentNode { id: NodeId, parent_slot: i32, kind: string, text: string, alive: bool }
type Revision { document_id: i32, revision_id: i32, nodes: List<DocumentNode> }
type ExportError { TempWriteFailed(string) | TempReadFailed(string) | ChecksumMismatch }

func serialize_revision(revision: Revision) -> string {
    let mut contents = "document=" + to_string(revision.document_id) + "\n"
    contents = contents + "revision=" + to_string(revision.revision_id) + "\n"
    for node in revision.nodes {
        if node.alive { contents = contents + to_string(node.id.slot) + ":" + node.kind + ":" + node.text + "\n" }
    }
    contents
}

func verify_staged(expected: string, actual: string) -> Result<string, ExportError> {
    if expected == actual { Ok(actual) } else { Err(ChecksumMismatch) }
}

func preserve_existing_write_error(path: string) -> bool {
    match write_file(path, "cannot create this child under /dev/null") {
        Err(message) => {
            let old_error: ExportError = TempWriteFailed(message)
            match old_error {
                TempWriteFailed(_) => true,
                TempReadFailed(_) => false,
                ChecksumMismatch => false,
            }
        },
        Ok(_) => false,
    }
}

func main() -> i32 {
    let doc_id = 7
    let body_id = NodeId { store_id: doc_id, slot: 1, generation: 1 }
    let revision = Revision {
        document_id: doc_id,
        revision_id: 1,
        nodes: [
            DocumentNode { id: NodeId { store_id: doc_id, slot: 0, generation: 1 }, parent_slot: -1, kind: "title", text: "Meeting notes", alive: true },
            DocumentNode { id: body_id, parent_slot: 0, kind: "paragraph", text: "A", alive: true },
        ],
    }
    let expected = serialize_revision(revision)
    let temporary_path = "/tmp/mimi-v02-w2-d3-corrupt.tmp"
    remove_file(temporary_path)
    let injected = write_file(temporary_path, expected + "corrupt tail")
    let injection_succeeded = match injected {
        Ok(_) => true,
        Err(_) => false,
    }
    let actual_result = read_file(temporary_path)
    let actual = match actual_result {
        Ok(contents) => contents,
        Err(_) => "read failed",
    }
    let checksum_error = verify_staged(expected, actual)
    let old_write_error_preserved = preserve_existing_write_error("/dev/null/mimi-v02-w2-d3.tmp")
    let mismatch_observed = match checksum_error {
        Err(ChecksumMismatch) => true,
        Err(TempWriteFailed(_)) => false,
        Err(TempReadFailed(_)) => false,
        Ok(_) => false,
    }
    remove_file(temporary_path)
    if injection_succeeded && mismatch_observed && old_write_error_preserved {
        println("ChecksumMismatch")
        0
    } else {
        1
    }
}
