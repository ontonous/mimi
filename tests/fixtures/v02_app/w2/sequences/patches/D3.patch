+
+func d3_verify_staged(expected: string, actual: string) -> Result<string, ExportError> {
+    if expected == actual { Ok(actual) } else { Err(ChecksumMismatch) }
+}
+
+func d3_preserves_write_error(path: string) -> bool {
+    match write_file(path, "cannot create a child beneath /dev/null") {
+        Err(message) => {
+            let old_error: ExportError = TempWriteFailed(message)
+            match old_error {
+                TempWriteFailed(_) => true,
+                TempReadFailed(_) => false,
+                DestinationWriteFailed(_) => false,
+                CleanupFailed(_) => false,
+                ChecksumMismatch => false,
+            }
+        },
+        Ok(_) => false,
+    }
+}
+
+func d3_error_variant_check() -> bool {
+    let expected = "document=7\nrevision=1\n1:paragraph:A\n"
+    let temporary_path = "/tmp/mimi-v02-w2-seq-d3-corrupt.tmp"
+    remove_file(temporary_path)
+    let injected = match write_file(temporary_path, expected + "corrupt tail") {
+        Ok(_) => true,
+        Err(_) => false,
+    }
+    let actual = match read_file(temporary_path) {
+        Ok(contents) => contents,
+        Err(_) => "read failed",
+    }
+    let mismatch = d3_verify_staged(expected, actual)
+    let mismatch_classified = match mismatch {
+        Err(ChecksumMismatch) => true,
+        Err(TempWriteFailed(_)) => false,
+        Err(TempReadFailed(_)) => false,
+        Err(DestinationWriteFailed(_)) => false,
+        Err(CleanupFailed(_)) => false,
+        Ok(_) => false,
+    }
+    // Exercise the old write error through the real filesystem boundary.
+    let old_write_error_preserved = d3_preserves_write_error("/dev/null/mimi-v02-w2-seq-d3.tmp")
+    remove_file(temporary_path)
+    injected && mismatch_classified && old_write_error_preserved
+}
