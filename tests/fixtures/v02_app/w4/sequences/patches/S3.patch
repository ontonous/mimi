+#define _POSIX_C_SOURCE 200809L
+#include <assert.h>
+#include <stdint.h>
+#include <stdio.h>
+#include <sys/socket.h>
+#include <sys/types.h>
+#include <unistd.h>
+
+extern int64_t w4_open_listener_s3(int32_t scope, int32_t port, int32_t backlog);
+extern int64_t w4_connect_loopback_s3(int32_t scope, int32_t port);
+extern int32_t w4_listener_port(int64_t fd);
+
+static int socket_calls;
+static int bind_calls;
+static int listen_calls;
+static int connect_calls;
+int __real_socket(int domain, int type, int protocol);
+int __real_bind(int fd, const struct sockaddr *address, socklen_t length);
+int __real_listen(int fd, int backlog);
+int __real_connect(int fd, const struct sockaddr *address, socklen_t length);
+int __wrap_socket(int domain, int type, int protocol) {
+    ++socket_calls;
+    return __real_socket(domain, type, protocol);
+}
+int __wrap_bind(int fd, const struct sockaddr *address, socklen_t length) {
+    ++bind_calls;
+    return __real_bind(fd, address, length);
+}
+int __wrap_listen(int fd, int backlog) {
+    ++listen_calls;
+    return __real_listen(fd, backlog);
+}
+int __wrap_connect(int fd, const struct sockaddr *address, socklen_t length) {
+    ++connect_calls;
+    return __real_connect(fd, address, length);
+}
+
+int main(void) {
+    assert(w4_open_listener_s3(0, 0, 8) == -1001);
+    assert(w4_open_listener_s3(1, 23999, 8) == -1002);
+    assert(w4_open_listener_s3(1, 24101, 8) == -1002);
+    assert(w4_connect_loopback_s3(0, 24000) == -1001);
+    assert(w4_connect_loopback_s3(1, 23999) == -1002);
+    assert(w4_connect_loopback_s3(1, 24101) == -1002);
+    assert(socket_calls == 0 && bind_calls == 0 && listen_calls == 0 && connect_calls == 0);
+
+    int64_t listener = w4_open_listener_s3(1, 0, 8);
+    assert(listener >= 0);
+    int32_t port = w4_listener_port(listener);
+    assert(port >= 24000 && port <= 24100);
+    int64_t client = w4_connect_loopback_s3(1, port);
+    assert(client >= 0);
+    assert(socket_calls > 0 && bind_calls > 0 && listen_calls > 0 && connect_calls == 1);
+    (void)close((int)client);
+    (void)close((int)listener);
+    puts("S3_SCOPE_ORACLE_OK");
+    return 0;
+}
