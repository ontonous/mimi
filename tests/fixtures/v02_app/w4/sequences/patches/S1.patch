-/* Frozen independent oracle: checksum(x) = x*x + 17 for 0 <= x <= 999. */
+/* S1 replacement: same scalar ABI and result, bounded sum-of-odds form. */
 int32_t w4_checksum(int32_t value) {
     if (value < 0 || value > 999) {
         return -2;
     }
-    return (int32_t)((int64_t)value * (int64_t)value + 17);
+    int64_t sum = 17;
+    for (int32_t odd = 1; odd < value * 2; odd += 2) {
+        sum += odd;
+    }
+    return (int32_t)sum;
 }
 
