-    let framed = line + "\n"
-    let mut offset = 0
-    while offset < framed.len() {
-        let sent = tcp_send(fd, substring(framed, offset, framed.len()))
-        if sent.is_err() {
-            return false
-        }
-        let amount = sent.unwrap()
-        if amount <= 0 {
-            return false
-        }
-        offset = offset + (amount as i32)
-    }
-    true
-}
