-        if status < 0 {
-            let _ = send_line(client, "{\"error\":\"BadFrame\"}")
-            close_fd(client)
-            note(EVENT_WORKER_DONE, slot)
-            return 1
-        }
-
-        let response = checksum_response(raw, slot)
-        if !send_line(client, response) {
-            close_fd(client)
-            note(EVENT_WORKER_DONE, slot)
