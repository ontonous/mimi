-    let second_fd = second.unwrap()
-    let second_gate = channel_new()
-    let second_task = spawn serve_connection(second_fd, 2, second_gate)
-    note(EVENT_HANDOFF, 2)
-    channel_send(second_gate, 2 as i64)
