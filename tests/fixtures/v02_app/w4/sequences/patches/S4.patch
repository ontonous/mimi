-pub func next_line(fd: i64, pending: string) -> (i32, string, string) {
-    let mut buffer = pending
-    while !contains(buffer, "\n") {
-        let received = tcp_recv(fd, MAX_REQUEST_BYTES)
-        if received.is_err() {
-            return (-1, "", buffer)
-        }
-        let chunk = received.unwrap()
-        if chunk == "" {
-            if buffer == "" {
-                return (0, "", "")
-            }
-            return (-2, "", buffer)
-        }
-        buffer = buffer + chunk
-        if buffer.len() > MAX_REQUEST_BYTES {
-            return (-2, "", buffer)
-        }
-    }
-
-    let parts = split(buffer, "\n")
-    if parts.len() == 0 {
-        return (-2, "", "")
-    }
-    let mut rest = ""
-    for index in range(1, parts.len()) {
-        if index > 1 {
-            rest = rest + "\n"
-        }
-        rest = rest + parts[index]
-    }
-    (1, parts[0], rest)
-}
