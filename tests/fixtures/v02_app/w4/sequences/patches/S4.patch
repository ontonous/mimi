+mimi build src/main.mimi --link-search /tmp --link-lib w4_trusted \
+  -o /tmp/w4_offline
+(cd /tmp && LD_LIBRARY_PATH=/tmp /tmp/w4_host_driver --native \
+  /tmp/w4_offline /tmp/libw4_exports.so /tmp/libw4_trusted.so)
