-        note(EVENT_BAD_JSON, slot)
-        return "{\"error\":\"BadJson\"}"
-    }
-    if !json_has_key(raw, "op") || !json_has_key(raw, "request_id") {
-        return "{\"error\":\"BadSchema\"}"
-    }
-
-    let operation = json_get_string(raw, "op")
-    let request_id = json_get_int(raw, "request_id")
-    if operation != "checksum" {
-        return "{\"id\":" + to_string(request_id) + ",\"error\":\"BadOperation\"}"
-    }
-    if !json_has_key(raw, "value") || !json_has_key(raw, "hold_ms") {
-        return "{\"id\":" + to_string(request_id) + ",\"error\":\"BadSchema\"}"
-    }
-
-    let value = json_get_int(raw, "value")
-    let hold_ms = json_get_int(raw, "hold_ms")
-    if hold_ms < 0 || hold_ms > MAX_HOLD_MS {
