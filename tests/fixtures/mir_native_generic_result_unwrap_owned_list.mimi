// Generic Result<T, i32>.unwrap specialized to a canonical move-owned List<i32>.
func unwrap<T>(value: Result<T, i32>) -> T {
    value.unwrap()
}

func main() -> i32 {
    ensures: result == result
    let values: List<i32> = [1, 2, 3]
    let value: Result<List<i32>, i32> = Ok(values)
    let out = unwrap(value)
    drop(out)
    41
}
