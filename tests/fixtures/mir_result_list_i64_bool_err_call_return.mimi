func make_i64_ok() -> Result<List<i64>, i32> {
    Ok([10, 20])
}

func make_i64_err() -> Result<List<i64>, i32> {
    Err(3)
}

func make_bool_ok() -> Result<List<bool>, i32> {
    Ok([true, false, true])
}

func make_bool_err() -> Result<List<bool>, i32> {
    Err(5)
}

func use_i64_ok() -> i32 {
    ensures: result == 20
    let value = make_i64_ok()
    match value {
        Ok(_) => 20,
        Err(code) => code
    }
}

func use_i64_err() -> i32 {
    ensures: result == 3
    let value = make_i64_err()
    match value {
        Ok(_) => 99,
        Err(code) => code
    }
}

func use_bool_ok() -> i32 {
    ensures: result == 28
    let value = make_bool_ok()
    match value {
        Ok(_) => 28,
        Err(code) => code
    }
}

func use_bool_err() -> i32 {
    ensures: result == 5
    let value = make_bool_err()
    match value {
        Ok(_) => 99,
        Err(code) => code
    }
}

func main() -> i32 {
    use_i64_ok() + use_i64_err() + use_bool_ok() + use_bool_err()
}
