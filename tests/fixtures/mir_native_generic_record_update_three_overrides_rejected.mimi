// S172 negative: three explicit overrides remain outside the bounded receipt.
type WidePatch<T> { value: T, tag: i32, enabled: bool, extra: i64 }

func retag<T>(patch: WidePatch<T>) -> WidePatch<T> {
    WidePatch { extra: 1, enabled: true, tag: 9, ..patch }
}

func main() -> i32 {
    ensures: result == result
    let patch = WidePatch { value: 41, tag: 7, enabled: false, extra: 0 }
    let updated = retag(patch)
    updated.value
}
