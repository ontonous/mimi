// M3: a failing transition returns its source in Err((source, error)); the
// caller consumes that source exactly once for a safe retry. The transition
// records the pre-failure payload before returning it; the caller records the
// successful retry payload after consuming the returned source.
flow Account {
    state Active { balance: i32 }

    transition withdraw(Active, amount: i32) -> Active fails string {
        let checked: Result<i32, string> = if amount == 0 {
            println(self.balance)
            Err("div0")
        } else {
            Ok(self.balance - amount)
        }
        let new_balance = checked?
        return Active { balance: new_balance }
    }
}

func retry_balance_contract(balance: i32, amount: i32) -> i32 {
    requires: balance == 100
    requires: amount == 5
    ensures: result == 95
    balance - amount
}

func main() -> i32 {
    let source = Active { balance: 100 }
    let rejected = Account::withdraw(source, 0)
    match rejected {
        Ok(_) => 1000,
        Err(error) => {
            let retried = Account::withdraw(error.0, 5)
            match retried {
                Ok(success) => {
                    println(success.balance)
                    drop(success)
                    0
                },
                Err(_) => 1001,
            }
        },
    }
}
