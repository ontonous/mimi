// S171 candidate: one flat Copy Record<T> update with a concrete scalar override.
// The generic parameter remains a Copy field and the update has no ownership transfer.
type Patch<T> { value: T, tag: i32 }

func retag<T>(patch: Patch<T>) -> Patch<T> {
    Patch { tag: 9, ..patch }
}

func main() -> i32 {
    ensures: result == result
    let patch = Patch { value: 41, tag: 7 }
    let updated = retag(patch)
    updated.value
}
