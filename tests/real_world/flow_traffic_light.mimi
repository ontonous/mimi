// real_world: Traffic Light Controller
// Features: 3-state cycle, payload tracking, overloaded transitions,
// timer subflow composition, peer_fault on undefined event.
//
// A traffic light cycles Red → Green → Yellow → Red.
// Each state carries a timer payload. A separate Timer flow
// counts down. peer_fault demonstrates Fault trace access.

flow Timer {
    state Stopped { remaining: i32 }
    state Running { remaining: i32 }

    transition start(Stopped) -> Running { return Running { remaining: self.remaining } }
    transition tick(Running) -> Running { return Running { remaining: self.remaining - 1 } }
    transition stop(Running) -> Stopped { return Stopped { remaining: self.remaining } }
}

flow TrafficLight {
    state Red { waited: i32 }
    state Green { elapsed: i32 }
    state Yellow { elapsed: i32 }

    transition to_green(Red) -> Green { return Green { elapsed: 0 } }
    transition to_yellow(Green) -> Yellow { return Yellow { elapsed: 0 } }
    transition to_red(Yellow) -> Red { return Red { waited: 0 } }
}

func main() -> i32 {
    // Full traffic light cycle: Red → Green → Yellow → Red
    let t0 = Red { waited: 30 }
    let t1 = TrafficLight::to_green(t0)
    println(t1.elapsed)
    let t2 = TrafficLight::to_yellow(t1)
    println(t2.elapsed)
    let t3 = TrafficLight::to_red(t2)
    println(t3.waited)

    // Timer subflow: start → tick → tick → stop
    let timer0 = Stopped { remaining: 10 }
    let timer1 = Timer::start(timer0)
    let timer2 = Timer::tick(timer1)
    let timer3 = Timer::tick(timer2)
    println(timer3.remaining)
    let timer4 = Timer::stop(timer3)
    println(timer4.remaining)

    // peer_fault: system verb → Fault with trace fields
    let t4 = Red { waited: 5 }
    let f = TrafficLight::peer_fault(t4)
    println(f.last_state)
    println(f.unexpected_event)

    0
}
