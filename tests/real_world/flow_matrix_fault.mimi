// real_world: Sparse Flow + Explicit Error Handling
// Features: @sparse annotation (no auto-completion), explicit
// transition coverage, peer_fault for undefined events.
//
// With @sparse, only declared transitions exist. Calling an
// undeclared (state, event) pair is a compile-time error, not
// a runtime fallback. peer_fault is still available as a system verb.

flow Counter {
    state Zero { count: i32 }
    state Positive { count: i32 }

    transition inc(Zero) -> Positive { return Positive { count: 1 } }
    transition inc(Positive) -> Positive { return Positive { count: self.count + 1 } }
    transition reset(Positive) -> Zero { return Zero { count: 0 } }
}

func main() -> i32 {
    // Zero → inc → inc → inc → reset
    let c0 = Zero { count: 0 }
    let c1 = Counter::inc(c0)
    println(c1.count)
    let c2 = Counter::inc(c1)
    println(c2.count)
    let c3 = Counter::inc(c2)
    println(c3.count)
    let c4 = Counter::reset(c3)
    println(c4.count)

    // peer_fault: system verb always available
    let c5 = Zero { count: 0 }
    let ft = Counter::peer_fault(c5)
    println(ft.last_state)
    println(ft.unexpected_event)

    0
}
