// MCDD real_world: Session Types — dual-endpoint runtime (v0.29.34)
// Declares a linear session protocol and exercises send/recv/close
// with actual channel communication (not just static order check).
// 0.36.38: session_pair::<S>() returns the typed pair
//   (SessionChan<S>, SessionChan<dual S>) — the lo end speaks S, the
//   hi end speaks the dual: send on lo → recv on hi; send on hi →
//   recv on lo. Both endpoints carry residuals, so the compile-time
//   protocol proof spans the whole channel pair (the old
//   `let pair = session_pair(); pair[i]` raw-i64 form is retired).

session ClientProto = !i32 . ?i32 . end
session ServerProto = dual(ClientProto)

func main() -> i32 {
    let (ch0, ch1) = session_pair::<ClientProto>()

    // Client sends 10 on ch0 → server receives on ch1
    session_send(ch0, 10)
    let n = session_recv(ch1)
    // Server sends n+1 on ch1 → client receives on ch0
    session_send(ch1, n + 1)
    let reply = session_recv(ch0)
    session_close(ch0)
    session_close(ch1)

    println(n)
    println(reply)
    0
}