// Verifier negative companion to flow_state_match_fail_result_failure_dual_backend.mimi.
// The MIR and recoverable source-return path are identical; only the postcondition
// is false for the concrete A { n: 1 } failure execution.
flow F {
    state A { n: i32 }
    state B { n: i32 }

    transition go(A) -> B fails string {
        let checked: Result<i32, string> = if self.n == 1 {
            Err("bad")
        } else {
            Ok(self.n + 1)
        }
        let next = checked?
        return B { n: next }
    }
}

func main() -> i32 {
    requires: true
    ensures: result == 1
    let result = F::go(A { n: 1 })
    match result {
        Ok(B { n }) => {
            println(n)
            99
        },
        Err((source, error)) => {
            println(source.n)
            drop(source)
            drop(error)
            0
        },
    }
}
