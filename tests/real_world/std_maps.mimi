// real_world: std::maps wrapper surface including Any-handle conversions.
//
// The std::maps wrappers are in-place at the Record/LLVM handle level, just
// like the builtin map_* functions: set/remove return the same underlying
// handle after mutation.

use std::maps;

func main() -> i32 {
    let m = new()
    let m2 = set(m, "a", 1)
    let m3 = set(m2, "b", 2)
    if size(m3) != 2 { return 1 }
    if !has_key(m3, "a") { return 2 }
    let (found_a, va) = get(m3, "a")
    if !found_a { return 3 }
    if va != 1 { return 4 }
    let v_default = get_or_default(m3, "c", 99)
    if v_default != 99 { return 5 }
    let pairs = to_list(m3)
    if len(pairs) != 2 { return 6 }
    let m4 = remove(m3, "a")
    if size(m4) != 1 { return 7 }
    0
}
