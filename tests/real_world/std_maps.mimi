// real_world: std::maps wrapper surface including Any-handle conversions.
//
// The std::maps set/remove wrappers preserve their input value by copying its
// entries before mutation, then return a new Record handle. Keep the snapshots
// below explicit so the VM path exercises that persistence contract. Native
// `get_or_default<T>` remains fail-closed until Map entries carry a checked
// dynamic type descriptor.

use std::maps;

func main() -> i32 {
    match new() {
        Ok(m) => {
            match set(m, "a", 1) {
                Ok(m2) => {
                    match set(m2, "b", 2) {
                        Ok(m3) => {
                            if size(m) != 0 {
                                drop(m)
                                drop(m2)
                                drop(m3)
                                return 8
                            }
                            if size(m2) != 1 {
                                drop(m)
                                drop(m2)
                                drop(m3)
                                return 9
                            }
                            if size(m3) != 2 {
                                drop(m)
                                drop(m2)
                                drop(m3)
                                return 1
                            }
                            if !has_key(m3, "a") {
                                drop(m)
                                drop(m2)
                                drop(m3)
                                return 2
                            }
                            let (found_a, va) = get(m3, "a")
                            if !found_a {
                                drop(va)
                                drop(m)
                                drop(m2)
                                drop(m3)
                                return 3
                            }
                            if va != 1 {
                                drop(va)
                                drop(m)
                                drop(m2)
                                drop(m3)
                                return 4
                            }
                            drop(va)
                            let v_default = get_or_default(m3, "c", 99)
                            if v_default != 99 {
                                drop(v_default)
                                drop(m)
                                drop(m2)
                                drop(m3)
                                return 5
                            }
                            drop(v_default)
                            let pairs = to_list(m3)
                            if len(pairs) != 2 {
                                drop(pairs)
                                drop(m)
                                drop(m2)
                                drop(m3)
                                return 6
                            }
                            drop(pairs)
                            match remove(m3, "a") {
                                Ok(m4) => {
                                    if size(m4) != 1 {
                                        drop(m)
                                        drop(m2)
                                        drop(m3)
                                        drop(m4)
                                        return 7
                                    }
                                    if size(m3) != 2 {
                                        drop(m)
                                        drop(m2)
                                        drop(m3)
                                        drop(m4)
                                        return 10
                                    }
                                    if !has_key(m3, "a") {
                                        drop(m)
                                        drop(m2)
                                        drop(m3)
                                        drop(m4)
                                        return 11
                                    }
                                    drop(m4)
                                    drop(m3)
                                    drop(m2)
                                    drop(m)
                                    0
                                },
                                Err(status) => {
                                    drop(m)
                                    drop(m2)
                                    drop(m3)
                                    status
                                },
                            }
                        },
                        Err(status) => {
                            drop(m)
                            drop(m2)
                            status
                        },
                    }
                },
                Err(status) => {
                    drop(m)
                    status
                },
            }
        },
        Err(status) => { status },
    }
}
