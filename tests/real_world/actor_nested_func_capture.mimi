// Regression (L1, R6-1031): a nested `func` inside an explicit Actor mailbox
// method captures an enclosing local. CounterFlow state and its transition
// remain explicit metadata; this case exercises the scalar mailbox result.
flow CounterFlow {
    state Active { base: i32 }

    transition record(Active, value: i32) -> Active {
        return Active { base: value }
    }
}

actor Counter runs CounterFlow {
    func bump(delta: i32) -> i32 {
        let scale = 10
        func scaled(d: i32) -> i32 {
            scale + d
        }
        scaled(delta)
    }
}

func main() -> i32 {
    let c = Counter.spawn()
    let r = c.bump(5)
    println(r)
    0
}
