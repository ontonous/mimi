// real_world: Test engineering — assert_state! (interpreter-only)
// Tests: assert_state verifies flow state name in the interpreter.
// LLVM codegen rejects this file (assert_state cannot inspect state identity).
//
// Note: assert_state consumes the flow state (linear resource).
// Create separate state values for assertion vs. transition use.

flow Counter {
    state Zero { count: i32 }
    state Positive { count: i32 }

    transition inc(Zero) -> Positive {
        return Positive { count: self.count + 1 }
    }
    transition inc(Positive) -> Positive {
        return Positive { count: self.count + 1 }
    }
}

func main() -> i32 {
    // Verify initial state (consumes the value).
    let check0 = Zero { count: 0 }
    assert_state(check0, "Zero")

    // Separate value for transition use.
    let s0 = Zero { count: 0 }
    let s1 = Counter::inc(s0)
    assert_state(s1, "Positive")

    // Another chain for println output.
    let s2 = Zero { count: 0 }
    let s3 = Counter::inc(s2)
    println(s3.count)

    0
}
