// real_world: Order Processing System
// Features: business process state machine, fails E for payment
// failure via ? operator, Result matching on transition return,
// event parameters, multi-step workflow.
//
// Order lifecycle: Pending → Paid → Shipped → Delivered.
// The pay transition uses `fails string` + ? to model payment rejection.
// fails E returns Result<Target, (Source, E)> — the caller matches on
// the Result to handle success (continue pipeline) or failure (inspect
// source state + error message).
//
// ⚠ KNOWN LIMITATION (E0304): matching on Result<Target, (Source, E)>
// triggers "resource consumed on only some CFG paths" because the Ok arm
// consumes the state through transitions while the Err arm reads fields.
// This is a resource analysis gap — match arms are mutually exclusive,
// so consumption on one arm should not require consumption on the other.
// When fixed, this test should pass without modification.

func validate_price(price: i32) -> Result<i32, string> {
    if price <= 0 {
        return Err("invalid price")
    }
    Ok(price)
}

flow Order {
    state Pending { item: string, price: i32 }
    state Paid { item: string, price: i32, txn: string }
    state Shipped { item: string, tracking: string }
    state Delivered { item: string }

    transition pay(Pending, txn_id: string) -> Paid fails string {
        let valid_price = validate_price(self.price)?
        return Paid { item: self.item, price: valid_price, txn: txn_id }
    }
    transition ship(Paid) -> Shipped { return Shipped { item: self.item, tracking: "TRK-001" } }
    transition deliver(Shipped) -> Delivered { return Delivered { item: self.item } }
}

func main() -> i32 {
    // Happy path: Pending → Paid → Shipped → Delivered
    let o0 = Pending { item: "book", price: 25 }
    let pay_result = Order::pay(o0, "TXN-42")
    match pay_result {
        Ok(o1) => {
            println(o1.txn)
            let o2 = Order::ship(o1)
            println(o2.tracking)
            let o3 = Order::deliver(o2)
            println(o3.item)
        },
        Err((src, e)) => {
            // Rejected path: source state returned, error message available.
            // The caller can inspect src to decide retry logic.
            println(e)
            println(src.item)
        },
    }

    // Failure path: price <= 0 triggers ? → Rejected
    let bad = Pending { item: "free", price: 0 }
    let bad_result = Order::pay(bad, "TXN-99")
    match bad_result {
        Ok(o) => println(o.price),
        Err((src, e)) => {
            println(e)
            println(src.price)
        },
    }

    0
}
