// real_world: SystemTrace on Fault
// Features: peer_fault trace fields (last_state, unexpected_event),
// multiple flows with independent fault traces, payload preservation.
//
// Demonstrates that peer_fault produces a Fault record with readable
// trace fields, useful for debugging and monitoring.

flow Worker {
    state Idle { id: string }
    state Busy { id: string, task: string }

    transition assign(Idle, task_name: string) -> Busy { return Busy { id: self.id, task: task_name } }
    transition complete(Busy) -> Idle { return Idle { id: self.id } }
}

flow Scheduler {
    state Waiting { queue: i32 }
    state Dispatching { queue: i32 }

    transition dispatch(Waiting) -> Dispatching { return Dispatching { queue: self.queue } }
    transition done(Dispatching) -> Waiting { return Waiting { queue: self.queue } }
}

func main() -> i32 {
    // Worker: Idle → Assign → Complete
    let w0 = Idle { id: "w1" }
    let w1 = Worker::assign(w0, "build")
    println(w1.task)
    let w2 = Worker::complete(w1)
    println(w2.id)

    // Scheduler: Waiting → Dispatch → Done
    let sc0 = Waiting { queue: 3 }
    let sc1 = Scheduler::dispatch(sc0)
    println(sc1.queue)
    let sc2 = Scheduler::done(sc1)

    // peer_fault on Worker: trace shows last state and event
    let w3 = Idle { id: "w2" }
    let wf = Worker::peer_fault(w3)
    println(wf.last_state)
    println(wf.unexpected_event)

    // peer_fault on Scheduler: independent trace
    let sc3 = Waiting { queue: 0 }
    let sf = Scheduler::peer_fault(sc3)
    println(sf.last_state)
    println(sf.unexpected_event)

    0
}
