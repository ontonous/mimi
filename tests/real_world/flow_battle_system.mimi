// real_world: Battle System
// Features: game state machine, event parameters (damage),
// conditional transitions, peer_fault, payload tracking.
//
// A battle unit transitions: Fresh → Buffed → Wounded → Defeated.
// Demonstrates parameterized transitions and conditional logic.

flow BattleUnit {
    state Fresh { hp: i32, attack: i32 }
    state Buffed { hp: i32, attack: i32 }
    state Wounded { hp: i32, attack: i32 }
    state Defeated

    transition buff(Fresh) -> Buffed { return Buffed { hp: self.hp, attack: self.attack + 5 } }
    transition hit(Buffed, damage: i32) -> Wounded { return Wounded { hp: self.hp - damage, attack: self.attack } }
    transition hit_fresh(Fresh, damage: i32) -> Wounded { return Wounded { hp: self.hp - damage, attack: self.attack } }
    transition defeat(Wounded) -> Defeated { return Defeated { } }
    transition heal(Wounded) -> Fresh { return Fresh { hp: self.hp + 10, attack: self.attack } }
}

func main() -> i32 {
    // Fresh → Buff → Hit → Heal → Hit → Defeat
    let u0 = Fresh { hp: 100, attack: 10 }
    println(u0.attack)
    let u1 = BattleUnit::buff(u0)
    println(u1.attack)
    let u2 = BattleUnit::hit(u1, 30)
    println(u2.hp)
    let u3 = BattleUnit::heal(u2)
    println(u3.hp)
    let u4 = BattleUnit::hit_fresh(u3, 200)
    println(u4.hp)
    let u5 = BattleUnit::defeat(u4)

    // peer_fault
    let v0 = Fresh { hp: 50, attack: 8 }
    let ft = BattleUnit::peer_fault(v0)
    println(ft.last_state)
    println(ft.unexpected_event)

    0
}
