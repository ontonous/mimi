// real_world: File Handle Lifecycle
// Features: resource lifecycle state machine, payload persistence
// across transitions, peer_fault on invalid operation, multi-step.
//
// Models a file handle: Open → Reading/Writing → Closed.
// Demonstrates that closed handles cannot be used (typestate safety).

flow FileHandle {
    state Open { name: string, pos: i32 }
    state Reading { name: string, pos: i32, buf: string }
    state Closed { name: string }

    transition read(Open) -> Reading {
        do { return Reading { name: self.name, pos: self.pos, buf: "data" } }
    }
    transition finish_read(Reading) -> Open {
        do { return Open { name: self.name, pos: self.pos + 4 } }
    }
    transition close(Open) -> Closed {
        do { return Closed { name: self.name } }
    }
    transition close_reading(Reading) -> Closed {
        do { return Closed { name: self.name } }
    }
}

func main() -> i32 {
    // Open → Read → Finish → Read → Finish → Close
    let f0 = Open { name: "test.txt", pos: 0 }
    println(f0.name)
    let f1 = FileHandle::read(f0)
    println(f1.buf)
    let f2 = FileHandle::finish_read(f1)
    println(f2.pos)
    let f3 = FileHandle::read(f2)
    let f4 = FileHandle::finish_read(f3)
    println(f4.pos)
    let f5 = FileHandle::close(f4)
    println(f5.name)

    // peer_fault: system verb → Fault with trace
    let g0 = Open { name: "log.txt", pos: 0 }
    let ft = FileHandle::peer_fault(g0)
    println(ft.last_state)
    println(ft.unexpected_event)

    0
}
