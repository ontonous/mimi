func contains_inserted_key() -> Result<bool, i32> {
    ensures: result.is_err() || result.unwrap_or(false) == true
    match map_new() {
        Ok(root) => match map_set(root, "answer", 42) {
            Ok(inserted) => {
                drop(root)
                let present = has_key(inserted, "answer")
                drop(inserted)
                Ok(present)
            },
            Err(status) => {
                drop(root)
                Err(status)
            },
        },
        Err(status) => Err(status),
    }
}

func contains_missing_key() -> Result<bool, i32> {
    ensures: result.is_err() || result.unwrap_or(false) == false
    match map_new() {
        Ok(root) => {
            let missing = has_key(root, "missing")
            drop(root)
            Ok(missing)
        },
        Err(status) => Err(status),
    }
}

func contains_string_payload() -> Result<bool, i32> {
    ensures: result.is_err() || result.unwrap_or(false) == true
    match map_new() {
        Ok(root) => match map_set(root, "string", "payload") {
            Ok(inserted) => {
                drop(root)
                let present = has_key(inserted, "string")
                drop(inserted)
                Ok(present)
            },
            Err(status) => {
                drop(root)
                Err(status)
            },
        },
        Err(status) => Err(status),
    }
}

func wrong_contains_contract() -> Result<bool, i32> {
    ensures: result.is_err() || result.unwrap_or(false) == true
    match map_new() {
        Ok(root) => {
            let missing = has_key(root, "never-inserted")
            drop(root)
            Ok(missing)
        },
        Err(status) => Err(status),
    }
}

func main() -> i32 {
    match map_new() {
        Ok(first) => match map_set(first, "answer", 42) {
            Ok(inserted) => {
                drop(first)
                match map_set(inserted, "雪", 7) {
                    Ok(with_unicode) => {
                        drop(inserted)
                        let present = has_key(with_unicode, "answer")
                        let missing = has_key(with_unicode, "missing")
                        let unicode_present = has_key(with_unicode, "雪")
                        let removed = map_remove(with_unicode, "answer")
                        drop(with_unicode)
                        let after_remove = has_key(removed, "answer")
                        let retained_unicode = has_key(removed, "雪")
                        let size = map_size(removed)
                        println(present)
                        println(missing)
                        println(unicode_present)
                        println(after_remove)
                        println(retained_unicode)
                        println(size)
                        drop(removed)
                        match map_new() {
                            Ok(string_root) => match map_set(string_root, "string", "payload") {
                                Ok(string_value) => {
                                    drop(string_root)
                                    let string_present = has_key(string_value, "string")
                                    println(string_present)
                                    drop(string_value)
                                    0
                                },
                                Err(status) => {
                                    drop(string_root)
                                    status
                                },
                            },
                            Err(status) => status,
                        }
                    },
                    Err(status) => {
                        drop(inserted)
                        status
                    },
                }
            },
            Err(status) => {
                drop(first)
                status
            },
        },
        Err(status) => status,
    }
}
