// v0.29.48: Integration Test Sandbox
// White-paper section 8: "测试框架支持批量激活多个 Flow 实例"
flow CounterState {
    state Active { n: i32 }

    transition bump(Active) -> Active {
        return Active { n: self.n + 1 }
    }
}

actor Counter runs CounterState {}

func main() -> i32 {
    let c = Counter.spawn()
    let state = c.bump()
    println(state.n)
    0
}
