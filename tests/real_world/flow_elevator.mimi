// real_world: Elevator Controller
// Features: multi-state machine, event parameters, conditional logic
// in transitions, door subflow, peer_fault on invalid operation.
//
// An elevator moves between floors. It has an Idle state (at a floor),
// a Moving state (in transit), and a DoorOpen state. The door subflow
// tracks open/closed. peer_fault demonstrates Fault trace.

flow Door {
    state Closed
    state Open

    transition open(Closed) -> Open { return Open { } }
    transition close(Open) -> Closed { return Closed { } }
}

flow Elevator {
    state Idle { floor: i32 }
    state Moving { from_floor: i32, to_floor: i32 }
    state DoorOpen { floor: i32 }

    transition request(Idle, target: i32) -> Moving { return Moving { from_floor: self.floor, to_floor: target } }
    transition arrive(Moving) -> Idle { return Idle { floor: self.to_floor } }
    transition open_door(Idle) -> DoorOpen { return DoorOpen { floor: self.floor } }
    transition close_door(DoorOpen) -> Idle { return Idle { floor: self.floor } }
}

func main() -> i32 {
    // Elevator: floor 1 → request floor 5 → arrive → open door → close door
    let e0 = Idle { floor: 1 }
    println(e0.floor)
    let e1 = Elevator::request(e0, 5)
    println(e1.to_floor)
    let e2 = Elevator::arrive(e1)
    println(e2.floor)
    let e3 = Elevator::open_door(e2)
    println(e3.floor)
    let e4 = Elevator::close_door(e3)
    println(e4.floor)

    // Door subflow
    let d0 = Closed { }
    let d1 = Door::open(d0)
    let d2 = Door::close(d1)

    // peer_fault: system verb → Fault with trace
    let e5 = Idle { floor: 3 }
    let f = Elevator::peer_fault(e5)
    println(f.last_state)
    println(f.unexpected_event)

    0
}
