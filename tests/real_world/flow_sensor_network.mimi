// real_world: Sensor Network
// Features: multi-flow composition, two interacting state machines,
// event parameters, peer_fault on each flow independently.
//
// A temperature sensor and a humidity sensor operate independently.
// Each has Idle → Active → Reading states. Demonstrates composing
// multiple flows in a single program.

flow TempSensor {
    state TempIdle
    state TempActive { interval: i32 }
    state TempReading { value: i32, interval: i32 }

    transition start(TempIdle) -> TempActive { return TempActive { interval: 5 } }
    transition read(TempActive) -> TempReading { return TempReading { value: 22, interval: self.interval } }
    transition finish(TempReading) -> TempActive { return TempActive { interval: self.interval } }
    transition stop(TempActive) -> TempIdle { return TempIdle { } }
}

flow HumiditySensor {
    state HumIdle
    state HumActive { interval: i32 }

    transition start(HumIdle) -> HumActive { return HumActive { interval: 10 } }
    transition stop(HumActive) -> HumIdle { return HumIdle { } }
}

func main() -> i32 {
    // Temperature sensor: Idle → Active → Reading → Active → Stop
    let t0 = TempIdle { }
    let t1 = TempSensor::start(t0)
    println(t1.interval)
    let t2 = TempSensor::read(t1)
    println(t2.value)
    let t3 = TempSensor::finish(t2)
    let t4 = TempSensor::stop(t3)

    // Humidity sensor: Idle → Active → Stop
    let h0 = HumIdle { }
    let h1 = HumiditySensor::start(h0)
    println(h1.interval)
    let h2 = HumiditySensor::stop(h1)

    // peer_fault on each flow
    let ta = TempSensor::peer_fault(TempIdle { })
    println(ta.last_state)
    let ha = HumiditySensor::peer_fault(HumIdle { })
    println(ha.last_state)

    0
}
