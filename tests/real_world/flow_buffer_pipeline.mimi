// real_world: Buffer Pipeline
// Features: data pipeline state machine, payload accumulation,
// overloaded transitions, peer_fault, drain/reset pattern.
//
// A buffer accumulates items: Empty → Partial → Full.
// Drain empties it back. Demonstrates accumulation and reset.

flow Buffer {
    state Empty
    state Partial { items: i32, capacity: i32 }
    state Full { items: i32 }

    transition push(Empty) -> Partial { return Partial { items: 1, capacity: 4 } }
    transition push(Partial) -> Partial {
        if self.items + 1 >= self.capacity {
            return Partial { items: self.capacity, capacity: self.capacity }
        }
        return Partial { items: self.items + 1, capacity: self.capacity }
    }
    transition fill(Partial) -> Full { return Full { items: self.items } }
    transition drain(Full) -> Empty { return Empty { } }
    transition drain_partial(Partial) -> Empty { return Empty { } }
}

func main() -> i32 {
    // Empty → Push → Push → Push → Fill → Drain
    let b0 = Empty { }
    let b1 = Buffer::push(b0)
    println(b1.items)
    let b2 = Buffer::push(b1)
    println(b2.items)
    let b3 = Buffer::push(b2)
    println(b3.items)
    let b4 = Buffer::fill(b3)
    println(b4.items)
    let b5 = Buffer::drain(b4)

    // Partial drain
    let c0 = Empty { }
    let c1 = Buffer::push(c0)
    let c2 = Buffer::push(c1)
    let c3 = Buffer::drain_partial(c2)

    // peer_fault
    let d0 = Empty { }
    let ft = Buffer::peer_fault(d0)
    println(ft.last_state)
    println(ft.unexpected_event)

    0
}
