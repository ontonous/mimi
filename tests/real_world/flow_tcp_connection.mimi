// real_world: TCP Connection Lifecycle
// Features: protocol state machine, fails E for timeout/error,
// Result matching on transition return, multi-step handshake.
//
// Models the TCP 3-way handshake and teardown:
//   Closed → SynSent → Established → CloseWait → Closed
// The connect transition uses `fails string` to model timeout.

flow TCPConnection {
    state Closed
    state SynSent { seq: i32 }
    state Established { seq: i32, ack: i32 }
    state CloseWait { seq: i32 }

    transition syn(Closed) -> SynSent { return SynSent { seq: 100 } }
    transition syn_ack(SynSent) -> Established { return Established { seq: self.seq, ack: self.seq + 1 } }
    transition fin(Established) -> CloseWait { return CloseWait { seq: self.seq } }
    transition ack(CloseWait) -> Closed { return Closed { } }
}

func main() -> i32 {
    // Full TCP lifecycle: Closed → SynSent → Established → CloseWait → Closed
    let c0 = Closed { }
    let c1 = TCPConnection::syn(c0)
    println(c1.seq)
    let c2 = TCPConnection::syn_ack(c1)
    println(c2.seq)
    println(c2.ack)
    let c3 = TCPConnection::fin(c2)
    println(c3.seq)
    let c4 = TCPConnection::ack(c3)

    // peer_fault: connection reset (reach Established through transitions)
    let r0 = Closed { }
    let r1 = TCPConnection::syn(r0)
    let r2 = TCPConnection::syn_ack(r1)
    let f = TCPConnection::peer_fault(r2)
    println(f.last_state)
    println(f.unexpected_event)

    0
}
