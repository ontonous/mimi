// Regression (L1, R6-1031): a nested `func` in an explicit Actor mailbox
// method shadows a global for that body without leaking. ShadowerFlow state
// and its transition remain explicit metadata; this case exercises the scalar
// mailbox result.
func helper(x: i32) -> i32 {
    x + 100
}

flow ShadowerFlow {
    state Active { v: i32 }

    transition record(Active, value: i32) -> Active {
        return Active { v: value }
    }
}

actor Shadower runs ShadowerFlow {
    func touch(y: i32) -> i32 {
        func helper(x: i32) -> i32 {
            x * 2
        }
        helper(y)
    }
}

func main() -> i32 {
    let s = Shadower.spawn()
    let r = s.touch(21)
    println(r)
    println(helper(1))
    0
}
