// real_world: Fault Absorption + Recovery
// Features: peer_fault → Fault state, Fault payload field access,
// explicit recover transition, persistent data across recovery.
//
// Demonstrates that Fault is a real state with readable payload,
// and that recovery transitions can restore normal operation.

flow Service {
    state Active { requests: i32 }
    state Degraded { requests: i32, errors: i32 }

    transition serve(Active) -> Active { return Active { requests: self.requests + 1 } }
    transition degrade(Active) -> Degraded { return Degraded { requests: self.requests, errors: 1 } }
    transition recover(Degraded) -> Active { return Active { requests: self.requests } }
}

func main() -> i32 {
    // Normal operation
    let s0 = Active { requests: 0 }
    let s1 = Service::serve(s0)
    let s2 = Service::serve(s1)
    println(s2.requests)

    // Degrade → Recover
    let s3 = Service::degrade(s2)
    println(s3.errors)
    let s4 = Service::recover(s3)
    println(s4.requests)

    // peer_fault: system-level Fault with trace
    let s5 = Active { requests: 10 }
    let ft = Service::peer_fault(s5)
    println(ft.last_state)
    println(ft.unexpected_event)

    0
}
