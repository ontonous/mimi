// MCDD real_world: Actor lifecycle — SystemKill + spawn detached (v0.29.37)
// Tests: parent-child tracking, SystemKill cascade, detached survival.

flow WorkerState {
    state Active { v: i32 }

    transition read(Active) -> Active {
        return Active { v: self.v }
    }

    transition set(Active, n: i32) -> Active {
        return Active { v: n }
    }
}

actor Worker runs WorkerState {}

func main() -> i32 {
    // Spawn a regular actor
    let a = Worker.spawn()
    a.set(10)
    let a_state = a.read()
    println(a_state.v)

    // Spawn a detached actor (survives parent kill)
    let d = Worker.spawn_detached()
    d.set(99)
    let d_state = d.read()
    println(d_state.v)

    0
}
