// Regression (L1, 0.39.136): the maps read-modify-write counter pattern was
// unwritable while `get_or_default` returned untyped Any. Making it generic
// over the default lets the counter typecheck. Native execution stays
// fail-closed: static T does not prove the stored Any entry has that type.

use std::maps

func main() -> i64 {
    match new() {
        Ok(m) => {
            // the previously-unwritable read-modify-write counter pattern
            let c0 = get_or_default(m, "hits", 0)
            match set(m, "hits", c0 + 1) {
                Ok(m2) => {
                    match set(m2, "hits", get_or_default(m2, "hits", 0) + 1) {
                        Ok(m3) => {
                            match set(m3, "hits", get_or_default(m3, "hits", 0) + 1) {
                                Ok(m4) => {
                                    let hits = get_or_default(m4, "hits", 0)
                                    println(hits)
                                    let result = if hits == 3 { 0 as i64 } else { 1 as i64 }
                                    drop(m4)
                                    drop(m3)
                                    drop(m2)
                                    drop(m)
                                    result
                                },
                                Err(status) => {
                                    drop(m3)
                                    drop(m2)
                                    drop(m)
                                    status as i64
                                },
                            }
                        },
                        Err(status) => {
                            drop(m2)
                            drop(m)
                            status as i64
                        },
                    }
                },
                Err(status) => {
                    drop(m)
                    status as i64
                },
            }
        },
        Err(status) => { status as i64 },
    }
}
