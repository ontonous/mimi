// real_world: std::fs wrapper surface + native file system operations.

use std::fs;

func main() -> i32 {
    let path = "/tmp/mimi_rw_test_fs.txt"
    let _ = write(path, "hello world")
    match read(path) {
        Ok(content) => {
            if content != "hello world" { return 2 }
            if !exists(path) { return 3 }
            let st = stat(path)
            if st.size < 1 { return 4 }
            0
        }
        Err(_) => 1
    }
}
