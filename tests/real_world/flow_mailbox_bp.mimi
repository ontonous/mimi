// MCDD real_world: Mailbox backpressure governance (v0.29.21)
// @mailbox(depth=N) annotation parse + actor depth/mute query dual-backend.

flow Engine {
    state Idle
    state Running { ticks: i32 }
    transition start(Idle) -> Running { return Running { ticks: 0 } }
    transition tick(Running) -> Running { return Running { ticks: self.ticks + 1 } }
}

flow CounterState @mailbox(depth = 128) {
    state Active { n: i32 }
    transition bump(Active) -> Active {
        return Active { n: self.n + 1 }
    }
}
actor Counter runs CounterState {}

func main() -> i32 {
    let s0 = Idle { }
    let s1 = Engine::start(s0)
    let s2 = Engine::tick(s1)
    println(s2.ticks)

    let c = Counter.spawn()
    actor_set_mailbox_depth(c, 16)
    println(actor_mailbox_depth(c))
    println(actor_is_muted(c))
    let v = c.bump()
    println(v.n)
    0
}
