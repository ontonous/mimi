// real_world: Reset and Recovery
// Features: explicit reset/recover transitions, persistent state
// across fault, multi-step recovery workflow.
//
// A service goes Active → Degraded → Recovering → Active.
// Demonstrates that recovery preserves accumulated state.

flow Service {
    state Config { name: string }
    state Active { name: string, uptime: i32 }
    state Recovering { name: string, uptime: i32 }

    transition launch(Config) -> Active { return Active { name: self.name, uptime: 0 } }
    transition tick(Active) -> Active { return Active { name: self.name, uptime: self.uptime + 1 } }
    transition crash(Active) -> Recovering { return Recovering { name: self.name, uptime: self.uptime } }
    transition restart(Recovering) -> Active { return Active { name: self.name, uptime: 0 } }
}

func main() -> i32 {
    // Config → Launch → Tick → Tick → Crash → Restart → Tick
    let s0 = Config { name: "web" }
    let s1 = Service::launch(s0)
    println(s1.name)
    let s2 = Service::tick(s1)
    let s3 = Service::tick(s2)
    println(s3.uptime)
    let s4 = Service::crash(s3)
    println(s4.uptime)
    let s5 = Service::restart(s4)
    println(s5.uptime)
    let s6 = Service::tick(s5)
    println(s6.uptime)

    // peer_fault
    let s7 = Config { name: "db" }
    let ft = Service::peer_fault(s7)
    println(ft.last_state)
    println(ft.unexpected_event)

    0
}
