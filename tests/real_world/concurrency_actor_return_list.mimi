// Regression (L1): an un-annotated bind of an ordinary Actor method result
// must carry the declared return type into codegen's variable-type registry.
// This keeps the List<string> method-result fallback target on a plain Actor.
// Actor field writes are rejected with E0448, so the fixture starts with the
// same list value that the old load("tag") call installed and tests only the
// method-result ABI; it does not claim to cover mutable Actor-field ownership.
actor Holder {
    items: List<string> = ["tag"];

    func get_items() -> List<string> { self.items }
}

func main() -> i32 {
    let h = Holder.spawn()
    let ss = h.get_items()
    if ss[0] == "tag" {
        println(ss[0])
        0
    } else {
        1
    }
}
