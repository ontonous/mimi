// ---------------------------------------------------------------------------
// 0.31.24: Stdlib effect annotations
// ---------------------------------------------------------------------------
// This module documents the effects of stdlib functions.
// Effects are used by the type checker to enforce purity constraints.
//
// Effect types:
// - @pure: No side effects, deterministic output for same input
// - @io: Performs I/O operations (stdin/stdout/stderr)
// - @fs: Performs file system operations
// - @net: Performs network operations
// - @blocking: May block the current thread
// - @random: Produces non-deterministic output
//
// Usage:
// Functions marked with @pure can be called from comptime contexts.
// Functions marked with @io/@fs/@net/@blocking cannot be called from comptime.

// ---------------------------------------------------------------------------
// io.mimi effects
// ---------------------------------------------------------------------------
// print_line: @io
// print_raw: @io
// print_format: @io
// print_err: @io
// print_lines: @io
// print_bool: @io
// input_line: @io @blocking
// input_int: @io @blocking
// input_float: @io @blocking
// input_bool: @io @blocking

// ---------------------------------------------------------------------------
// fs.mimi effects
// ---------------------------------------------------------------------------
// exists: @fs
// read: @fs @blocking
// write: @fs @blocking
// read_lines: @fs @blocking
// write_lines: @fs @blocking
// file_size: @fs
// listdir: @fs
// is_dir: @fs
// mkdir_p: @fs
// remove_file: @fs
// walk_dir: @fs @blocking

// ---------------------------------------------------------------------------
// net.mimi effects
// ---------------------------------------------------------------------------
// tcp_socket: @net
// tcp_connect: @net @blocking
// tcp_listen: @net @blocking
// tcp_accept: @net @blocking
// tcp_send: @net @blocking
// tcp_recv: @net @blocking
// fetch: @net @blocking
// fetch_post: @net @blocking

// ---------------------------------------------------------------------------
// random.mimi effects
// ---------------------------------------------------------------------------
// random_int: @random
// random_float: @random
// random_choice: @random
// shuffle: @random

