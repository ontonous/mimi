// SetExt: Trait for Set operations.
trait SetExt {
    func size() -> i32
    func is_empty() -> bool
    func contains(value: Any) -> bool
    func insert(value: Any) -> Set
    func remove(value: Any) -> Set
    func to_list() -> List
}

// SetExt implementation for built-in Set type.
impl SetExt for Set {
    func size() -> i32 { self.size() }
    func is_empty() -> bool { self.is_empty() }
    func contains(value: Any) -> bool { self.contains(value) }
    func insert(value: Any) -> Set { self.insert(value) }
    func remove(value: Any) -> Set { self.remove(value) }
    func to_list() -> List { self.to_list() }
}

// insert: Returns a set with value added.
pub func insert(s: Set, value: Any) -> Set { s.insert(value) }

// set_size: Number of elements in the set.
pub func set_size(s: Set) -> i32 { s.size() }
// set_is_empty: True when the set has no elements.
pub func set_is_empty(s: Set) -> bool { s.is_empty() }
// set_contains: True when value is a member of the set.
pub func set_contains(s: Set, value: Any) -> bool { s.contains(value) }
// set_insert: Returns a set with value added.
pub func set_insert(s: Set, value: Any) -> Set { s.insert(value) }
// set_remove: Returns a set with value removed.
pub func set_remove(s: Set, value: Any) -> Set { s.remove(value) }
// set_to_list: Converts the set to a list of elements.
pub func set_to_list(s: Set) -> List { s.to_list() }
