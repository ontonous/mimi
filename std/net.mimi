// net.mimi — Networking utilities
//
// Built-in functions (no import needed):
//   socket(domain, type, protocol) -> i32
//   bind(fd, port) -> i32
//   listen(fd, backlog) -> i32
//   accept(fd) -> i32
//   connect(fd, host, port) -> i32
//   send(fd, data) -> i32
//   recv(fd, buf_size) -> string
//   close_fd(fd) -> i32
//   http_get(url) -> string
//   http_post(url, body) -> string
//
// Stdlib wrappers (defined below):
//   tcp_socket(), tcp_connect(), tcp_listen(), tcp_accept()
//   tcp_send(), tcp_recv(), fetch(), fetch_post()
//
// Example — HTTP client:
//   let response = fetch("https://example.com")
//   if response.is_ok() { println(response.unwrap()) }
//
// Example — TCP server:
//   let fd = tcp_listen(8080, 5)
//   if fd.is_ok() {
//       let client = tcp_accept(fd.unwrap())
//       if client.is_ok() {
//           let data = tcp_recv(client.unwrap(), 4096)
//           tcp_send(client.unwrap(), "HTTP/1.1 200 OK\r\n\r\nHello!")
//           close_fd(client.unwrap())
//       }
//   }

// Networking utilities — wraps socket builtins

// Structured network error type.
// `pub` is load-bearing: the std module loader carries only pub items
// across `use std::net`, and every pub function below returns
// Result<_, NetError> — a private declaration leaves consumers with
// unknown-type errors (same mechanism as the strings.mimi is_ws_char
// regression, wave1-review §1.6).
pub type NetError {
    SocketCreate
    ConnectFailed
    BindFailed
    ListenFailed
    AcceptFailed
    SendFailed
    RecvFailed
    HttpGetFailed
    HttpPostFailed
}

// NOTE (audit P1-41): the low-level network builtins still fail hard on
// OS/connection errors (bytecode VM raises a fatal error; codegen traps).
// Therefore the `NetError` variants below are currently unreachable from the
// wrappers that call `recv`/`http_get`/`http_post` directly. They are kept
// for API stability and future non-fatal `try_*` builtins; do not rely on
// matching `Err(RecvFailed)`/`Err(HttpGetFailed)` today.

// NetOps: Trait for network operations on file descriptors and URLs.
trait NetOps {
    func send(data: string) -> Result<i32, NetError>
    func recv(buf_size: i32) -> Result<string, NetError>
    func fetch() -> Result<string, NetError>
    func fetch_post(body: string) -> Result<string, NetError>
}

// NetOps implementation for built-in i64 (file descriptor) type.
impl NetOps for i64 {
    func send(data: string) -> Result<i32, NetError> {
        let n = send(self, data)
        // v0.34.6: narrowing i64→i32 requires explicit `as`.
        if n < 0 { Err(SendFailed) } else { Ok(n as i32) }
    }
    func recv(buf_size: i32) -> Result<string, NetError> {
        // See the NetError note: hard failures are fatal in the current
        // builtins, so only EOF/empty reads reach this Ok path.
        // The recv builtin returns "" on EOF (peer closed); hard failures
        // abort before returning, so an empty result is a successful read.
        let data = recv(self, buf_size)
        Ok(data)
    }
    func fetch() -> Result<string, NetError> { Err(HttpGetFailed) }
    func fetch_post(body: string) -> Result<string, NetError> { Err(HttpPostFailed) }
}

// NetOps implementation for built-in string (URL) type.
impl NetOps for string {
    func send(data: string) -> Result<i32, NetError> { Err(SendFailed) }
    func recv(buf_size: i32) -> Result<string, NetError> { Err(RecvFailed) }
    func fetch() -> Result<string, NetError> {
        // See the NetError note: http failures are fatal; any returned body
        // — including an empty one — is a successful response.
        let body = http_get(self)
        Ok(body)
    }
    func fetch_post(body: string) -> Result<string, NetError> {
        // See the NetError note: http failures are fatal; an empty response
        // body is still a successful response.
        let resp = http_post(self, body)
        Ok(resp)
    }
}

// Compatibility functions — keep original signatures.

// tcp_socket: Creates a TCP socket. Returns fd or negative on error.
pub func tcp_socket() -> i64 {
    socket(AF_INET, SOCK_STREAM, 0)
}

// tcp_connect: Connects to host:port over TCP. Returns fd on success.
pub func tcp_connect(host: string, port: i32) -> Result<i64, NetError> {
    let fd = tcp_socket()
    if fd < 0 { return Err(SocketCreate) }
    let ret = connect(fd, host, port)
    if ret < 0 {
        close_fd(fd)
        return Err(ConnectFailed)
    }
    Ok(fd)
}

// tcp_listen: Listens on port with backlog. Returns fd on success.
pub func tcp_listen(port: i32, backlog: i32) -> Result<i64, NetError> {
    let fd = tcp_socket()
    if fd < 0 { return Err(SocketCreate) }
    let ret = bind(fd, port)
    if ret < 0 {
        close_fd(fd)
        return Err(BindFailed)
    }
    let ret2 = listen(fd, backlog)
    if ret2 < 0 {
        close_fd(fd)
        return Err(ListenFailed)
    }
    Ok(fd)
}

// tcp_accept: Accepts a connection on a listening socket fd.
pub func tcp_accept(fd: i64) -> Result<i64, NetError> {
    let client_fd = accept(fd)
    if client_fd < 0 { Err(AcceptFailed) } else { Ok(client_fd) }
}

// tcp_send: Sends data over socket fd. Returns bytes sent on success.
pub func tcp_send(fd: i64, data: string) -> Result<i64, NetError> {
    let n = send(fd, data)
    if n < 0 { Err(SendFailed) } else { Ok(n) }
}

// tcp_recv: Receives up to buf_size bytes from socket fd (Ok("") means EOF).
pub func tcp_recv(fd: i64, buf_size: i32) -> Result<string, NetError> {
    // See the NetError note: hard recv failures are fatal in the current
    // builtins; "" is only a successful zero-byte read (peer closed).
    let data = recv(fd, buf_size)
    Ok(data)
}

// fetch: Performs HTTP GET, returns body string on success (possibly empty).
pub func fetch(url: string) -> Result<string, NetError> {
    // See the NetError note: http failures are fatal; any returned body —
    // including an empty one — is a successful response.
    let body = http_get(url)
    Ok(body)
}

// fetch_post: Performs HTTP POST with body, returns response on success (possibly empty).
pub func fetch_post(url: string, body: string) -> Result<string, NetError> {
    // See the NetError note: http failures are fatal; an empty response
    // body is still a successful response.
    let resp = http_post(url, body)
    Ok(resp)
}

// Socket address families
pub const AF_INET: i32 = 2
pub const AF_INET6: i32 = 10

// Socket types
pub const SOCK_STREAM: i32 = 1
pub const SOCK_DGRAM: i32 = 2

// Protocol constants
pub const IPPROTO_TCP: i32 = 6
pub const IPPROTO_UDP: i32 = 17
