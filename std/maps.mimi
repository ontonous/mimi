// NOTE (updated 0.39.136): raw builtins `map_set`/`map_remove` are VALUE-style
// on BOTH backends — they return a new Record and never mutate the input
// (verified by dual probes; the historical VM-copy-on-write vs native-in-place
// divergence no longer exists). The stdlib functions below (`set`, `remove`,
// `merge`, `update`, `omit`) rebind the returned map; fallible clone/set
// operations propagate their Result.
// Direct callers of the raw builtins must likewise rebind: discarding the
// result discards the insertion on both backends.
// Iteration contract (0.39.136): keys()/values() return key-SORTED order,
// deterministic across runs and identical on both backends.

// MapExt: Trait for Record (dictionary) operations.
pub type MapValuesSnapshot = List<Any>

trait MapExt {
    func get(key: string) -> (bool, Any)
    func set(key: string, value: Any) -> Result<Record, i32>
    func has_key(key: string) -> bool
    func remove(key: string) -> Result<Record, i32>
    func size() -> i32
    func is_empty() -> bool
    func get_or_default(key: string, default: Any) -> Any
    func merge(other: Record) -> Result<Record, i32>
    func to_list() -> List<(string, Any)>
    func filter_keys(pred: func(string) -> bool) -> Result<Record, i32>
    func map_values(f: func(Any) -> Any) -> Result<Record, i32>
    func update(key: string, f: func(Any) -> Any) -> Result<Record, i32>
    func pick(ks: List<string>) -> Result<Record, i32>
    func omit(ks: List<string>) -> Result<Record, i32>
}

// MapExt implementation for built-in Record type.
impl MapExt for Record {
    func get(key: string) -> (bool, Any) { map_get(self, key) }
    func set(key: string, value: Any) -> Result<Record, i32> {
        match map_clone(self) {
            Ok(result) => match map_set(result, key, value) {
                Ok(updated) => {
                    drop(result)
                    Ok(updated)
                },
                Err(status) => {
                    drop(result)
                    Err(status)
                },
            },
            Err(status) => Err(status),
        }
    }
    func has_key(key: string) -> bool { map_get(self, key).0 }
    func remove(key: string) -> Result<Record, i32> {
        match map_clone(self) {
            Ok(result) => {
                let updated = map_remove(result, key)
                drop(result)
                Ok(updated)
            },
            Err(status) => Err(status),
        }
    }
    func size() -> i32 { map_size(self) }
    func is_empty() -> bool { map_size(self) == 0 }
    func get_or_default(key: string, default: Any) -> Any {
        let result = map_get(self, key)
        if result.0 { result.1 } else { default }
    }
    func merge(other: Record) -> Result<Record, i32> {
        let b_keys = keys(other)
        let mut result = match map_clone(self) {
            Ok(root) => Ok(root),
            Err(status) => Err(status),
        }
        for bk in b_keys {
            result = match result {
                Ok(root) => {
                    let bv = map_get(other, bk)
                    match map_set(root, bk, bv.1) {
                        Ok(updated) => {
                            drop(root)
                            Ok(updated)
                        },
                        Err(status) => {
                            drop(root)
                            Err(status)
                        },
                    }
                },
                Err(status) => Err(status),
            }
        }
        result
    }
    func to_list() -> List<(string, Any)> {
        let ks = keys(self)
        let mut result: List<(string, Any)> = []
        let mut i = 0
        while i < len(ks) {
            push(result, (ks[i], map_get(self, ks[i]).1))
            i = i + 1
        }
        result
    }
    func filter_keys(pred: func(string) -> bool) -> Result<Record, i32> {
        let ks = keys(self)
        let mut result = match map_new() {
            Ok(root) => Ok(root),
            Err(status) => Err(status),
        }
        for fk_k in ks {
            result = match result {
                Ok(root) => {
                    if pred(fk_k) {
                        let fk_v = map_get(self, fk_k)
                        match map_set(root, fk_k, fk_v.1) {
                            Ok(updated) => {
                                drop(root)
                                Ok(updated)
                            },
                            Err(status) => {
                                drop(root)
                                Err(status)
                            },
                        }
                    } else {
                        Ok(root)
                    }
                },
                Err(status) => Err(status),
            }
        }
        result
    }
    func map_values(f: func(Any) -> Any) -> Result<Record, i32> {
        let ks = keys(self)
        let mut result = match map_new() {
            Ok(root) => Ok(root),
            Err(status) => Err(status),
        }
        for mv_k in ks {
            result = match result {
                Ok(root) => {
                    let mv_v = map_get(self, mv_k)
                    match map_set(root, mv_k, f(mv_v.1)) {
                        Ok(updated) => {
                            drop(root)
                            Ok(updated)
                        },
                        Err(status) => {
                            drop(root)
                            Err(status)
                        },
                    }
                },
                Err(status) => Err(status),
            }
        }
        result
    }
    func update(key: string, f: func(Any) -> Any) -> Result<Record, i32> {
        let uv = map_get(self, key)
        if uv.0 {
            match map_clone(self) {
                Ok(result) => match map_set(result, key, f(uv.1)) {
                    Ok(updated) => {
                        drop(result)
                        Ok(updated)
                    },
                    Err(status) => {
                        drop(result)
                        Err(status)
                    },
                },
                Err(status) => Err(status),
            }
        } else {
            Ok(self)
        }
    }
    func pick(ks: List<string>) -> Result<Record, i32> {
        let mut result = match map_new() {
            Ok(root) => Ok(root),
            Err(status) => Err(status),
        }
        for pk in ks {
            result = match result {
                Ok(root) => {
                    let pv = map_get(self, pk)
                    if pv.0 {
                        match map_set(root, pk, pv.1) {
                            Ok(updated) => {
                                drop(root)
                                Ok(updated)
                            },
                            Err(status) => {
                                drop(root)
                                Err(status)
                            },
                        }
                    } else {
                        Ok(root)
                    }
                },
                Err(status) => Err(status),
            }
        }
        result
    }
    func omit(ks: List<string>) -> Result<Record, i32> {
        // 0.39.136: membership is spelled inline (not via a bare `contains`)
        // so this body never depends on which module's `contains` wins name
        // resolution after a merge — builtins and stdlib share that name.
        let all_keys = keys(self)
        let mut result = map_clone(self)
        for ok in all_keys {
            result = match result {
                Ok(root) => {
                    let mut found = false
                    for k2 in ks {
                        if !found && k2 == ok { found = true }
                    }
                    if found {
                        let updated = map_remove(root, ok)
                        drop(root)
                        Ok(updated)
                    } else {
                        Ok(root)
                    }
                },
                Err(status) => Err(status),
            }
        }
        result
    }
}

// Compatibility functions — preserve the raw builtins' fallible Result API.

// new: Creates an empty Record (map).
pub func new() -> Result<Record, i32> {
    match map_new() {
        Ok(root) => Ok(root),
        Err(status) => Err(status),
    }
}

// get: Looks up key in map m. Returns (found, value).
pub func get(m: Record, key: string) -> (bool, Any) {
    map_get(m, key)
}

// set: Sets key to value in map m, returns updated map.
// Preserves the original map on both VM and native backends by copying first.
pub func set(m: Record, key: string, value: Any) -> Result<Record, i32> {
    match map_clone(m) {
        Ok(result) => match map_set(result, key, value) {
            Ok(updated) => {
                drop(result)
                Ok(updated)
            },
            Err(status) => {
                drop(result)
                Err(status)
            },
        },
        Err(status) => Err(status),
    }
}

// has_key: Returns true if key exists in m.
pub func has_key(m: Record, key: string) -> bool {
    map_get(m, key).0
}

// remove: Removes key from map m, returns updated map.
// Preserves the original map on both VM and native backends by copying first.
pub func remove(m: Record, key: string) -> Result<Record, i32> {
    match map_clone(m) {
        Ok(result) => {
            let updated = map_remove(result, key)
            drop(result)
            Ok(updated)
        },
        Err(status) => Err(status),
    }
}

// size: Returns the number of entries in map m.
pub func size(m: Record) -> i32 {
    map_size(m)
}

// from_list: Creates a map from a list of (key, value) pairs.
pub func from_list(pairs: List<(string, Any)>) -> Record {
    map_from_list(pairs)
}

// get_or_default: Looks up key, returns default if not found.
// 0.39.136: generic over the default's type — `get_or_default(m, k, 0)`
// now typechecks arithmetic from the default expression. This does NOT prove
// that an existing Map entry has type T: ordinary Map values currently erase
// their tags. The VM preserves the stored dynamic value, while native codegen
// rejects reachable DynamicAnyUnpack with E0722 until a checked tag/owner
// descriptor exists. Do not treat the generic signature as a runtime cast.
pub func get_or_default<T>(m: Record, key: string, default: T) -> T {
    let result = map_get(m, key)
    if result.0 { result.1 } else { default }
}

// merge: Returns a new map with all entries from a and b (b overwrites a).
pub func merge(a: Record, b: Record) -> Result<Record, i32> {
    let b_keys = keys(b)
    let mut result = match map_clone(a) {
        Ok(root) => Ok(root),
        Err(status) => Err(status),
    }
    for bk in b_keys {
        result = match result {
            Ok(root) => {
                let bv = map_get(b, bk)
                match map_set(root, bk, bv.1) {
                    Ok(updated) => {
                        drop(root)
                        Ok(updated)
                    },
                    Err(status) => {
                        drop(root)
                        Err(status)
                    },
                }
            },
            Err(status) => Err(status),
        }
    }
    result
}

// to_list: Converts a map to a list of (key, value) pairs.
pub func to_list(m: Record) -> List<(string, Any)> {
    let ks = keys(m)
    let mut result: List<(string, Any)> = []
    let mut i = 0
    while i < len(ks) {
        push(result, (ks[i], map_get(m, ks[i]).1))
        i = i + 1
    }
    result
}

// filter_keys: Returns a new map with only keys satisfying pred.
pub func filter_keys(m: Record, pred: func(string) -> bool) -> Result<Record, i32> {
    let ks = keys(m)
    let mut result = match map_new() {
        Ok(root) => Ok(root),
        Err(status) => Err(status),
    }
    for fk_k in ks {
        result = match result {
            Ok(root) => {
                if pred(fk_k) {
                    let fk_v = map_get(m, fk_k)
                    match map_set(root, fk_k, fk_v.1) {
                        Ok(updated) => {
                            drop(root)
                            Ok(updated)
                        },
                        Err(status) => {
                            drop(root)
                            Err(status)
                        },
                    }
                } else {
                    Ok(root)
                }
            },
            Err(status) => Err(status),
        }
    }
    result
}

// map_values: Returns a new map with f applied to each value.
pub func map_values(m: Record, f: func(Any) -> Any) -> Result<Record, i32> {
    let ks = keys(m)
    let mut result = match map_new() {
        Ok(root) => Ok(root),
        Err(status) => Err(status),
    }
    for mv_k in ks {
        result = match result {
            Ok(root) => {
                let mv_v = map_get(m, mv_k)
                match map_set(root, mv_k, f(mv_v.1)) {
                    Ok(updated) => {
                        drop(root)
                        Ok(updated)
                    },
                    Err(status) => {
                        drop(root)
                        Err(status)
                    },
                }
            },
            Err(status) => Err(status),
        }
    }
    result
}

// update: Applies f to the value at key, returns updated map.
pub func update(m: Record, key: string, f: func(Any) -> Any) -> Result<Record, i32> {
    let uv = map_get(m, key)
    if uv.0 {
        match map_clone(m) {
            Ok(result) => match map_set(result, key, f(uv.1)) {
                Ok(updated) => {
                    drop(result)
                    Ok(updated)
                },
                Err(status) => {
                    drop(result)
                    Err(status)
                },
            },
            Err(status) => Err(status),
        }
    } else {
        Ok(m)
    }
}

// pick: Returns a new map with only the specified keys.
pub func pick(m: Record, ks: List<string>) -> Result<Record, i32> {
    let mut result = match map_new() {
        Ok(root) => Ok(root),
        Err(status) => Err(status),
    }
    for pk in ks {
        result = match result {
            Ok(root) => {
                let pv = map_get(m, pk)
                if pv.0 {
                    match map_set(root, pk, pv.1) {
                        Ok(updated) => {
                            drop(root)
                            Ok(updated)
                        },
                        Err(status) => {
                            drop(root)
                            Err(status)
                        },
                    }
                } else {
                    Ok(root)
                }
            },
            Err(status) => Err(status),
        }
    }
    result
}

// omit: Returns a new map without the specified keys.
pub func omit(m: Record, ks: List<string>) -> Result<Record, i32> {
    // Same inline-membership rationale as the method form above.
    let all_keys = keys(m)
    let mut result = match map_clone(m) {
        Ok(root) => Ok(root),
        Err(status) => Err(status),
    }
    for ok in all_keys {
        result = match result {
            Ok(root) => {
                let mut found = false
                for k2 in ks {
                    if !found && k2 == ok { found = true }
                }
                if found {
                    let updated = map_remove(root, ok)
                    drop(root)
                    Ok(updated)
                } else {
                    Ok(root)
                }
            },
            Err(status) => Err(status),
        }
    }
    result
}
