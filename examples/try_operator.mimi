// Test ? operator with the built-in Result type.

func safe_div(a: i32, b: i32) -> Result<i32, string> {
    if b == 0 {
        return Err("division by zero");
    }
    return Ok(a / b);
}

func run_division() -> Result<i32, string> {
    // Test with ? - success path
    let result = safe_div(10, 2)?;
    println(result);
    Ok(result)
}

func main() -> i32 {
    match run_division() {
        Ok(result) => result,
        Err(_) => 1,
    }
}
