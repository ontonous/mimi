// Test error propagation with compensation - simple case

func step1() -> Result<i32, string> {
    println("Step 1...");
    Ok(1)
}

func step2() -> Result<i32, string> {
    println("Step 2...");
    Err("step 2 failed")
}

func step3() -> Result<i32, string> {
    println("Step 3...");
    Ok(3)
}

func cleanup1() {
    println("CLEANUP 1 executed");
}

func cleanup2() {
    println("CLEANUP 2 executed");
}

func run_steps() -> Result<i32, string> {
    on failure { cleanup1(); }

    let a = step1()?;
    on failure { cleanup2(); }

    let b = step2()?;
    let c = step3()?;

    println("All steps completed");
    Ok(0)
}

func main() -> i32 {
    match run_steps() {
        Ok(_) => 0,
        Err(_) => 1,
    }
}
