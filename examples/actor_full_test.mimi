// Full test of actor functionality - spawn and Flow-backed state transitions.

flow CounterState {
    state Active { count: i32 }

    transition increment(Active) -> Active {
        return Active { count: self.count + 1 }
    }

    transition get_count(Active) -> Active {
        return Active { count: self.count }
    }
}

actor Counter runs CounterState {}

func main() -> i32 {
    let c = Counter.spawn();
    let initial = c.get_count();
    println(initial.count);
    c.increment();
    let after_first = c.get_count();
    println(after_first.count);
    c.increment();
    let after_second = c.get_count();
    println(after_second.count);
    42
}
