# Rust build output
/target
Cargo.lock
!/Cargo.lock

# CMake build artifacts
/build/
**/build/CMakeCache.txt
**/build/CMakeFiles/
**/build/Makefile
**/build/cmake_install.cmake
**/build/*.cmake
**/build/*.so
**/build/*.o

# pybind11 extension modules
**/*.cpython-*.so

# Golden test diff artifacts
**/golden/*.diff.ir

# Mimi compiled executables and object files
*.o
# Known example/demo executables; keep nested source, docs, and evidence visible.
/examples/benchmark
/demos/04_adt_match
/demos/08_algorithms
projects/*/src/main
projects/*/main
tests/real_world/*_mimi
!tests/real_world/*.mimi
!tests/real_world/*.py
!tests/real_world/*.md

# Transient null rlib produced by LLVM/no_std experiments
libnull.rlib

# Python
__pycache__/
*.pyc
*.pyo

# Editor temp files
*.swp
*.swo
*~
.*.swp

# IDE
.vscode/
.idea/

# OS artifacts
.DS_Store
Thumbs.db

# Environment
.env
.env.local

# Internal development docs (not for public)
AGENTS.md
AGENTS_ANCHOR_*.md
# Keep internal devdocs ignored by default, while allowing the reproducible
# checked-unpack acceptance evidence for this development slice to be reviewed.
devdocs/**
!devdocs/v0.41/
devdocs/v0.41/**
!devdocs/v0.41/evidence-2026-10-29-map-any-checked-unpack/
!devdocs/v0.41/evidence-2026-10-29-map-any-checked-unpack/**

# Reference projects
references/

# Agent workspace
.mimocode/
.qoder/
.zcode/
# Local LLVM wrapper (canonical location is /tmp/llvm-wrapper; workspace copy
# used when /tmp does not persist, e.g. sandboxed agent shells)
.llvm-wrapper/

# Real-world suite generated project executables. Keep all inputs and evidence visible.
/tests/real_world/projects/*/src/main
/tests/real_world/projects/*/main
/tests/real_world/.*.temp-archive/
!/main
/main
docs/compose/

# Free-form development scratch buffer
.freebuff/
tests/stdlib_matrix_generated/
tests/stdlib_matrix_scratch/
mm_probe_*.txt

# Native executables, object files, runtime archives, and temporary files emitted by strict L3 gates.
# Keep raw stdout/stderr captures (*.bin), manifests, command transcripts,
# checksums, and source snapshots visible; gate executables use stable names.
evidence/0.1.11-dev/gates/map-v2-values-static-oob-l3-*/**/native-object
evidence/0.1.11-dev/gates/map-v2-values-static-oob-l3-*/**/runtime-archive
evidence/0.1.11-dev/gates/map-v2-values-static-oob-l3-*/**/relinked-program
evidence/0.1.11-dev/gates/map-v2-values-static-oob-l3-*/native-tmp/
# GetOrDefault<i32> L3 reuses the strict gate's named replay artifacts. The
# generic evidence/**/program and *.o rules above already cover those names.
evidence/0.1.11-dev/gates/map-owned-any-v2-get-or-default-i32-l3-*/**/native-object
evidence/0.1.11-dev/gates/map-owned-any-v2-get-or-default-i32-l3-*/**/runtime-archive
evidence/0.1.11-dev/gates/map-owned-any-v2-get-or-default-i32-l3-*/**/relinked-program
evidence/0.1.11-dev/gates/map-owned-any-v2-get-or-default-i32-l3-*/native-tmp/
# The Actor capture/shadow gate retains source inventories, census JSON/journals,
# raw command captures, and Memcheck reports. Ignore only generated native
# executables and object/archive files if a replay stores them under evidence.
evidence/0.1.11-dev/gates/actor-two-fixture-current-*/**/native-object
evidence/0.1.11-dev/gates/actor-two-fixture-current-*/**/runtime-archive
evidence/0.1.11-dev/gates/actor-two-fixture-current-*/**/relinked-program
evidence/0.1.11-dev/gates/actor-two-fixture-current-*/native-tmp/
# Full-route census JSON, journals, and logs preserve each run's denominator,
# per-input results, and raw command output.
evidence/**/program
evidence/**/program.tmp*
evidence/**/source*.tmp
evidence/**/files.sha256.tmp
evidence/**/consumer-evidence/**/native-false
evidence/**/consumer-evidence/**/native-true
evidence/**/canonical_mir_string_list_clone_oom
evidence/**/string-list-clone-oom-*/canonical_mir.o
evidence/**/string-list-clone-oom-*/clone_oom_harness.o
evidence/**/string-list-clone-oom-*/canonical_mir_clone_oom
evidence/**/native-l3-*/*/callbacks.o
evidence/**/test-artifacts/strict-memcheck/native-default
evidence/**/test-artifacts/strict-memcheck/native-explicit-mir
evidence/**/callback-test
evidence/**/strict-l3/*-native
evidence/**/raw-memcheck/*-native
# Observer V1 manual L3 gates emit profile-specific native executables.
evidence/**/observer-v1-l3-manual-*/*-native

# Local Rust/LLVM probe artifacts created at the repository root
/a.out
/mimi-values
/mimi-values-scopedrop
