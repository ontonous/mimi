# Rust build output
/target
Cargo.lock
!/Cargo.lock

# CMake build artifacts
/build/
**/build/CMakeCache.txt
**/build/CMakeFiles/
**/build/Makefile
**/build/cmake_install.cmake
**/build/*.cmake
**/build/*.so
**/build/*.o

# pybind11 extension modules
**/*.cpython-*.so

# Golden test diff artifacts
**/golden/*.diff.ir

# Mimi compiled executables and object files
*.o
# Known example/demo executables; keep nested source, docs, and evidence visible.
/examples/benchmark
/demos/04_adt_match
/demos/08_algorithms
projects/*/src/main
projects/*/main
tests/real_world/*_mimi
!tests/real_world/*.mimi
!tests/real_world/*.py
!tests/real_world/*.md

# Transient null rlib produced by LLVM/no_std experiments
libnull.rlib

# Python
__pycache__/
*.pyc
*.pyo

# Editor temp files
*.swp
*.swo
*~
.*.swp

# IDE
.vscode/
.idea/

# OS artifacts
.DS_Store
Thumbs.db

# Environment
.env
.env.local

# Internal development docs (not for public)
AGENTS.md
AGENTS_ANCHOR_*.md
devdocs/

# Reference projects
references/

# Agent workspace
.mimocode/
.qoder/
.zcode/
# Local LLVM wrapper (canonical location is /tmp/llvm-wrapper; workspace copy
# used when /tmp does not persist, e.g. sandboxed agent shells)
.llvm-wrapper/

# Real-world suite generated project executables. Keep all inputs and evidence visible.
/tests/real_world/projects/*/src/main
/tests/real_world/projects/*/main
/tests/real_world/.*.temp-archive/
!/main
/main
docs/compose/

# Free-form development scratch buffer
.freebuff/
tests/stdlib_matrix_generated/
tests/stdlib_matrix_scratch/
mm_probe_*.txt

# Reproducible native binaries emitted by gate evidence, including strict L3.
# Keep gate manifests, command transcripts, checksums, and source snapshots visible.
evidence/**/native/case-*/default-build/program
evidence/**/native/case-*/explicit-build/program
evidence/**/native/**/program
evidence/**/strict-l3/native-*/program
evidence/**/cli-*-build/program
evidence/**/consumer-evidence/**/native-false
evidence/**/consumer-evidence/**/native-true
evidence/**/callback-test
evidence/**/strict-l3/*-native
evidence/**/raw-memcheck/*-native

# Local Rust/LLVM probe artifacts created at the repository root
/a.out
/mimi-values
/mimi-values-scopedrop
