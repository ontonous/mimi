func test_room_manager_join_leave() -> TestResult {
    let rm = initialized_room_manager_or_exit()
    test_string_result(room_manager_create(rm, "lobby"))
    let r1 = test_string_result(room_manager_join(rm, "lobby", "Alice"))
    if r1 != "ok" { return test_fail("room_manager_join_leave", "Join failed: " + r1) }
    if !room_manager_is_member(rm, "lobby", "Alice") { return test_fail("room_manager_join_leave", "Expected Alice to be member") }
    let members = room_manager_get_members(rm, "lobby")
    if !list_contains_string(members, "Alice") { return test_fail("room_manager_join_leave", "Expected Alice in members list") }
    let r2 = test_string_result(room_manager_leave(rm, "lobby", "Alice"))
    if r2 != "ok" { return test_fail("room_manager_join_leave", "Leave failed: " + r2) }
    if room_manager_is_member(rm, "lobby", "Alice") { return test_fail("room_manager_join_leave", "Expected Alice to not be member after leave") }
    test_pass("room_manager_join_leave")
}

