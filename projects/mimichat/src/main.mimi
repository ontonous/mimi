func test_pass(name: string) -> TestResult { TestResult { name: name, passed: true, message: "" } }
func test_fail(name: string, msg: string) -> TestResult { TestResult { name: name, passed: false, message: msg } }

func test_is_blank() -> TestResult {
    if !is_blank("") { return test_fail("is_blank", "Expected empty string to be blank") }
    if !is_blank("  ") { return test_fail("is_blank", "Expected whitespace to be blank") }
    if is_blank("a") { return test_fail("is_blank", "Expected 'a' not to be blank") }
    test_pass("is_blank")
}

func test_encode_private_msg() -> TestResult {
    let msg = encode_private_msg("Alice", "Bob", "Hello!", 1000)
    if !json_is_valid(msg) { return test_fail("encode_private_msg", "Invalid JSON") }
    let tp = json_get_string(msg, "type")
    if tp != SVR_PRIVATE() { return test_fail("encode_private_msg", "Expected type=" + SVR_PRIVATE()) }
    let to_v = json_get_string(msg, "to")
    if to_v != "Bob" { return test_fail("encode_private_msg", "Expected to=Bob") }
    test_pass("encode_private_msg")
}

func test_encode_join_msg() -> TestResult {
    let msg = encode_join_msg("Alice", "lobby", 2000)
    if !json_is_valid(msg) { return test_fail("encode_join_msg", "Invalid JSON") }
    let tp = json_get_string(msg, "type")
    if tp != SVR_JOIN() { return test_fail("encode_join_msg", "Expected type=" + SVR_JOIN()) }
    let room_v = json_get_string(msg, "room")
    if room_v != "lobby" { return test_fail("encode_join_msg", "Expected room=lobby") }
    test_pass("encode_join_msg")
}

func test_encode_leave_msg() -> TestResult {
    let msg = encode_leave_msg("Alice", "general", 3000)
    if !json_is_valid(msg) { return test_fail("encode_leave_msg", "Invalid JSON") }
    let tp = json_get_string(msg, "type")
    if tp != SVR_LEAVE() { return test_fail("encode_leave_msg", "Expected type=" + SVR_LEAVE()) }
    test_pass("encode_leave_msg")
}

func test_encode_error_msg() -> TestResult {
    let msg = encode_error_msg("Something went wrong", 4000)
    if !json_is_valid(msg) { return test_fail("encode_error_msg", "Invalid JSON") }
    let txt = json_get_string(msg, "text")
    if txt != "Something went wrong" { return test_fail("encode_error_msg", "Expected text to match") }
    test_pass("encode_error_msg")
}

func test_encode_nick_msg() -> TestResult {
    let msg = encode_nick_msg("Alice", "Alice99", 5000)
    if !json_is_valid(msg) { return test_fail("encode_nick_msg", "Invalid JSON") }
    let old_v = json_get_string(msg, "old")
    if old_v != "Alice" { return test_fail("encode_nick_msg", "Expected old=Alice") }
    let new_v = json_get_string(msg, "new")
    if new_v != "Alice99" { return test_fail("encode_nick_msg", "Expected new=Alice99") }
    test_pass("encode_nick_msg")
}

