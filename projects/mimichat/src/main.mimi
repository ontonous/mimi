func test_format_timestamp_zeros() -> TestResult {
    let f0 = format_timestamp(0)
    if len(f0) == 0 { return test_fail("format_timestamp_zeros", "Expected non-empty output for 0") }
    let f_neg = format_timestamp(-1000)
    if len(f_neg) == 0 { return test_fail("format_timestamp_zeros", "Expected non-empty output for negative") }
    test_pass("format_timestamp_zeros")
}

func test_cmd_get_string_default() -> TestResult {
    let cmd = record_or_exit(map_new())
    let val = cmd_get_string(cmd, "nonexistent", "default")
    if val != "default" { return test_fail("cmd_get_string_default", "Expected default value") }
    let cmd2 = record_or_exit(command_map_set(map_new(), "key", "value"))
    let val2 = cmd_get_string(cmd2, "key", "fallback")
    if val2 != "value" { return test_fail("cmd_get_string_default", "Expected 'value', got '" + val2 + "'") }
    test_pass("cmd_get_string_default")
}

func test_list_contains_edge_cases() -> TestResult {
    let empty: List<string> = []
    if list_contains_string(empty, "x") { return test_fail("list_contains_edge_cases", "Empty list should not contain anything") }
    let single = ["only"]
    if !list_contains_string(single, "only") { return test_fail("list_contains_edge_cases", "Should find 'only'") }
    if list_contains_string(single, "ONLY") { return test_fail("list_contains_edge_cases", "Should be case-sensitive") }
    let multi = ["a", "b", "c"]
    let mut count = 0
    for x in multi { if x == "a" || x == "b" || x == "c" { count = count + 1 } }
    if count != 3 { return test_fail("list_contains_edge_cases", "Expected 3 items") }
    test_pass("list_contains_edge_cases")
}

func test_is_valid_nick() -> TestResult {
    if !is_valid_nick("Alice") { return test_fail("is_valid_nick", "Expected 'Alice' to be valid") }
    if !is_valid_nick("a1_b") { return test_fail("is_valid_nick", "Expected 'a1_b' to be valid") }
    if is_valid_nick("a") { return test_fail("is_valid_nick", "Expected 'a' (len=1) to be invalid") }
    if is_valid_nick("") { return test_fail("is_valid_nick", "Expected empty nick to be invalid") }
    if is_valid_nick("hello world") { return test_fail("is_valid_nick", "Expected nick with space to be invalid") }
    test_pass("is_valid_nick")
}

func test_is_valid_room_name() -> TestResult {
    if !is_valid_room_name("general") { return test_fail("is_valid_room_name", "Expected 'general' to be valid") }
    if !is_valid_room_name("my-room_1") { return test_fail("is_valid_room_name", "Expected 'my-room_1' to be valid") }
    if is_valid_room_name("") { return test_fail("is_valid_room_name", "Expected empty name to be invalid") }
    if is_valid_room_name("room with spaces") { return test_fail("is_valid_room_name", "Expected name with spaces to be invalid") }
    if is_valid_room_name("special!@#") { return test_fail("is_valid_room_name", "Expected special chars to be invalid") }
    test_pass("is_valid_room_name")
}

func test_escape_json_string() -> TestResult {
    let r1 = escape_json_string("hello")
    if r1 != "hello" { return test_fail("escape_json_string", "Expected 'hello', got '" + r1 + "'") }
    let r2 = escape_json_string("he\"llo")
    if r2 != "he\\\"llo" { return test_fail("escape_json_string", "Expected 'he\\\\\"llo', got '" + r2 + "'") }
    test_pass("escape_json_string")
}

func test_list_ops() -> TestResult {
    let mut items: List<string> = []
    if len(items) != 0 { return test_fail("list_ops", "Expected empty list") }
    push(items, "a"); push(items, "b"); push(items, "c")
    if len(items) != 3 { return test_fail("list_ops", "Expected len=3") }
    if items[0] != "a" { return test_fail("list_ops", "Expected items[0]='a'") }
    if !list_contains_string(items, "b") { return test_fail("list_ops", "Expected contains 'b'") }
    if list_contains_string(items, "z") { return test_fail("list_ops", "Expected not contains 'z'") }
    test_pass("list_ops")
}

func test_format_timestamp() -> TestResult {
    let f1 = format_timestamp(0)
    if len(f1) != 8 { return test_fail("format_timestamp", "Expected 8 chars (HH:MM:SS), got '" + f1 + "'") }
    let f2 = format_timestamp(3600000)
    if len(f2) != 8 { return test_fail("format_timestamp", "Expected 8 chars for 1h timestamp") }
    test_pass("format_timestamp")
}

func test_safe_parse_int() -> TestResult {
    let r1 = safe_parse_int("42", 0)
    if r1 != 42 { return test_fail("safe_parse_int", "Expected 42, got " + to_string(r1)) }
    let r2 = safe_parse_int("not_a_number", 99)
    if r2 != 99 { return test_fail("safe_parse_int", "Expected default 99, got " + to_string(r2)) }
    test_pass("safe_parse_int")
}

func test_parse_client_command() -> TestResult {
    let c1 = parse_client_command_or_exit("/join general")
    if !cmd_is(c1, CMD_JOIN()) { return test_fail("parse_client_command", "Expected cmd=join") }
    let room1 = cmd_get_string(c1, "room", "")
    if room1 != "general" { return test_fail("parse_client_command", "Expected room=general, got '" + room1 + "'") }
    let c2 = parse_client_command_or_exit("/nick Alice")
    if !cmd_is(c2, CMD_NICK()) { return test_fail("parse_client_command", "Expected cmd=nick") }
    let n2 = cmd_get_string(c2, "name", "")
    if n2 != "Alice" { return test_fail("parse_client_command", "Expected name=Alice, got '" + n2 + "'") }
    let c3 = parse_client_command_or_exit("hello world")
    if !cmd_is(c3, CMD_MSG()) { return test_fail("parse_client_command", "Expected cmd=msg for plain text") }
    let t3 = cmd_get_string(c3, "text", "")
    if t3 != "hello world" { return test_fail("parse_client_command", "Expected text=hello world, got '" + t3 + "'") }
    let c4 = parse_client_command_or_exit("{\"cmd\":\"join\",\"room\":\"test\"}")
    if !cmd_is(c4, CMD_JOIN()) { return test_fail("parse_client_command", "Expected cmd=join from JSON") }
    let room4 = cmd_get_string(c4, "room", "")
    if room4 != "test" { return test_fail("parse_client_command", "Expected room=test from JSON, got '" + room4 + "'") }
    let c5 = parse_client_command_or_exit("{\"cmd\":\"private\",\"to\":\"bob\",\"text\":\"hi\"}")
    if !cmd_is(c5, CMD_PRIVATE()) { return test_fail("parse_client_command", "Expected cmd=private from JSON") }
    let to5 = cmd_get_string(c5, "to", "")
    if to5 != "bob" { return test_fail("parse_client_command", "Expected to=bob, got '" + to5 + "'") }
    test_pass("parse_client_command")
}

func test_encode_chat_msg() -> TestResult {
    let msg = encode_chat_msg("Alice", "general", "Hello!", 1000)
    if !json_is_valid(msg) { return test_fail("encode_chat_msg", "Invalid JSON: " + msg) }
    let mtype = json_get_string(msg, "type")
    if mtype != SVR_CHAT() { return test_fail("encode_chat_msg", "Expected type=chat, got '" + mtype + "'") }
    let from = json_get_string(msg, "from")
    if from != "Alice" { return test_fail("encode_chat_msg", "Expected from=Alice, got '" + from + "'") }
    let text = json_get_string(msg, "text")
    if text != "Hello!" { return test_fail("encode_chat_msg", "Expected text=Hello!, got '" + text + "'") }
    let ts_v = json_get_int(msg, "ts")
    if ts_v != 1000 { return test_fail("encode_chat_msg", "Expected ts=1000, got " + to_string(ts_v)) }
    test_pass("encode_chat_msg")
}

func test_encode_system_msg() -> TestResult {
    let msg = encode_system_msg("Welcome!", 5000)
    if !json_is_valid(msg) { return test_fail("encode_system_msg", "Invalid JSON") }
    let mtype = json_get_string(msg, "type")
    if mtype != SVR_SYSTEM() { return test_fail("encode_system_msg", "Expected type=system") }
    let text = json_get_string(msg, "text")
    if text != "Welcome!" { return test_fail("encode_system_msg", "Expected text=Welcome!") }
    test_pass("encode_system_msg")
}

func test_user_manager_basic() -> TestResult {
    let um = initialized_user_manager_or_exit()
    test_string_result(user_manager_register(um, "Alice", 100 as i64))
    if !user_manager_nick_exists(um, "Alice") { return test_fail("user_manager_basic", "Expected Alice to exist") }
    let nick = user_manager_get_nick(um, 100 as i64)
    if nick != "Alice" { return test_fail("user_manager_basic", "Expected get_nick=Alice, got '" + nick + "'") }
    let fd = user_manager_get_fd(um, "Alice")
    if fd != 100 as i64 { return test_fail("user_manager_basic", "Expected get_fd=100, got " + to_string(fd)) }
    let cnt = user_manager_count(um)
    if cnt != 1 { return test_fail("user_manager_basic", "Expected count=1, got " + to_string(cnt)) }
    test_pass("user_manager_basic")
}

func test_user_manager_nick_collision() -> TestResult {
    let um = initialized_user_manager_or_exit()
    test_string_result(user_manager_register(um, "Alice", 100 as i64))
    let r2 = test_string_result(user_manager_register(um, "Alice", 200 as i64))
    if r2 == "ok" { return test_fail("user_manager_nick_collision", "Expected collision for duplicate nick") }
    let r3 = test_string_result(user_manager_register(um, "alice", 300 as i64))
    if r3 == "ok" { return test_fail("user_manager_nick_collision", "Expected collision for case-insensitive duplicate") }
    test_pass("user_manager_nick_collision")
}

func test_user_manager_change_nick() -> TestResult {
    let um = initialized_user_manager_or_exit()
    test_string_result(user_manager_register(um, "Alice", 100 as i64))
    let old_nick_val = test_string_result(user_manager_change_nick(um, 100 as i64, "Alice99"))
    if old_nick_val == "" || old_nick_val == "ok" { return test_fail("user_manager_change_nick", "Expected old nick returned") }
    if user_manager_nick_exists(um, "Alice") { return test_fail("user_manager_change_nick", "Alice should not exist after rename") }
    if !user_manager_nick_exists(um, "Alice99") { return test_fail("user_manager_change_nick", "Alice99 should exist") }
    let new_nick = user_manager_get_nick(um, 100 as i64)
    if new_nick != "Alice99" { return test_fail("user_manager_change_nick", "Expected get_nick=Alice99, got '" + new_nick + "'") }
    test_pass("user_manager_change_nick")
}

