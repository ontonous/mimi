func test_room_manager_member_count() -> TestResult {
    let rm = initialized_room_manager_or_exit()
    test_string_result(room_manager_create(rm, "lobby"))
    if room_manager_member_count(rm, "lobby") != 0 { return test_fail("room_manager_member_count", "Expected 0 members") }
    test_string_result(room_manager_join(rm, "lobby", "Alice"))
    if room_manager_member_count(rm, "lobby") != 1 { return test_fail("room_manager_member_count", "Expected 1 member") }
    test_string_result(room_manager_join(rm, "lobby", "Bob"))
    if room_manager_member_count(rm, "lobby") != 2 { return test_fail("room_manager_member_count", "Expected 2 members") }
    test_string_result(room_manager_leave(rm, "lobby", "Alice"))
    if room_manager_member_count(rm, "lobby") != 1 { return test_fail("room_manager_member_count", "Expected 1 member after leave") }
    test_pass("room_manager_member_count")
}

func test_store_add_rollover_verify() -> TestResult {
    let store = create_store(3, "/tmp/mimichat_test_rollover2.json")
    let mut s = store
    s = store_add(s, "msg1"); s = store_add(s, "msg2"); s = store_add(s, "msg3")
    if len(s.buffer) != 3 { return test_fail("store_add_rollover_verify", "Expected 3 messages") }
    s = store_add(s, "msg4")
    if len(s.buffer) != 3 { return test_fail("store_add_rollover_verify", "Expected 3 messages after rollover") }
    test_pass("store_add_rollover_verify")
}

func test_store_add_exact_max() -> TestResult {
    let store = create_store(5, "/tmp/mimichat_test_exact.json")
    let mut s = store
    let mut i = 0
    while i < 5 { s = store_add(s, "{\"n\":" + to_string(i) + "}"); i = i + 1 }
    if len(s.buffer) != 5 { return test_fail("store_add_exact_max", "Expected 5 at exact max") }
    test_pass("store_add_exact_max")
}

func test_store_add_single() -> TestResult {
    let store = create_store(10, "/tmp/mimichat_test_single.json")
    let s = store_add(store, "single")
    if len(s.buffer) != 1 { return test_fail("store_add_single", "Expected 1") }
    test_pass("store_add_single")
}

func test_store_add_preserves_order() -> TestResult {
    let store = create_store(10, "/tmp/mimichat_test_order.json")
    let mut s = store
    s = store_add(s, "first"); s = store_add(s, "second"); s = store_add(s, "third")
    if len(s.buffer) != 3 { return test_fail("store_add_preserves_order", "Expected 3") }
    test_pass("store_add_preserves_order")
}

func test_safe_substring_basic() -> TestResult {
    let s1 = safe_substring("hello", 0, 5)
    if s1 != "hello" { return test_fail("safe_substring_basic", "Expected 'hello', got '" + s1 + "'") }
    let s2 = safe_substring("hello", 0, 3)
    if s2 != "hel" { return test_fail("safe_substring_basic", "Expected 'hel', got '" + s2 + "'") }
    let s3 = safe_substring("hello", 1, 4)
    if s3 != "ell" { return test_fail("safe_substring_basic", "Expected 'ell', got '" + s3 + "'") }
    test_pass("safe_substring_basic")
}

func test_safe_substring_edge() -> TestResult {
    let s1 = safe_substring("abc", 0, 0)
    if s1 != "" { return test_fail("safe_substring_edge", "Expected empty for 0 len") }
    let s2 = safe_substring("abc", 10, 5)
    if s2 != "" { return test_fail("safe_substring_edge", "Expected empty for start>len") }
    let s3 = safe_substring("abc", 0, 10)
    if s3 != "abc" { return test_fail("safe_substring_edge", "Expected 'abc', got '" + s3 + "'") }
    let s4 = safe_substring("", 0, 5)
    if s4 != "" { return test_fail("safe_substring_edge", "Expected empty for empty string") }
    test_pass("safe_substring_edge")
}

func test_format_timestamp_large() -> TestResult {
    let f1 = format_timestamp(86400000)
    if !str_contains(f1, "d") { return test_fail("format_timestamp_large", "Expected day component") }
    let f2 = format_timestamp(0)
    if len(f2) == 0 { return test_fail("format_timestamp_large", "Expected non-empty") }
    test_pass("format_timestamp_large")
}

func test_user_manager_get_nick() -> TestResult {
    let um = initialized_user_manager_or_exit()
    let nick1 = user_manager_get_nick(um, 100 as i64)
    if nick1 != "" { return test_fail("user_manager_get_nick", "Expected empty for unknown FD") }
    test_string_result(user_manager_register(um, "Alice", 100 as i64))
    let nick2 = user_manager_get_nick(um, 100 as i64)
    if nick2 != "Alice" { return test_fail("user_manager_get_nick", "Expected 'Alice', got '" + nick2 + "'") }
    test_pass("user_manager_get_nick")
}

func test_user_manager_get_fd() -> TestResult {
    let um = initialized_user_manager_or_exit()
    let fd1 = user_manager_get_fd(um, "Alice")
    if fd1 >= 0 { return test_fail("user_manager_get_fd", "Expected negative for unknown nick") }
    test_string_result(user_manager_register(um, "Alice", 100 as i64))
    let fd2 = user_manager_get_fd(um, "Alice")
    if fd2 != 100 as i64 { return test_fail("user_manager_get_fd", "Expected fd=100, got " + to_string(fd2)) }
    test_pass("user_manager_get_fd")
}

func test_user_manager_history_trim() -> TestResult {
    let um = initialized_user_manager_or_exit()
    let mut i = 0
    while i < 20 { user_manager_push_history(um, "{\"msg\":" + to_string(i) + "}"); i = i + 1 }
    let h = user_manager_get_history(um, 100)
    if len(h) != 20 { return test_fail("user_manager_history_trim", "Expected 20 entries before trim, got " + to_string(len(h))) }
    let um2 = initialized_user_manager_or_exit()
    i = 0
    while i < 1100 { user_manager_push_history(um2, "{\"msg\":" + to_string(i) + "}"); i = i + 1 }
    let h2 = user_manager_get_history(um2, 2000)
    if len(h2) > 1050 { return test_fail("user_manager_history_trim", "Expected trim to limit history to <=1000, got " + to_string(len(h2))) }
    test_pass("user_manager_history_trim")
}

func run_all_tests() -> i32 {
    println("MimiChat Test Suite v0.1.0")
    println("================================")
    let mut results: List<TestResult> = []
    push(results, test_is_blank())
    push(results, test_is_valid_nick())
    push(results, test_is_valid_room_name())
    push(results, test_escape_json_string())
    push(results, test_list_ops())
    push(results, test_list_contains_edge_cases())
    push(results, test_format_timestamp())
    push(results, test_format_timestamp_zeros())
    push(results, test_cmd_get_string_default())
    push(results, test_safe_parse_int())
    push(results, test_client_cmd())
    push(results, test_client_cmd_str())
    push(results, test_encode_chat_msg())
    push(results, test_encode_private_msg())
    push(results, test_encode_join_msg())
    push(results, test_encode_leave_msg())
    push(results, test_encode_error_msg())
    push(results, test_encode_nick_msg())
    push(results, test_encode_rooms_msg())
    push(results, test_encode_users_msg())
    push(results, test_encode_ok_msg())
    push(results, test_encode_pong_msg())
    push(results, test_encode_topic_msg())
    push(results, test_encode_history_msg())
    push(results, test_encode_system_msg())
    push(results, test_parse_client_command())
    push(results, test_safe_parse_int())
    push(results, test_parse_client_command())
    push(results, test_encode_chat_msg())
    push(results, test_encode_system_msg())
    push(results, test_user_manager_basic())
    push(results, test_user_manager_nick_collision())
    push(results, test_user_manager_change_nick())
    push(results, test_room_manager_basic())
    push(results, test_room_manager_join_leave())
    push(results, test_room_manager_create())
    push(results, test_message_store_basic())
    push(results, test_message_store_rollover())
    push(results, test_user_manager_history())
    push(results, test_room_manager_topic())
    push(results, test_room_manager_motd())
    push(results, test_user_manager_history_trim())
    push(results, test_is_blank_edge())
    push(results, test_user_manager_set_room())
    push(results, test_user_manager_get_room())
    push(results, test_user_manager_list_nicks())
    push(results, test_user_manager_unregister())
    push(results, test_user_manager_get_nick())
    push(results, test_user_manager_get_fd())
    push(results, test_room_manager_count())
    push(results, test_room_manager_duplicate_join())
    push(results, test_room_manager_member_count())
    push(results, test_store_add_rollover_verify())
    push(results, test_store_add_exact_max())
    push(results, test_store_add_single())
    push(results, test_store_add_preserves_order())
    push(results, test_safe_substring_basic())
    push(results, test_safe_substring_edge())
    push(results, test_format_timestamp_large())
    push(results, test_user_manager_clear())
    push(results, test_room_manager_clear())
    push(results, test_encode_empty_rooms())
    push(results, test_encode_empty_users())
    push(results, test_encode_empty_history())
    push(results, test_integration_basic())
    let total = len(results)
    let mut passed_count = 0
    for r in results {
        if r.passed { passed_count = passed_count + 1 }
    }
    println("")
    println("================================")
    println("Results: " + to_string(passed_count) + "/" + to_string(total) + " passed")
    println("")
    for r in results {
        let status = if r.passed { "PASS" } else { "FAIL" }
        println("  [" + status + "] " + r.name)
        if !r.passed { println("        " + r.message) }
    }
    println("")
    if passed_count == total { println("All tests passed!"); 0 }
    else { println(to_string(total - passed_count) + " test(s) failed."); 1 }
}

// ═══════════════════════════════════════════════════════════════════════════════
// Section 11: Main Entry Point
// ═══════════════════════════════════════════════════════════════════════════════

func print_global_usage() {
    println("MimiChat v0.1.0 - Multi-User Chat System")
    println("")
    println("Usage:")
    println("  mimichat server [options]        Start chat server")
    println("  mimichat client [host] [port]    Start chat client")
    println("  mimichat test                    Run automated tests")
    println("  mimichat --help                  Show this help")
    println("")
    println("Examples:")
    println("  mimichat server")
    println("  mimichat server --port 8888 --max-clients 100")
    println("  mimichat client 127.0.0.1 7777")
    println("  mimichat test")
}

func main() -> i32 {
    let arg_list = args()
    if len(arg_list) == 0 { print_global_usage(); return 0 }
    let mode = str_to_lower(arg_list[0])
    if mode == "server" || mode == "serve" || mode == "s" {
        let mut server_args: List<string> = []
        let mut i = 1
        while i < len(arg_list) { push(server_args, arg_list[i]); i = i + 1 }
        let config = parse_server_args(server_args)
        println("Starting MimiChat server on port " + to_string(config.port) + "...")
        match init_server(config) {
            Ok((srv_fd, um, rm)) => if srv_fd >= 0 { run_server_loop(srv_fd, um, rm, config) } else { 1 },
            Err(status) => {
                println("FATAL: Map initialization failed with status " + to_string(status))
                status
            }
        }
    } else if mode == "client" || mode == "cli" || mode == "c" {
        let host = if len(arg_list) > 1 { arg_list[1] } else { "127.0.0.1" }
        let port = if len(arg_list) > 2 { safe_parse_int(arg_list[2], 7777) } else { 7777 }
        let nick = if len(arg_list) > 3 { arg_list[3] } else { "user_" + to_string(now_ms() % 10000) }
        run_client(host, port, nick)
    } else if mode == "test" || mode == "tests" || mode == "t" || mode == "--test" {
        run_all_tests()
    } else if mode == "--help" || mode == "-h" || mode == "help" { print_global_usage(); 0 }
    else { println("Unknown mode: " + mode); print_global_usage(); 1 }
}
