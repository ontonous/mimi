// ═══════════════════════════════════════════════════════════════════════════════
// MimiChat — Multi-User Chat System
// Version: 0.1.0
// License: Apache-2.0
//
// A JSON-TCP chat server with concurrent room management, private messaging,
// nickname management, message persistence, and interactive CLI client.
//
// Usage:
//   mimi run src/main.mimi server [port]        Start chat server
//   mimi run src/main.mimi client [host] [port] [nick]   Start chat client
//   mimi run src/main.mimi test                  Run automated tests
//
// Architecture:
//   - TCP server with spawn'd per-connection handler
//   - Actor-based RoomManager for thread-safe room state
//   - Actor-based UserManager for thread-safe user state
//   - JSON line-delimited protocol over TCP
//   - File-based message history persistence
//   - Modular test suite with component-level and integration tests
// ═══════════════════════════════════════════════════════════════════════════════

// ═══════════════════════════════════════════════════════════════════════════════
// Section 1: Types & Constants
// ═══════════════════════════════════════════════════════════════════════════════

type ChatMessage { msg_type: string, sender: string, room: string, text: string, target: string, timestamp: i64 }

type ServerConfig { port: i32, max_clients: i32, history_file: string, max_history: i32 }

func default_server_config() -> ServerConfig {
    ServerConfig { port: 7777, max_clients: 64, history_file: "mimichat_history.json", max_history: 1000 }
}

type RoomInfo { name: string, member_count: i32, created_at: i64 }

type UserInfo { nick: string, fd: i64, joined_at: i64, room: string }

type TestResult { name: string, passed: bool, message: string }

func CMD_JOIN() -> string { "join" }
func CMD_LEAVE() -> string { "leave" }
func CMD_MSG() -> string { "msg" }
func CMD_PRIVATE() -> string { "private" }
func CMD_NICK() -> string { "nick" }
func CMD_CREATE() -> string { "create" }
func CMD_ROOMS() -> string { "rooms" }
func CMD_USERS() -> string { "users" }
func CMD_HELP() -> string { "help" }
func CMD_QUIT() -> string { "quit" }
func CMD_KICK() -> string { "kick" }
func CMD_MOTD() -> string { "motd" }
func CMD_HISTORY() -> string { "history" }
func CMD_TOPIC() -> string { "topic" }
func CMD_PING() -> string { "ping" }
func SVR_CHAT() -> string { "chat" }
func SVR_PRIVATE() -> string { "private" }
func SVR_JOIN() -> string { "join" }
func SVR_LEAVE() -> string { "leave" }
func SVR_SYSTEM() -> string { "system" }
func SVR_ERROR() -> string { "error" }
func SVR_ROOMS() -> string { "rooms" }
func SVR_USERS() -> string { "users" }
func SVR_NICK() -> string { "nick" }
func SVR_HISTORY() -> string { "history" }
func SVR_MOTD() -> string { "motd" }
func SVR_TOPIC() -> string { "topic" }
func SVR_PONG() -> string { "pong" }
func SVR_OK() -> string { "ok" }
func SERVER_NICK() -> string { "*server*" }
func SYSTEM_NICK() -> string { "*system*" }
func DEFAULT_ROOM() -> string { "lobby" }
func PROTO_VER() -> i32 { 1 }

// ═══════════════════════════════════════════════════════════════════════════════
// Section 2: Utility Functions
// ═══════════════════════════════════════════════════════════════════════════════

func format_timestamp(ts: i64) -> string {
    let secs = ts / 1000
    let days = secs / 86400
    let hours = secs / 3600 % 24
    let mins = secs / 60 % 60
    let sec = secs % 60
    let h_str = if hours < 10 { "0" + to_string(hours) } else { to_string(hours) }
    let m_str = if mins < 10 { "0" + to_string(mins) } else { to_string(mins) }
    let s_str = if sec < 10 { "0" + to_string(sec) } else { to_string(sec) }
    if days > 0 {
        to_string(days) + "d " + h_str + ":" + m_str + ":" + s_str
    } else {
        h_str + ":" + m_str + ":" + s_str
    }
}

func safe_substring(s: string, start: i32, end: i32) -> string {
    let l = len(s)
    let s_start = if start < 0 { 0 } else if start > l { l } else { start }
    let s_end = if end < s_start { s_start } else if end > l { l } else { end }
    str_substring(s, s_start, s_end)
}

func truncate_with_ellipsis(s: string, max_len: i32) -> string {
    if len(s) <= max_len { s } else { str_substring(s, 0, max_len - 3) + "..." }
}

func is_blank(s: string) -> bool { let trimmed = str_trim(s); len(trimmed) == 0 }

func join_strings(items: List<string>, delim: string) -> string {
    let mut result = ""
    let mut first_item = true
    for item in items {
        if !first_item { result = result + delim }
        first_item = false
        result = result + item
    }
    result
}

func escape_json_string(s: string) -> string {
    let mut result = ""
    let mut i = 0
    while i < len(s) {
        let ch = str_char_at(s, i)
        if ch == "\"" { result = result + "\\\"" }
        else if ch == "\\" { result = result + "\\\\" }
        else if ch == "\n" { result = result + "\\n" }
        else if ch == "\r" { result = result + "\\r" }
        else if ch == "\t" { result = result + "\\t" }
        else { result = result + ch }
        i = i + 1
    }
    result
}

func list_remove_string(items: List<string>, item: string) -> List<string> {
    let mut result: List<string> = []
    for x in items {
        if x != item { push(result, x) }
    }
    result
}

func list_contains_string(items: List<string>, item: string) -> bool {
    let mut found = false
    for x in items {
        if x == item { found = true }
    }
    found
}

func safe_parse_int(s: string, default_val: i32) -> i32 {
    let (ok, val) = str_parse_int(s)
    if ok { val as i32 } else { default_val }
}

// ═══════════════════════════════════════════════════════════════════════════════
// Section 3: JSON Protocol Encoding / Decoding
// ═══════════════════════════════════════════════════════════════════════════════

// Decode a JSON array string into a List<string>. Used by RoomManager actor
// methods to read member lists from the map; v0.28.28 fix for #1 unblocked
// the actor-worker Interpreter from calling user-defined functions, so this
// helper can live as a top-level function instead of being inlined.
func members_from_json(json_str: string) -> List<string> {
    let parsed = from_json::<List<string>>(json_str)
    let mut members: List<string> = []
    for x in parsed { push(members, x) }
    members
}

func encode_chat_msg(from: string, room: string, text: string, ts: i64) -> string {
    "{\"type\":\"" + SVR_CHAT() + "\",\"from\":\"" + escape_json_string(from) + "\",\"room\":\"" + escape_json_string(room) + "\",\"text\":\"" + escape_json_string(text) + "\",\"ts\":" + to_string(ts) + "}"
}

func encode_private_msg(from: string, to: string, text: string, ts: i64) -> string {
    "{\"type\":\"" + SVR_PRIVATE() + "\",\"from\":\"" + escape_json_string(from) + "\",\"to\":\"" + escape_json_string(to) + "\",\"text\":\"" + escape_json_string(text) + "\",\"ts\":" + to_string(ts) + "}"
}

func encode_system_msg(text: string, ts: i64) -> string {
    "{\"type\":\"" + SVR_SYSTEM() + "\",\"text\":\"" + escape_json_string(text) + "\",\"ts\":" + to_string(ts) + "}"
}

func encode_join_msg(user: string, room: string, ts: i64) -> string {
    "{\"type\":\"" + SVR_JOIN() + "\",\"user\":\"" + escape_json_string(user) + "\",\"room\":\"" + escape_json_string(room) + "\",\"ts\":" + to_string(ts) + "}"
}

func encode_leave_msg(user: string, room: string, ts: i64) -> string {
    "{\"type\":\"" + SVR_LEAVE() + "\",\"user\":\"" + escape_json_string(user) + "\",\"room\":\"" + escape_json_string(room) + "\",\"ts\":" + to_string(ts) + "}"
}

func encode_error_msg(text: string, ts: i64) -> string {
    "{\"type\":\"" + SVR_ERROR() + "\",\"text\":\"" + escape_json_string(text) + "\",\"ts\":" + to_string(ts) + "}"
}

func encode_nick_msg(old_nick: string, new_nick: string, ts: i64) -> string {
    "{\"type\":\"" + SVR_NICK() + "\",\"old\":\"" + escape_json_string(old_nick) + "\",\"new\":\"" + escape_json_string(new_nick) + "\",\"ts\":" + to_string(ts) + "}"
}

func encode_rooms_msg(rooms: List<string>, ts: i64) -> string {
    let mut result = "{\"type\":\"" + SVR_ROOMS() + "\",\"rooms\":["
    let mut first = true
    for r in rooms {
        if !first { result = result + "," }
        first = false
        result = result + "\"" + escape_json_string(r) + "\""
    }
    result + "],\"ts\":" + to_string(ts) + "}"
}

func encode_users_msg(users: List<string>, ts: i64) -> string {
    let mut result = "{\"type\":\"" + SVR_USERS() + "\",\"users\":["
    let mut first = true
    for u in users {
        if !first { result = result + "," }
        first = false
        result = result + "\"" + escape_json_string(u) + "\""
    }
    result + "],\"ts\":" + to_string(ts) + "}"
}

func encode_ok_msg(text: string, ts: i64) -> string {
    "{\"type\":\"" + SVR_OK() + "\",\"text\":\"" + escape_json_string(text) + "\",\"ts\":" + to_string(ts) + "}"
}

func encode_pong_msg(ts: i64) -> string {
    "{\"type\":\"" + SVR_PONG() + "\",\"ts\":" + to_string(ts) + "}"
}

func encode_history_msg(entries: List<string>, ts: i64) -> string {
    let mut result = "{\"type\":\"" + SVR_HISTORY() + "\",\"messages\":["
    let mut first = true
    for e in entries {
        if !first { result = result + "," }
        first = false
        result = result + e
    }
    result + "],\"ts\":" + to_string(ts) + "}"
}

func encode_topic_msg(room: string, topic: string, ts: i64) -> string {
    "{\"type\":\"" + SVR_TOPIC() + "\",\"room\":\"" + escape_json_string(room) + "\",\"topic\":\"" + escape_json_string(topic) + "\",\"ts\":" + to_string(ts) + "}"
}

func encode_motd_msg(motd: string, ts: i64) -> string {
    "{\"type\":\"" + SVR_MOTD() + "\",\"text\":\"" + escape_json_string(motd) + "\",\"ts\":" + to_string(ts) + "}"
}

func command_map_set(current: Result<Record, i32>, key: string, value: Any) -> Result<Record, i32> {
    match current {
        Ok(root) => match map_set(root, key, value) {
            Ok(updated) => {
                drop(root)
                Ok(updated)
            }
            Err(status) => {
                drop(root)
                Err(status)
            }
        }
        Err(status) => Err(status)
    }
}

// Parse a client command from a JSON string or command line
func parse_client_command(line: string) -> Result<Record, i32> {
    let trimmed = str_trim(line)
    let mut result = match map_new() {
        Ok(root) => Ok(root),
        Err(status) => Err(status)
    }
    if len(trimmed) == 0 { return result }
    if json_is_valid(trimmed) {
        let cmd_raw = json_get_string(trimmed, "cmd")
        if cmd_raw != "" { result = command_map_set(result, "cmd", cmd_raw) }
        let room_raw = json_get_string(trimmed, "room")
        if room_raw != "" { result = command_map_set(result, "room", room_raw) }
        let text_raw = json_get_string(trimmed, "text")
        if text_raw != "" { result = command_map_set(result, "text", text_raw) }
        let to_raw = json_get_string(trimmed, "to")
        if to_raw != "" { result = command_map_set(result, "to", to_raw) }
        let name_raw = json_get_string(trimmed, "name")
        if name_raw != "" { result = command_map_set(result, "name", name_raw) }
        return result
    }
    if str_starts_with(trimmed, "/") {
        let rest = safe_substring(trimmed, 1, len(trimmed))
        let parts = str_split(rest, " ")
        if len(parts) > 0 {
            let cmd = str_to_lower(parts[0])
            result = command_map_set(result, "cmd", cmd)
            if cmd == CMD_JOIN() && len(parts) > 1 { result = command_map_set(result, "room", parts[1]) }
            if cmd == CMD_MSG() && len(parts) > 1 {
                let mut t = ""
                let mut pi = 1
                while pi < len(parts) {
                    if pi > 1 { t = t + " " }
                    t = t + parts[pi]
                    pi = pi + 1
                }
                result = command_map_set(result, "text", t)
            }
            if (cmd == CMD_PRIVATE() || cmd == "priv" || cmd == "tell" || cmd == "whisper") && len(parts) > 2 {
                result = command_map_set(result, "to", parts[1])
                let mut t = ""
                let mut pi = 2
                while pi < len(parts) {
                    if pi > 2 { t = t + " " }
                    t = t + parts[pi]
                    pi = pi + 1
                }
                result = command_map_set(result, "text", t)
            }
            if cmd == CMD_NICK() && len(parts) > 1 { result = command_map_set(result, "name", parts[1]) }
            if cmd == CMD_CREATE() && len(parts) > 1 { result = command_map_set(result, "room", parts[1]) }
            if cmd == CMD_KICK() && len(parts) > 1 { result = command_map_set(result, "name", parts[1]) }
            if cmd == CMD_MOTD() && len(parts) > 1 {
                let mut t = ""
                let mut pi = 1
                while pi < len(parts) {
                    if pi > 1 { t = t + " " }
                    t = t + parts[pi]
                    pi = pi + 1
                }
                result = command_map_set(result, "text", t)
            }
        }
    } else if str_starts_with(trimmed, "@") {
        let rest = safe_substring(trimmed, 1, len(trimmed))
        let parts = str_split(rest, " ")
        if len(parts) > 1 {
            result = command_map_set(result, "cmd", CMD_PRIVATE())
            result = command_map_set(result, "to", parts[0])
            let mut t = ""
            let mut pi = 1
            while pi < len(parts) {
                if pi > 1 { t = t + " " }
                t = t + parts[pi]
                pi = pi + 1
            }
            result = command_map_set(result, "text", t)
        }
    } else {
        if len(trimmed) > 0 {
            result = command_map_set(result, "cmd", CMD_MSG())
            result = command_map_set(result, "text", trimmed)
        }
    }
    result
}

func take_record_result(result: Result<Record, i32>) -> (Option<Record>, bool, i32) {
    match result {
        Ok(root) => (Some(root), false, 0),
        Err(status) => (None, true, status)
    }
}

func take_string_result(result: Result<string, i32>) -> (Option<string>, bool, i32) {
    match result {
        Ok(value) => (Some(value), false, 0),
        Err(status) => (None, true, status)
    }
}

func take_unit_result(result: Result<(), i32>) -> (bool, i32) {
    match result {
        Ok(()) => (false, 0),
        Err(status) => (true, status)
    }
}

func parse_client_command_or_exit(line: string) -> Record {
    let (maybe_command, failed, status) = take_record_result(parse_client_command(line))
    if failed {
        println("Command map allocation failed with status " + to_string(status))
        exit(status)
    }
    maybe_command.unwrap()
}

func parse_client_command_for_connection(line: string, fd: i64) -> Option<Record> {
    match parse_client_command(line) {
        Ok(command) => Some(command),
        Err(status) => {
            let ts = now_ms()
            let _ = send(fd, encode_error_msg(map_status_message(status), ts))
            None
        }
    }
}

func cmd_get_string(cmd: Record, key: string, default_val: string) -> string {
    let (found, val) = map_get(cmd, key)
    if found { to_string(val) } else { default_val }
}

func cmd_is(cmd: Record, expected: string) -> bool {
    let (found, val) = map_get(cmd, "cmd")
    found && to_string(val) == expected
}

func is_valid_nick(nick: string) -> bool {
    let l = len(nick)
    if l < 2 || l > 16 { return false }
    if nick == SERVER_NICK() || nick == SYSTEM_NICK() { return false }
    let mut ok = true
    let mut i = 0
    while i < l {
        let ch = str_char_at(nick, i)
        if !regex_match(ch, "^[a-zA-Z0-9_]$") { ok = false }
        i = i + 1
    }
    ok
}

func is_valid_room_name(name: string) -> bool {
    let l = len(name)
    if l < 1 || l > 32 { return false }
    regex_match(name, "^[a-zA-Z0-9_-]+$")
}

func make_user_info_json(nick: string, fd: i64, joined_at: i64, room: string) -> Result<string, i32> {
    let mut info = match map_new() {
        Ok(root) => Ok(root),
        Err(status) => Err(status)
    }
    info = command_map_set(info, "nick", nick)
    info = command_map_set(info, "fd", fd)
    info = command_map_set(info, "joined_at", joined_at)
    info = command_map_set(info, "room", room)
    match info {
        Ok(root) => {
            let json = to_json(root)
            drop(root)
            Ok(json)
        }
        Err(status) => Err(status)
    }
}

func make_room_meta_json(name: string, created_at: i64, topic: string, motd: string, include_motd: bool) -> Result<string, i32> {
    let mut meta = match map_new() {
        Ok(root) => Ok(root),
        Err(status) => Err(status)
    }
    meta = command_map_set(meta, "name", name)
    meta = command_map_set(meta, "created_at", created_at)
    meta = command_map_set(meta, "topic", topic)
    if include_motd { meta = command_map_set(meta, "motd", motd) }
    match meta {
        Ok(root) => {
            let json = to_json(root)
            drop(root)
            Ok(json)
        }
        Err(status) => Err(status)
    }
}

func new_user_maps() -> Result<(Record, Record, Record), i32> {
    match map_new() {
        Ok(users) => match map_new() {
            Ok(nicks) => match map_new() {
                Ok(user_info) => Ok((users, nicks, user_info)),
                Err(status) => { drop(users); drop(nicks); Err(status) }
            }
            Err(status) => { drop(users); Err(status) }
        }
        Err(status) => Err(status)
    }
}

func new_room_maps() -> Result<(Record, Record), i32> {
    match map_new() {
        Ok(rooms) => match map_new() {
            Ok(room_meta) => Ok((rooms, room_meta)),
            Err(status) => { drop(rooms); Err(status) }
        }
        Err(status) => Err(status)
    }
}

// ═══════════════════════════════════════════════════════════════════════════════
// Section 4: User Manager Actor
// ═══════════════════════════════════════════════════════════════════════════════

flow UserManagerFlow {
    // The mailbox owns one persistent Flow value. Actor handles carry no
    // mutable business fields; the operation result travels in the returned
    // snapshot so the existing handler API can stay result-shaped.
    state UserManagerLive {
        initialized: bool,
        history_initialized: bool,
        users: Option<Record>,
        nicks: Option<Record>,
        user_info: Option<Record>,
        nick_count: i32,
        msg_history: List<string>,
        max_history: i32,
        last_status: i32,
        last_message: string,
        last_text: string,
        last_number: i64,
        last_flag: bool,
        last_strings: List<string>,
    }

    transition init(UserManagerLive) -> UserManagerLive {
        if self.initialized {
            return user_manager_live(self.initialized, self.history_initialized,
                self.users, self.nicks, self.user_info, self.nick_count,
                self.msg_history, self.max_history, 0, "", "", 0 as i64, false, [])
        }
        match new_user_maps() {
            Ok((users, nicks, user_info)) => {
                let history = if self.history_initialized { self.msg_history } else { [] }
                let history_limit = if self.history_initialized { self.max_history } else { 1000 }
                return user_manager_live(true, true, Some(users), Some(nicks), Some(user_info),
                    0, history, history_limit, 0, "", "", 0 as i64, false, [])
            }
            Err(status) => return user_manager_live(false, self.history_initialized,
                self.users, self.nicks, self.user_info, self.nick_count,
                self.msg_history, self.max_history, status, "", "", 0 as i64, false, [])
        }
    }

    transition push_history(UserManagerLive, msg_json: string) -> UserManagerLive {
        let src = self.msg_history
        let mut new_h: List<string> = []
        for x in src { push(new_h, x) }
        push(new_h, msg_json)
        let (history, limit) = if len(new_h) > self.max_history {
            let mut trimmed: List<string> = []
            let mut i = len(new_h) - self.max_history
            while i < len(new_h) {
                push(trimmed, new_h[i])
                i = i + 1
            }
            (trimmed, self.max_history)
        } else { (new_h, self.max_history) }
        return user_manager_live(self.initialized, true, self.users, self.nicks,
            self.user_info, self.nick_count, history, limit, 0, "", "", 0 as i64, false, [])
    }

    transition get_history(UserManagerLive, count: i32) -> UserManagerLive {
        let src = self.msg_history
        let total = len(src)
        let start = if count >= total { 0 } else { total - count }
        let mut result: List<string> = []
        let mut i = start
        while i < total {
            push(result, src[i])
            i = i + 1
        }
        return user_manager_live(self.initialized, self.history_initialized,
            self.users, self.nicks, self.user_info, self.nick_count,
            self.msg_history, self.max_history, 0, "", "", 0 as i64, false, result)
    }

    transition register(UserManagerLive, nick: string, fd: i64) -> UserManagerLive {
        let nick_lower = str_to_lower(nick)
        let (exists, _) = map_get(self.nicks.unwrap(), nick_lower)
        if exists {
            return user_manager_live(self.initialized, self.history_initialized,
                self.users, self.nicks, self.user_info, self.nick_count, self.msg_history,
                self.max_history, 0, "nick "" + nick + "" is already taken", "", 0 as i64, false, [])
        }
        let fd_str = to_string(fd)
        let (fd_exists, _) = map_get(self.users.unwrap(), fd_str)
        if fd_exists {
            return user_manager_live(self.initialized, self.history_initialized,
                self.users, self.nicks, self.user_info, self.nick_count, self.msg_history,
                self.max_history, 0, "connection already registered", "", 0 as i64, false, [])
        }
        let ts = now_ms()
        let (maybe_info_json, info_failed, info_status) = take_string_result(make_user_info_json(nick, fd, ts, "lobby"))
        if info_failed {
            return user_manager_live(self.initialized, self.history_initialized,
                self.users, self.nicks, self.user_info, self.nick_count, self.msg_history,
                self.max_history, info_status, "", "", 0 as i64, false, [])
        }
        let info_json = maybe_info_json.unwrap()
        let (maybe_new_users, users_failed, users_status) = match map_set(self.users.unwrap(), fd_str, nick) {
            Ok(updated) => (Some(updated), false, 0),
            Err(status) => (None, true, status)
        }
        if users_failed {
            return user_manager_live(self.initialized, self.history_initialized,
                self.users, self.nicks, self.user_info, self.nick_count, self.msg_history,
                self.max_history, users_status, "", "", 0 as i64, false, [])
        }
        let new_users = maybe_new_users.unwrap()
        let (maybe_new_nicks, nicks_failed, nicks_status) = match map_set(self.nicks.unwrap(), nick_lower, fd_str) {
            Ok(updated) => (Some(updated), false, 0),
            Err(status) => (None, true, status)
        }
        if nicks_failed {
            drop(new_users)
            return user_manager_live(self.initialized, self.history_initialized,
                self.users, self.nicks, self.user_info, self.nick_count, self.msg_history,
                self.max_history, nicks_status, "", "", 0 as i64, false, [])
        }
        let new_nicks = maybe_new_nicks.unwrap()
        let (maybe_new_user_info, info_map_failed, info_map_status) = match map_set(self.user_info.unwrap(), nick_lower, info_json) {
            Ok(updated) => (Some(updated), false, 0),
            Err(status) => (None, true, status)
        }
        if info_map_failed {
            drop(new_users)
            drop(new_nicks)
            return user_manager_live(self.initialized, self.history_initialized,
                self.users, self.nicks, self.user_info, self.nick_count, self.msg_history,
                self.max_history, info_map_status, "", "", 0 as i64, false, [])
        }
        let new_user_info = maybe_new_user_info.unwrap()
        drop(self.users.unwrap())
        drop(self.nicks.unwrap())
        drop(self.user_info.unwrap())
        return user_manager_live(self.initialized, self.history_initialized,
            Some(new_users), Some(new_nicks), Some(new_user_info), self.nick_count + 1,
            self.msg_history, self.max_history, 0, "ok", "", 0 as i64, false, [])
    }

    transition unregister(UserManagerLive, fd: i64) -> UserManagerLive {
        let fd_str = to_string(fd)
        let (found, nick_val) = map_get(self.users.unwrap(), fd_str)
        if !found {
            return user_manager_live(self.initialized, self.history_initialized,
                self.users, self.nicks, self.user_info, self.nick_count, self.msg_history,
                self.max_history, 0, "", "not found", 0 as i64, false, [])
        }
        let nick = to_string(nick_val)
        let nick_lower = str_to_lower(nick)
        let new_nicks = map_remove(self.nicks.unwrap(), nick_lower)
        let new_user_info = map_remove(self.user_info.unwrap(), nick_lower)
        let new_users = map_remove(self.users.unwrap(), fd_str)
        drop(self.nicks.unwrap())
        drop(self.user_info.unwrap())
        drop(self.users.unwrap())
        let next_count = if self.nick_count > 0 { self.nick_count - 1 } else { self.nick_count }
        return user_manager_live(self.initialized, self.history_initialized,
            Some(new_users), Some(new_nicks), Some(new_user_info), next_count,
            self.msg_history, self.max_history, 0, "", nick, 0 as i64, false, [])
    }

    transition change_nick(UserManagerLive, fd: i64, new_nick: string) -> UserManagerLive {
        let fd_str = to_string(fd)
        let (found, old_val) = map_get(self.users.unwrap(), fd_str)
        if !found {
            return user_manager_live(self.initialized, self.history_initialized,
                self.users, self.nicks, self.user_info, self.nick_count, self.msg_history,
                self.max_history, 0, "connection not registered", "", 0 as i64, false, [])
        }
        let old_nick = to_string(old_val)
        let old_lower = str_to_lower(old_nick)
        let new_lower = str_to_lower(new_nick)
        let (exists, _) = map_get(self.nicks.unwrap(), new_lower)
        if exists {
            return user_manager_live(self.initialized, self.history_initialized,
                self.users, self.nicks, self.user_info, self.nick_count, self.msg_history,
                self.max_history, 0, "nick "" + new_nick + "" is already taken", "", 0 as i64, false, [])
        }
        let nicks_without_old = map_remove(self.nicks.unwrap(), old_lower)
        let (maybe_new_nicks, nicks_failed, nicks_status) = match map_set(nicks_without_old, new_lower, fd_str) {
            Ok(updated) => (Some(updated), false, 0),
            Err(status) => (None, true, status)
        }
        drop(nicks_without_old)
        if nicks_failed {
            return user_manager_live(self.initialized, self.history_initialized,
                self.users, self.nicks, self.user_info, self.nick_count, self.msg_history,
                self.max_history, nicks_status, "", "", 0 as i64, false, [])
        }
        let new_nicks = maybe_new_nicks.unwrap()
        let (maybe_new_users, users_failed, users_status) = match map_set(self.users.unwrap(), fd_str, new_nick) {
            Ok(updated) => (Some(updated), false, 0),
            Err(status) => (None, true, status)
        }
        if users_failed {
            drop(new_nicks)
            return user_manager_live(self.initialized, self.history_initialized,
                self.users, self.nicks, self.user_info, self.nick_count, self.msg_history,
                self.max_history, users_status, "", "", 0 as i64, false, [])
        }
        let new_users = maybe_new_users.unwrap()
        let (found_info, _) = map_get(self.user_info.unwrap(), old_lower)
        if found_info {
            let ts = now_ms()
            let (maybe_info_json, info_failed, info_status) = take_string_result(make_user_info_json(new_nick, fd, ts, "lobby"))
            if info_failed {
                drop(new_nicks)
                drop(new_users)
                return user_manager_live(self.initialized, self.history_initialized,
                    self.users, self.nicks, self.user_info, self.nick_count, self.msg_history,
                    self.max_history, info_status, "", "", 0 as i64, false, [])
            }
            let info_json = maybe_info_json.unwrap()
            let info_without_old = map_remove(self.user_info.unwrap(), old_lower)
            let (maybe_new_user_info, info_map_failed, info_map_status) = match map_set(info_without_old, new_lower, info_json) {
                Ok(updated) => (Some(updated), false, 0),
                Err(status) => (None, true, status)
            }
            drop(info_without_old)
            if info_map_failed {
                drop(new_nicks)
                drop(new_users)
                return user_manager_live(self.initialized, self.history_initialized,
                    self.users, self.nicks, self.user_info, self.nick_count, self.msg_history,
                    self.max_history, info_map_status, "", "", 0 as i64, false, [])
            }
            let new_user_info = maybe_new_user_info.unwrap()
            drop(self.user_info.unwrap())
            drop(self.nicks.unwrap())
            drop(self.users.unwrap())
            return user_manager_live(self.initialized, self.history_initialized,
                Some(new_users), Some(new_nicks), Some(new_user_info), self.nick_count,
                self.msg_history, self.max_history, 0, old_nick, "", 0 as i64, false, [])
        }
        drop(self.nicks.unwrap())
        drop(self.users.unwrap())
        return user_manager_live(self.initialized, self.history_initialized,
            Some(new_users), Some(new_nicks), self.user_info, self.nick_count,
            self.msg_history, self.max_history, 0, old_nick, "", 0 as i64, false, [])
    }

    transition get_nick(UserManagerLive, fd: i64) -> UserManagerLive {
        let fd_str = to_string(fd)
        let (found, val) = map_get(self.users.unwrap(), fd_str)
        let text = if found { to_string(val) } else { "" }
        return user_manager_live(self.initialized, self.history_initialized,
            self.users, self.nicks, self.user_info, self.nick_count, self.msg_history,
            self.max_history, 0, "", text, 0 as i64, false, [])
    }

    transition get_fd(UserManagerLive, nick: string) -> UserManagerLive {
        let nick_lower = str_to_lower(nick)
        let (found, val) = map_get(self.nicks.unwrap(), nick_lower)
        let fd = if found {
            let fd_str = to_string(val)
            let (ok_parse, parsed) = str_parse_int(fd_str)
            if ok_parse { parsed as i64 } else { -1 as i64 }
        } else { -1 as i64 }
        return user_manager_live(self.initialized, self.history_initialized,
            self.users, self.nicks, self.user_info, self.nick_count, self.msg_history,
            self.max_history, 0, "", "", fd, false, [])
    }

    transition nick_exists(UserManagerLive, nick: string) -> UserManagerLive {
        let nick_lower = str_to_lower(nick)
        let (exists, _) = map_get(self.nicks.unwrap(), nick_lower)
        return user_manager_live(self.initialized, self.history_initialized,
            self.users, self.nicks, self.user_info, self.nick_count, self.msg_history,
            self.max_history, 0, "", "", 0 as i64, exists, [])
    }

    transition list_nicks(UserManagerLive) -> UserManagerLive {
        let mut nick_list: List<string> = []
        let u = self.users.unwrap()
        let k = keys(u)
        for fd_str in k {
            let (_, nick_val) = map_get(self.users.unwrap(), fd_str)
            push(nick_list, to_string(nick_val))
        }
        return user_manager_live(self.initialized, self.history_initialized,
            self.users, self.nicks, self.user_info, self.nick_count, self.msg_history,
            self.max_history, 0, "", "", 0 as i64, false, nick_list)
    }

    transition count(UserManagerLive) -> UserManagerLive {
        return user_manager_live(self.initialized, self.history_initialized,
            self.users, self.nicks, self.user_info, self.nick_count, self.msg_history,
            self.max_history, 0, "", "", self.nick_count as i64, false, [])
    }

    transition set_room(UserManagerLive, nick: string, room: string) -> UserManagerLive {
        let nick_lower = str_to_lower(nick)
        let (found, info_val) = map_get(self.user_info.unwrap(), nick_lower)
        if !found {
            return user_manager_live(self.initialized, self.history_initialized,
                self.users, self.nicks, self.user_info, self.nick_count, self.msg_history,
                self.max_history, 0, "", "", 0 as i64, false, [])
        }
        let info_str = to_string(info_val)
        let fd_val = json_get_int(info_str, "fd") as i64
        let ts = now_ms()
        let (maybe_info_json, info_failed, info_status) = take_string_result(make_user_info_json(nick, fd_val, ts, room))
        if info_failed {
            return user_manager_live(self.initialized, self.history_initialized,
                self.users, self.nicks, self.user_info, self.nick_count, self.msg_history,
                self.max_history, info_status, "", "", 0 as i64, false, [])
        }
        let info_json = maybe_info_json.unwrap()
        let (maybe_updated, set_failed, set_status) = match map_set(self.user_info.unwrap(), nick_lower, info_json) {
            Ok(updated) => (Some(updated), false, 0),
            Err(status) => (None, true, status)
        }
        if set_failed {
            return user_manager_live(self.initialized, self.history_initialized,
                self.users, self.nicks, self.user_info, self.nick_count, self.msg_history,
                self.max_history, set_status, "", "", 0 as i64, false, [])
        }
        let updated = maybe_updated.unwrap()
        drop(self.user_info.unwrap())
        return user_manager_live(self.initialized, self.history_initialized,
            self.users, self.nicks, Some(updated), self.nick_count, self.msg_history,
            self.max_history, 0, "", "", 0 as i64, false, [])
    }

    transition get_room(UserManagerLive, nick: string) -> UserManagerLive {
        let nick_lower = str_to_lower(nick)
        let (found, info_val) = map_get(self.user_info.unwrap(), nick_lower)
        let text = if found {
            let info_str = to_string(info_val)
            json_get_string(info_str, "room")
        } else { "" }
        return user_manager_live(self.initialized, self.history_initialized,
            self.users, self.nicks, self.user_info, self.nick_count, self.msg_history,
            self.max_history, 0, "", text, 0 as i64, false, [])
    }

    transition clear(UserManagerLive) -> UserManagerLive {
        match new_user_maps() {
            Ok((users, nicks, user_info)) => {
                if self.initialized {
                    drop(self.users.unwrap())
                    drop(self.nicks.unwrap())
                    drop(self.user_info.unwrap())
                }
                let history = if self.history_initialized { self.msg_history } else { [] }
                let limit = if self.history_initialized { self.max_history } else { 1000 }
                return user_manager_live(true, true, Some(users), Some(nicks), Some(user_info),
                    0, history, limit, 0, "", "", 0 as i64, false, [])
            }
            Err(status) => return user_manager_live(self.initialized, self.history_initialized,
                self.users, self.nicks, self.user_info, self.nick_count, self.msg_history,
                self.max_history, status, "", "", 0 as i64, false, [])
        }
    }

    transition release_maps(UserManagerLive) -> UserManagerLive {
        if self.initialized {
            drop(self.users.unwrap())
            drop(self.nicks.unwrap())
            drop(self.user_info.unwrap())
        }
        let history = if self.history_initialized { self.msg_history } else { [] }
        let limit = if self.history_initialized { self.max_history } else { 1000 }
        return user_manager_live(false, true, None, None, None, 0, history, limit,
            0, "", "", 0 as i64, false, [])
    }
}

actor UserManager runs UserManagerFlow {}

func user_manager_live(initialized: bool, history_initialized: bool,
    users: Option<Record>, nicks: Option<Record>, user_info: Option<Record>,
    nick_count: i32, msg_history: List<string>, max_history: i32,
    last_status: i32, last_message: string, last_text: string,
    last_number: i64, last_flag: bool, last_strings: List<string>) -> UserManagerLive {
    UserManagerLive {
        initialized: initialized,
        history_initialized: history_initialized,
        users: users,
        nicks: nicks,
        user_info: user_info,
        nick_count: nick_count,
        msg_history: msg_history,
        max_history: max_history,
        last_status: last_status,
        last_message: last_message,
        last_text: last_text,
        last_number: last_number,
        last_flag: last_flag,
        last_strings: last_strings,
    }
}

func user_manager_init(manager: UserManager) -> Result<(), i32> {
    let state = manager.init()
    if state.last_status == 0 { Ok(()) } else { Err(state.last_status) }
}
func user_manager_push_history(manager: UserManager, msg: string) -> UserManagerLive { manager.push_history(msg) }
func user_manager_get_history(manager: UserManager, count: i32) -> List<string> { manager.get_history(count).last_strings }
func user_manager_register(manager: UserManager, nick: string, fd: i64) -> Result<string, i32> {
    let state = manager.register(nick, fd)
    if state.last_status == 0 { Ok(state.last_message) } else { Err(state.last_status) }
}
func user_manager_unregister(manager: UserManager, fd: i64) -> string { manager.unregister(fd).last_text }
func user_manager_change_nick(manager: UserManager, fd: i64, nick: string) -> Result<string, i32> {
    let state = manager.change_nick(fd, nick)
    if state.last_status == 0 { Ok(state.last_message) } else { Err(state.last_status) }
}
func user_manager_get_nick(manager: UserManager, fd: i64) -> string { manager.get_nick(fd).last_text }
func user_manager_get_fd(manager: UserManager, nick: string) -> i64 { manager.get_fd(nick).last_number }
func user_manager_nick_exists(manager: UserManager, nick: string) -> bool { manager.nick_exists(nick).last_flag }
func user_manager_list_nicks(manager: UserManager) -> List<string> { manager.list_nicks().last_strings }
func user_manager_count(manager: UserManager) -> i32 { manager.count().last_number as i32 }
func user_manager_set_room(manager: UserManager, nick: string, room: string) -> Result<(), i32> {
    let state = manager.set_room(nick, room)
    if state.last_status == 0 { Ok(()) } else { Err(state.last_status) }
}
func user_manager_get_room(manager: UserManager, nick: string) -> string { manager.get_room(nick).last_text }
func user_manager_clear(manager: UserManager) -> Result<(), i32> {
    let state = manager.clear()
    if state.last_status == 0 { Ok(()) } else { Err(state.last_status) }
}
func user_manager_release_maps(manager: UserManager) { let _ = manager.release_maps() }

flow RoomManagerFlow {
    state RoomManagerLive {
        initialized: bool,
        rooms: Option<Record>,
        room_meta: Option<Record>,
        room_count: i32,
        last_status: i32,
        last_message: string,
        last_text: string,
        last_number: i64,
        last_flag: bool,
        last_strings: List<string>,
    }

    transition init(RoomManagerLive) -> RoomManagerLive {
        if self.initialized {
            return room_manager_live(self.initialized, self.rooms, self.room_meta, self.room_count,
                0, "", "", 0 as i64, false, [])
        }
        match new_room_maps() {
            Ok((rooms, room_meta)) => return room_manager_live(true, Some(rooms), Some(room_meta), 0,
                0, "", "", 0 as i64, false, []),
            Err(status) => return room_manager_live(false, self.rooms, self.room_meta, self.room_count,
                status, "", "", 0 as i64, false, [])
        }
    }

    transition create(RoomManagerLive, name: string) -> RoomManagerLive {
        if len(name) < 1 {
            return room_manager_live(self.initialized, self.rooms, self.room_meta, self.room_count,
                0, "invalid room name: must be 1-32 chars, alphanumeric/hyphen", "", 0 as i64, false, [])
        }
        let (exists, _) = map_get(self.rooms.unwrap(), name)
        if exists {
            return room_manager_live(self.initialized, self.rooms, self.room_meta, self.room_count,
                0, "room "" + name + "" already exists", "", 0 as i64, false, [])
        }
        let ts = now_ms()
        let (maybe_meta, meta_failed, meta_status) = take_string_result(make_room_meta_json(name, ts, "", "", false))
        if meta_failed {
            return room_manager_live(self.initialized, self.rooms, self.room_meta, self.room_count,
                meta_status, "", "", 0 as i64, false, [])
        }
        let meta = maybe_meta.unwrap()
        let (maybe_new_rooms, rooms_failed, rooms_status) = match map_set(self.rooms.unwrap(), name, to_json([])) {
            Ok(updated) => (Some(updated), false, 0),
            Err(status) => (None, true, status)
        }
        if rooms_failed {
            return room_manager_live(self.initialized, self.rooms, self.room_meta, self.room_count,
                rooms_status, "", "", 0 as i64, false, [])
        }
        let new_rooms = maybe_new_rooms.unwrap()
        let (maybe_new_room_meta, meta_map_failed, meta_map_status) = match map_set(self.room_meta.unwrap(), name, meta) {
            Ok(updated) => (Some(updated), false, 0),
            Err(status) => (None, true, status)
        }
        if meta_map_failed {
            drop(new_rooms)
            return room_manager_live(self.initialized, self.rooms, self.room_meta, self.room_count,
                meta_map_status, "", "", 0 as i64, false, [])
        }
        let new_room_meta = maybe_new_room_meta.unwrap()
        drop(self.rooms.unwrap())
        drop(self.room_meta.unwrap())
        return room_manager_live(self.initialized, Some(new_rooms), Some(new_room_meta), self.room_count + 1,
            0, "ok", "", 0 as i64, false, [])
    }

    transition join(RoomManagerLive, room: string, nick: string) -> RoomManagerLive {
        let (exists, members_val) = map_get(self.rooms.unwrap(), room)
        if !exists {
            return room_manager_live(self.initialized, self.rooms, self.room_meta, self.room_count,
                0, "room "" + room + "" does not exist", "", 0 as i64, false, [])
        }
        let members_str = to_string(members_val)
        let mut parsed = from_json::<List<string>>(members_str)
        let mut already = false
        for x in parsed { if x == nick { already = true } }
        if already {
            return room_manager_live(self.initialized, self.rooms, self.room_meta, self.room_count,
                0, "already in room", "", 0 as i64, false, [])
        }
        push(parsed, nick)
        match map_set(self.rooms.unwrap(), room, to_json(parsed)) {
            Ok(updated) => {
                drop(self.rooms.unwrap())
                return room_manager_live(self.initialized, Some(updated), self.room_meta, self.room_count,
                    0, "ok", "", 0 as i64, false, [])
            }
            Err(status) => return room_manager_live(self.initialized, self.rooms, self.room_meta, self.room_count,
                status, "", "", 0 as i64, false, [])
        }
    }

    transition is_member(RoomManagerLive, room: string, nick: string) -> RoomManagerLive {
        let (exists, members_val) = map_get(self.rooms.unwrap(), room)
        if !exists {
            return room_manager_live(self.initialized, self.rooms, self.room_meta, self.room_count,
                0, "", "", 0 as i64, false, [])
        }
        let members_str = to_string(members_val)
        let parsed = from_json::<List<string>>(members_str)
        let mut found_member = false
        for x in parsed { if x == nick { found_member = true } }
        return room_manager_live(self.initialized, self.rooms, self.room_meta, self.room_count,
            0, "", "", 0 as i64, found_member, [])
    }

    transition leave(RoomManagerLive, room: string, nick: string) -> RoomManagerLive {
        let (exists, members_val) = map_get(self.rooms.unwrap(), room)
        if !exists {
            return room_manager_live(self.initialized, self.rooms, self.room_meta, self.room_count,
                0, "room does not exist", "", 0 as i64, false, [])
        }
        let members_str = to_string(members_val)
        let parsed = from_json::<List<string>>(members_str)
        let mut new_members: List<string> = []
        for x in parsed { if x != nick { push(new_members, x) } }
        match map_set(self.rooms.unwrap(), room, to_json(new_members)) {
            Ok(updated) => {
                drop(self.rooms.unwrap())
                return room_manager_live(self.initialized, Some(updated), self.room_meta, self.room_count,
                    0, "ok", "", 0 as i64, false, [])
            }
            Err(status) => return room_manager_live(self.initialized, self.rooms, self.room_meta, self.room_count,
                status, "", "", 0 as i64, false, [])
        }
    }

    transition remove_from_all(RoomManagerLive, nick: string) -> RoomManagerLive {
        let (maybe_staged, clone_failed, clone_status) = match map_clone(self.rooms.unwrap()) {
            Ok(root) => (Some(root), false, 0),
            Err(status) => (None, true, status)
        }
        if clone_failed {
            return room_manager_live(self.initialized, self.rooms, self.room_meta, self.room_count,
                clone_status, "", "", 0 as i64, false, [])
        }
        let mut staged = maybe_staged.unwrap()
        let room_names = keys(staged)
        for rn in room_names {
            let (_, members_val) = map_get(staged, rn)
            let members_str = to_string(members_val)
            let parsed = from_json::<List<string>>(members_str)
            let mut members: List<string> = []
            for x in parsed { push(members, x) }
            let mut found = false
            for x in members { if x == nick { found = true } }
            if found {
                let mut new_members: List<string> = []
                for x in members { if x != nick { push(new_members, x) } }
                match map_set(staged, rn, to_json(new_members)) {
                    Ok(updated) => { drop(staged); staged = updated }
                    Err(status) => {
                        drop(staged)
                        return room_manager_live(self.initialized, self.rooms, self.room_meta, self.room_count,
                            status, "", "", 0 as i64, false, [])
                    }
                }
            }
        }
        drop(self.rooms.unwrap())
        return room_manager_live(self.initialized, Some(staged), self.room_meta, self.room_count,
            0, "", "", 0 as i64, false, [])
    }

    transition get_members(RoomManagerLive, room: string) -> RoomManagerLive {
        let (exists, members_val) = map_get(self.rooms.unwrap(), room)
        let members = if exists { members_from_json(to_string(members_val)) } else { [] }
        return room_manager_live(self.initialized, self.rooms, self.room_meta, self.room_count,
            0, "", "", 0 as i64, false, members)
    }

    transition list_rooms(RoomManagerLive) -> RoomManagerLive {
        let r = self.rooms.unwrap()
        return room_manager_live(self.initialized, self.rooms, self.room_meta, self.room_count,
            0, "", "", 0 as i64, false, keys(r))
    }

    transition member_count(RoomManagerLive, room: string) -> RoomManagerLive {
        let (exists, members_val) = map_get(self.rooms.unwrap(), room)
        let count = if exists { len(members_from_json(to_string(members_val))) } else { 0 }
        return room_manager_live(self.initialized, self.rooms, self.room_meta, self.room_count,
            0, "", "", count as i64, false, [])
    }

    transition set_topic(RoomManagerLive, room: string, topic: string) -> RoomManagerLive {
        let (exists, meta_val) = map_get(self.room_meta.unwrap(), room)
        if !exists {
            return room_manager_live(self.initialized, self.rooms, self.room_meta, self.room_count,
                0, "room does not exist", "", 0 as i64, false, [])
        }
        let meta_str = to_string(meta_val)
        let name = json_get_string(meta_str, "name")
        let created = json_get_int(meta_str, "created_at")
        let (maybe_new_meta, build_failed, build_status) = take_string_result(make_room_meta_json(name, created, topic, json_get_string(meta_str, "motd"), str_contains(meta_str, ""motd"")))
        if build_failed {
            return room_manager_live(self.initialized, self.rooms, self.room_meta, self.room_count,
                build_status, "", "", 0 as i64, false, [])
        }
        let new_meta = maybe_new_meta.unwrap()
        let (maybe_updated, set_failed, set_status) = match map_set(self.room_meta.unwrap(), room, new_meta) {
            Ok(updated) => (Some(updated), false, 0),
            Err(status) => (None, true, status)
        }
        if set_failed {
            return room_manager_live(self.initialized, self.rooms, self.room_meta, self.room_count,
                set_status, "", "", 0 as i64, false, [])
        }
        let updated = maybe_updated.unwrap()
        drop(self.room_meta.unwrap())
        return room_manager_live(self.initialized, self.rooms, Some(updated), self.room_count,
            0, "ok", "", 0 as i64, false, [])
    }

    transition get_topic(RoomManagerLive, room: string) -> RoomManagerLive {
        let (exists, meta_val) = map_get(self.room_meta.unwrap(), room)
        let text = if exists { json_get_string(to_string(meta_val), "topic") } else { "" }
        return room_manager_live(self.initialized, self.rooms, self.room_meta, self.room_count,
            0, "", text, 0 as i64, false, [])
    }

    transition set_motd(RoomManagerLive, room: string, motd: string) -> RoomManagerLive {
        let (exists, meta_val) = map_get(self.room_meta.unwrap(), room)
        if !exists {
            return room_manager_live(self.initialized, self.rooms, self.room_meta, self.room_count,
                0, "room does not exist", "", 0 as i64, false, [])
        }
        let meta_str = to_string(meta_val)
        let name = json_get_string(meta_str, "name")
        let created = json_get_int(meta_str, "created_at")
        let current_topic = json_get_string(meta_str, "topic")
        let (maybe_new_meta, build_failed, build_status) = take_string_result(make_room_meta_json(name, created, current_topic, motd, true))
        if build_failed {
            return room_manager_live(self.initialized, self.rooms, self.room_meta, self.room_count,
                build_status, "", "", 0 as i64, false, [])
        }
        let new_meta = maybe_new_meta.unwrap()
        let (maybe_updated, set_failed, set_status) = match map_set(self.room_meta.unwrap(), room, new_meta) {
            Ok(updated) => (Some(updated), false, 0),
            Err(status) => (None, true, status)
        }
        if set_failed {
            return room_manager_live(self.initialized, self.rooms, self.room_meta, self.room_count,
                set_status, "", "", 0 as i64, false, [])
        }
        let updated = maybe_updated.unwrap()
        drop(self.room_meta.unwrap())
        return room_manager_live(self.initialized, self.rooms, Some(updated), self.room_count,
            0, "ok", "", 0 as i64, false, [])
    }

    transition get_motd(RoomManagerLive, room: string) -> RoomManagerLive {
        let (exists, meta_val) = map_get(self.room_meta.unwrap(), room)
        let text = if exists { json_get_string(to_string(meta_val), "motd") } else { "" }
        return room_manager_live(self.initialized, self.rooms, self.room_meta, self.room_count,
            0, "", text, 0 as i64, false, [])
    }

    transition clear(RoomManagerLive) -> RoomManagerLive {
        match new_room_maps() {
            Ok((rooms, room_meta)) => {
                if self.initialized {
                    drop(self.rooms.unwrap())
                    drop(self.room_meta.unwrap())
                }
                return room_manager_live(true, Some(rooms), Some(room_meta), 0,
                    0, "", "", 0 as i64, false, [])
            }
            Err(status) => return room_manager_live(self.initialized, self.rooms, self.room_meta, self.room_count,
                status, "", "", 0 as i64, false, [])
        }
    }

    transition release_maps(RoomManagerLive) -> RoomManagerLive {
        if self.initialized {
            drop(self.rooms.unwrap())
            drop(self.room_meta.unwrap())
        }
        return room_manager_live(false, None, None, 0, 0, "", "", 0 as i64, false, [])
    }

    transition count(RoomManagerLive) -> RoomManagerLive {
        return room_manager_live(self.initialized, self.rooms, self.room_meta, self.room_count,
            0, "", "", self.room_count as i64, false, [])
    }
}

actor RoomManager runs RoomManagerFlow {}

func room_manager_live(initialized: bool, rooms: Option<Record>, room_meta: Option<Record>, room_count: i32,
    last_status: i32, last_message: string, last_text: string,
    last_number: i64, last_flag: bool, last_strings: List<string>) -> RoomManagerLive {
    RoomManagerLive {
        initialized: initialized,
        rooms: rooms,
        room_meta: room_meta,
        room_count: room_count,
        last_status: last_status,
        last_message: last_message,
        last_text: last_text,
        last_number: last_number,
        last_flag: last_flag,
        last_strings: last_strings,
    }
}

func room_manager_init(manager: RoomManager) -> Result<(), i32> {
    let state = manager.init()
    if state.last_status == 0 { Ok(()) } else { Err(state.last_status) }
}
func room_manager_create(manager: RoomManager, name: string) -> Result<string, i32> {
    let state = manager.create(name)
    if state.last_status == 0 { Ok(state.last_message) } else { Err(state.last_status) }
}
func room_manager_join(manager: RoomManager, room: string, nick: string) -> Result<string, i32> {
    let state = manager.join(room, nick)
    if state.last_status == 0 { Ok(state.last_message) } else { Err(state.last_status) }
}
func room_manager_is_member(manager: RoomManager, room: string, nick: string) -> bool { manager.is_member(room, nick).last_flag }
func room_manager_leave(manager: RoomManager, room: string, nick: string) -> Result<string, i32> {
    let state = manager.leave(room, nick)
    if state.last_status == 0 { Ok(state.last_message) } else { Err(state.last_status) }
}
func room_manager_remove_from_all(manager: RoomManager, nick: string) -> Result<(), i32> {
    let state = manager.remove_from_all(nick)
    if state.last_status == 0 { Ok(()) } else { Err(state.last_status) }
}
func room_manager_get_members(manager: RoomManager, room: string) -> List<string> { manager.get_members(room).last_strings }
func room_manager_list_rooms(manager: RoomManager) -> List<string> { manager.list_rooms().last_strings }
func room_manager_member_count(manager: RoomManager, room: string) -> i32 { manager.member_count(room).last_number as i32 }
func room_manager_set_topic(manager: RoomManager, room: string, topic: string) -> Result<string, i32> {
    let state = manager.set_topic(room, topic)
    if state.last_status == 0 { Ok(state.last_message) } else { Err(state.last_status) }
}
func room_manager_get_topic(manager: RoomManager, room: string) -> string { manager.get_topic(room).last_text }
func room_manager_set_motd(manager: RoomManager, room: string, motd: string) -> Result<string, i32> {
    let state = manager.set_motd(room, motd)
    if state.last_status == 0 { Ok(state.last_message) } else { Err(state.last_status) }
}
func room_manager_get_motd(manager: RoomManager, room: string) -> string { manager.get_motd(room).last_text }
func room_manager_clear(manager: RoomManager) -> Result<(), i32> {
    let state = manager.clear()
    if state.last_status == 0 { Ok(()) } else { Err(state.last_status) }
}
func room_manager_release_maps(manager: RoomManager) { let _ = manager.release_maps() }
func room_manager_count(manager: RoomManager) -> i32 { manager.count().last_number as i32 }

func map_status_message(status: i32) -> string {
    "map operation failed with status " + to_string(status)
}

func result_message(result: Result<string, i32>) -> string {
    match result {
        Ok(message) => message,
        Err(status) => map_status_message(status)
    }
}

func unit_result_message(result: Result<(), i32>) -> string {
    match result {
        Ok(()) => "",
        Err(status) => map_status_message(status)
    }
}

func initialized_user_manager_or_exit() -> UserManager {
    let manager = UserManager.spawn()
    let (failed, status) = take_unit_result(user_manager_init(manager))
    if failed {
        println("User manager initialization failed with status " + to_string(status))
        exit(status)
    }
    manager
}

func initialized_room_manager_or_exit() -> RoomManager {
    let manager = RoomManager.spawn()
    let (failed, status) = take_unit_result(room_manager_init(manager))
    if failed {
        println("Room manager initialization failed with status " + to_string(status))
        exit(status)
    }
    manager
}

func record_or_exit(result: Result<Record, i32>) -> Record {
    let (maybe_root, failed, status) = take_record_result(result)
    if failed {
        println("Map initialization failed with status " + to_string(status))
        exit(status)
    }
    maybe_root.unwrap()
}

func test_string_result(result: Result<string, i32>) -> string {
    let (maybe_value, failed, status) = take_string_result(result)
    if failed {
        println("Test map operation failed with status " + to_string(status))
        exit(status)
    }
    maybe_value.unwrap()
}

func test_unit_result(result: Result<(), i32>) {
    let (failed, status) = take_unit_result(result)
    if failed {
        println("Test map operation failed with status " + to_string(status))
        exit(status)
    }
}

// ═══════════════════════════════════════════════════════════════════════════════
// Section 6: Message Store — History Persistence
// ═══════════════════════════════════════════════════════════════════════════════

type MessageStore { buffer: List<string>, max_size: i32, file_path: string, saved_count: i32 }

func create_store(max_size: i32, file_path: string) -> MessageStore {
    let mut buf: List<string> = []
    if file_exists(file_path) {
        let rr = read_file(file_path)
        if rr.is_ok() {
            let content = rr.unwrap()
            if len(content) > 0 && json_is_valid(content) {
                buf = from_json::<List<string>>(content)
            }
        }
    }
    MessageStore { buffer: buf, max_size: max_size, file_path: file_path, saved_count: len(buf) }
}

func store_add(store: MessageStore, msg_json: string) -> MessageStore {
    let mut buf = store.buffer
    if len(buf) >= store.max_size {
        let mut new_buf: List<string> = []
        let mut i = 1
        while i < len(buf) {
            push(new_buf, buf[i])
            i = i + 1
        }
        buf = new_buf
    }
    push(buf, msg_json)
    MessageStore { buffer: buf, max_size: store.max_size, file_path: store.file_path, saved_count: store.saved_count }
}

func store_save(store: MessageStore) -> (bool, MessageStore) {
    let json = to_json(store.buffer)
    let wr = write_file(store.file_path, json)
    if wr.is_ok() {
        (true, MessageStore { buffer: store.buffer, max_size: store.max_size, file_path: store.file_path, saved_count: len(store.buffer) })
    } else {
        (false, store)
    }
}

func store_get_recent(store: MessageStore, count: i32) -> List<string> {
    let buf = store.buffer
    let total = len(buf)
    if count >= total { buf } else {
        let start = total - count
        let mut result: List<string> = []
        let mut i = start
        while i < total {
            push(result, buf[i])
            i = i + 1
        }
        result
    }
}

func store_get_by_room(store: MessageStore, room: string, max_count: i32) -> List<string> {
    let buf = store.buffer
    let mut matching: List<string> = []
    let mut i = len(buf) - 1
    while i >= 0 && len(matching) < max_count {
        let msg = buf[i]
        if json_is_valid(msg) {
            let msg_room = json_get_string(msg, "room")
            if msg_room == room || room == "" {
                push(matching, msg)
            }
        }
        i = i - 1
    }
    let mut result: List<string> = []
    let mut ri = len(matching) - 1
    while ri >= 0 {
        push(result, matching[ri])
        ri = ri - 1
    }
    result
}

// ═══════════════════════════════════════════════════════════════════════════════
// Section 7: Server — Command Handlers
// ═══════════════════════════════════════════════════════════════════════════════

func send_help(fd: i64) {
    let ts = now_ms()
    let help_text = "=== MimiChat Commands ===\n/msg <text>          Send message to current room\n/join <room>         Join a room\n/leave <room>        Leave a room\n/create <room>       Create a new room\n/private <user> <t>  Send private message\n/nick <name>         Change nickname\n/rooms               List available rooms\n/users               List users in current room\n/history             Show recent messages\n/ping                Ping server\n/quit                Disconnect\n/help                Show this help\nOr just type to send a message to the current room."
    let _ = send(fd, encode_system_msg(help_text, ts))
}

func handle_msg_cmd(fd: i64, nick: string, cmd: Record, user_mgr: UserManager, room_mgr: RoomManager) {
    let text = cmd_get_string(cmd, "text", "")
    if is_blank(text) { let ts = now_ms(); send(fd, encode_error_msg("Message text cannot be empty.", ts)); return }
    let mut room = user_manager_get_room(user_mgr, nick)
    if room == "" { room = DEFAULT_ROOM() }
    let ts = now_ms()
    let msg_json = encode_chat_msg(nick, room, text, ts)
    user_manager_push_history(user_mgr, msg_json)
    let members = room_manager_get_members(room_mgr, room)
    for member in members {
        let mfd = user_manager_get_fd(user_mgr, member)
        if mfd >= 0 { send(mfd, msg_json) }
    }
}

func handle_private_cmd(fd: i64, nick: string, cmd: Record, user_mgr: UserManager) {
    let target = cmd_get_string(cmd, "to", "")
    let text = cmd_get_string(cmd, "text", "")
    if is_blank(target) || is_blank(text) { let ts = now_ms(); send(fd, encode_error_msg("Usage: /private <user> <message>", ts)); return }
    let ts = now_ms()
    let target_fd = user_manager_get_fd(user_mgr, target)
    if target_fd < 0 { send(fd, encode_error_msg("User \"" + target + "\" not found.", ts)); return }
    let _ = send(target_fd, encode_private_msg(nick, target, text, ts))
    let _ = send(fd, encode_private_msg(nick, target, "(sent to " + target + ") " + text, ts))
}

func handle_join_cmd(fd: i64, nick: string, cmd: Record, user_mgr: UserManager, room_mgr: RoomManager) {
    let room_name = cmd_get_string(cmd, "room", "")
    if is_blank(room_name) { let ts = now_ms(); send(fd, encode_error_msg("Usage: /join <room>", ts)); return }
    let current_room = user_manager_get_room(user_mgr, nick)
    let result = result_message(room_manager_join(room_mgr, room_name, nick))
    if result == "ok" {
        let ts = now_ms()
        let set_room_error = unit_result_message(user_manager_set_room(user_mgr, nick, room_name))
        if set_room_error != "" { let _ = send(fd, encode_error_msg(set_room_error, ts)) }
        if current_room != "" && current_room != room_name {
            let leave_error = result_message(room_manager_leave(room_mgr, current_room, nick))
            if leave_error != "ok" { let _ = send(fd, encode_error_msg(leave_error, ts)) }
            let old_members = room_manager_get_members(room_mgr, current_room)
            for om in old_members {
                let ofd = user_manager_get_fd(user_mgr, om)
                if ofd >= 0 && ofd != fd { send(ofd, encode_leave_msg(nick, current_room, ts)) }
            }
        }
        send(fd, encode_system_msg("Joined room \"" + room_name + "\"", ts))
        let new_members = room_manager_get_members(room_mgr, room_name)
        for nm in new_members {
            let nmfd = user_manager_get_fd(user_mgr, nm)
            if nmfd >= 0 && nmfd != fd { send(nmfd, encode_join_msg(nick, room_name, ts)) }
        }
    } else {
        let ts = now_ms()
        let _ = send(fd, encode_error_msg(result, ts))
    }
}

func handle_leave_cmd(fd: i64, nick: string, cmd: Record, user_mgr: UserManager, room_mgr: RoomManager) {
    let room_name = cmd_get_string(cmd, "room", "")
    if is_blank(room_name) { let ts = now_ms(); send(fd, encode_error_msg("Usage: /leave <room>", ts)); return }
    let result = result_message(room_manager_leave(room_mgr, room_name, nick))
    if result == "ok" {
        let ts = now_ms()
        send(fd, encode_system_msg("Left room \"" + room_name + "\"", ts))
        let members = room_manager_get_members(room_mgr, room_name)
        for m in members {
            let mfd = user_manager_get_fd(user_mgr, m)
            if mfd >= 0 { send(mfd, encode_leave_msg(nick, room_name, ts)) }
        }
        let current = user_manager_get_room(user_mgr, nick)
        if current == room_name {
            let def_join = result_message(room_manager_join(room_mgr, DEFAULT_ROOM(), nick))
            if def_join == "ok" {
                let set_room_error = unit_result_message(user_manager_set_room(user_mgr, nick, DEFAULT_ROOM()))
                if set_room_error == "" { let _ = send(fd, encode_system_msg("Switched to \"" + DEFAULT_ROOM() + "\"", ts)) }
                else { let _ = send(fd, encode_error_msg(set_room_error, ts)) }
            }
            else { let _ = send(fd, encode_error_msg(def_join, ts)) }
        }
    } else {
        let ts = now_ms()
        let _ = send(fd, encode_error_msg(result, ts))
    }
}

func handle_create_cmd(fd: i64, nick: string, cmd: Record, room_mgr: RoomManager) {
    let room_name = cmd_get_string(cmd, "room", "")
    if is_blank(room_name) { let ts = now_ms(); send(fd, encode_error_msg("Usage: /create <room>", ts)); return }
    let result = result_message(room_manager_create(room_mgr, room_name))
    let ts = now_ms()
    if result == "ok" { let _ = send(fd, encode_system_msg("Room \"" + room_name + "\" created.", ts)) }
    else { let _ = send(fd, encode_error_msg(result, ts)) }
}

func handle_nick_cmd(fd: i64, old_nick: string, cmd: Record, user_mgr: UserManager) -> string {
    let new_nick = cmd_get_string(cmd, "name", "")
    if is_blank(new_nick) { let ts = now_ms(); send(fd, encode_error_msg("Usage: /nick <newnick>", ts)); return old_nick }
    let result = result_message(user_manager_change_nick(user_mgr, fd, new_nick))
    if result == "" || result == "ok" {
        let ts = now_ms(); send(fd, encode_system_msg("You are now known as \"" + new_nick + "\".", ts)); new_nick
    } else {
        let ts = now_ms(); send(fd, encode_error_msg(result, ts)); old_nick
    }
}

func handle_rooms_cmd(fd: i64, room_mgr: RoomManager) {
    let ts = now_ms()
    let room_list = room_manager_list_rooms(room_mgr)
    let _ = send(fd, encode_rooms_msg(room_list, ts))
}

func handle_users_cmd(fd: i64, room_mgr: RoomManager, user_mgr: UserManager, nick: string) {
    let room = user_manager_get_room(user_mgr, nick)
    let ts = now_ms()
    if room == "" {
        let all_nicks = user_manager_list_nicks(user_mgr)
        let _ = send(fd, encode_users_msg(all_nicks, ts))
    } else {
        let members = room_manager_get_members(room_mgr, room)
        let _ = send(fd, encode_users_msg(members, ts))
    }
}

func handle_kick_cmd(fd: i64, nick: string, cmd: Record, user_mgr: UserManager, room_mgr: RoomManager) {
    let target = cmd_get_string(cmd, "name", "")
    if is_blank(target) { let ts = now_ms(); send(fd, encode_error_msg("Usage: /kick <user>", ts)); return }
    let target_fd = user_manager_get_fd(user_mgr, target)
    if target_fd < 0 { let ts = now_ms(); send(fd, encode_error_msg("User \"" + target + "\" not found.", ts)); return }
    let ts = now_ms()
    let _ = send(target_fd, encode_system_msg("You have been kicked from the server.", ts))
    let _ = send(fd, encode_system_msg("Kicked \"" + target + "\" from the server.", ts))
    let room_error = unit_result_message(room_manager_remove_from_all(room_mgr, target))
    if room_error != "" { let _ = send(fd, encode_error_msg(room_error, ts)) }
    let _ = user_manager_unregister(user_mgr, target_fd)
}

func handle_topic_cmd(fd: i64, nick: string, cmd: Record, room_mgr: RoomManager, user_mgr: UserManager) {
    let room = user_manager_get_room(user_mgr, nick)
    let topic_text = cmd_get_string(cmd, "text", "")
    let ts = now_ms()
    if is_blank(topic_text) {
        let current = room_manager_get_topic(room_mgr, room)
        if is_blank(current) { let _ = send(fd, encode_system_msg("Room \"" + room + "\" has no topic set.", ts)) }
        else { let _ = send(fd, encode_topic_msg(room, current, ts)) }
    } else {
        let result = result_message(room_manager_set_topic(room_mgr, room, topic_text))
        if result == "ok" {
            let members = room_manager_get_members(room_mgr, room)
            for m in members {
                let mfd = user_manager_get_fd(user_mgr, m)
                if mfd >= 0 { let _ = send(mfd, encode_topic_msg(room, topic_text, ts)) }
            }
        } else { let _ = send(fd, encode_error_msg(result, ts)) }
    }
}

func broadcast_system_msg(text: string, room_mgr: RoomManager, user_mgr: UserManager) {
    let ts = now_ms()
    let rooms = room_manager_list_rooms(room_mgr)
    for rn in rooms {
        let members = room_manager_get_members(room_mgr, rn)
        for m in members {
            let mfd = user_manager_get_fd(user_mgr, m)
            if mfd >= 0 { send(mfd, encode_system_msg(text, ts)) }
        }
    }
}

func broadcast_nick_change(old_nick: string, new_nick: string, room_mgr: RoomManager, user_mgr: UserManager) {
    let ts = now_ms()
    let rooms = room_manager_list_rooms(room_mgr)
    for rn in rooms {
        let members = room_manager_get_members(room_mgr, rn)
        if list_contains_string(members, new_nick) || list_contains_string(members, old_nick) {
            for m in members {
                let mfd = user_manager_get_fd(user_mgr, m)
                if mfd >= 0 { send(mfd, encode_nick_msg(old_nick, new_nick, ts)) }
            }
        }
    }
}

// ═══════════════════════════════════════════════════════════════════════════════
// Section 8: Server — Connection Handler & Main Loop
// ═══════════════════════════════════════════════════════════════════════════════

func handle_connection(client_fd: i64, user_mgr: UserManager, room_mgr: RoomManager, history_file: string) -> i32 {
    let ts = now_ms()
    send(client_fd, encode_system_msg("Welcome to MimiChat! Please enter your nickname:", ts))
    let nick_raw = recv(client_fd, 256)
    let nick = str_trim(nick_raw)
    let mut current_nick = nick
    if !is_valid_nick(nick) {
        send(client_fd, encode_error_msg("Invalid nickname. Must be 2-16 alphanumeric characters. Disconnecting.", ts))
        sleep(100); close_fd(client_fd); return 1
    }
    if user_manager_nick_exists(user_mgr, nick) {
        send(client_fd, encode_error_msg("Nickname \"" + nick + "\" is already in use. Please reconnect with a different nick. Disconnecting.", ts))
        sleep(100); close_fd(client_fd); return 1
    }
    let reg_result = result_message(user_manager_register(user_mgr, nick, client_fd))
    if reg_result != "ok" {
        send(client_fd, encode_error_msg("Registration failed: " + reg_result + ". Disconnecting.", ts))
        sleep(100); close_fd(client_fd); return 1
    }
    let join_result = result_message(room_manager_join(room_mgr, DEFAULT_ROOM(), nick))
    if join_result == "ok" {
        let set_room_error = unit_result_message(user_manager_set_room(user_mgr, nick, DEFAULT_ROOM()))
        if set_room_error != "" { let _ = send(client_fd, encode_error_msg(set_room_error, now_ms())) }
    } else {
        let _ = send(client_fd, encode_error_msg(join_result, now_ms()))
    }
    let welcome_ts = now_ms()
    let motd = "Welcome to MimiChat, " + nick + "! Type /help for available commands."
    send(client_fd, encode_system_msg(motd, welcome_ts))
    let join_ts = now_ms()
    let members = room_manager_get_members(room_mgr, DEFAULT_ROOM())
    for member in members {
        let mfd = user_manager_get_fd(user_mgr, member)
        if mfd >= 0 && mfd != client_fd { send(mfd, encode_join_msg(nick, DEFAULT_ROOM(), join_ts)) }
    }
    let mut keep_running = true
    while keep_running {
        let raw = recv(client_fd, 4096)
        if len(raw) == 0 { keep_running = false }
        else {
            let parsed_cmd = parse_client_command_for_connection(raw, client_fd)
            if parsed_cmd.is_some() {
            let cmd = parsed_cmd.unwrap()
            let cmd_type = cmd_get_string(cmd, "cmd", "")
            if cmd_type == CMD_QUIT() || cmd_type == "exit" || cmd_type == "quit" { keep_running = false }
            else if cmd_type == CMD_HELP() { send_help(client_fd) }
            else if cmd_type == CMD_PING() { let pong_ts = now_ms(); let _ = send(client_fd, encode_pong_msg(pong_ts)) }
            else if cmd_type == CMD_MSG() { handle_msg_cmd(client_fd, current_nick, cmd, user_mgr, room_mgr) }
            else if cmd_type == CMD_PRIVATE() || cmd_type == "priv" || cmd_type == "whisper" || cmd_type == "tell" { handle_private_cmd(client_fd, current_nick, cmd, user_mgr) }
            else if cmd_type == CMD_JOIN() { handle_join_cmd(client_fd, current_nick, cmd, user_mgr, room_mgr) }
            else if cmd_type == CMD_LEAVE() { handle_leave_cmd(client_fd, current_nick, cmd, user_mgr, room_mgr) }
            else if cmd_type == CMD_CREATE() { handle_create_cmd(client_fd, current_nick, cmd, room_mgr) }
            else if cmd_type == CMD_NICK() {
                let new_result = handle_nick_cmd(client_fd, current_nick, cmd, user_mgr)
                if new_result != current_nick {
                    let old_nick = current_nick
                    current_nick = new_result
                    broadcast_nick_change(old_nick, current_nick, room_mgr, user_mgr)
                }
            }
            else if cmd_type == CMD_ROOMS() { handle_rooms_cmd(client_fd, room_mgr) }
            else if cmd_type == CMD_USERS() { handle_users_cmd(client_fd, room_mgr, user_mgr, current_nick) }
            else if cmd_type == CMD_TOPIC() { handle_topic_cmd(client_fd, current_nick, cmd, room_mgr, user_mgr) }
            else if cmd_type == CMD_KICK() { handle_kick_cmd(client_fd, current_nick, cmd, user_mgr, room_mgr) }
            else if cmd_type == CMD_MOTD() {
                let motd_text = cmd_get_string(cmd, "text", "")
                let motd_ts = now_ms()
                broadcast_system_msg("MOTD: " + motd_text, room_mgr, user_mgr)
                let _ = send(client_fd, encode_ok_msg("MOTD broadcast", motd_ts))
            }
            else if cmd_type == CMD_HISTORY() {
                let hist_ts = now_ms()
                let entries = user_manager_get_history(user_mgr, 50)
                let _ = send(client_fd, encode_history_msg(entries, hist_ts))
            }
            else if cmd_type == "" { }
            else {
                let err_ts = now_ms()
                let _ = send(client_fd, encode_error_msg("Unknown command: " + cmd_type + ". Type /help for commands.", err_ts))
            }
            drop(cmd)
            }
        }
    }
    let leave_ts = now_ms()
    let room_error = unit_result_message(room_manager_remove_from_all(room_mgr, current_nick))
    if room_error != "" { let _ = send(client_fd, encode_error_msg(room_error, leave_ts)) }
    user_manager_unregister(user_mgr, client_fd)
    let all_rooms = room_manager_list_rooms(room_mgr)
    for rn in all_rooms {
        let rmembers = room_manager_get_members(room_mgr, rn)
        for rm in rmembers {
            let rfd = user_manager_get_fd(user_mgr, rm)
            if rfd >= 0 { send(rfd, encode_leave_msg(current_nick, rn, leave_ts)) }
        }
    }
    close_fd(client_fd)
    0
}

func init_server(config: ServerConfig) -> Result<(i64, UserManager, RoomManager), i32> {
    let srv = socket(2, 1, 0) as i64
    if srv < 0 { println("FATAL: Failed to create socket"); exit(1) }
    let ret = bind(srv, config.port)
    if ret < 0 { println("FATAL: Failed to bind to port " + to_string(config.port)); close_fd(srv); exit(1) }
    let ret2 = listen(srv, config.max_clients)
    if ret2 < 0 { println("FATAL: Failed to listen on socket"); close_fd(srv); exit(1) }
    let um = UserManager.spawn()
    match user_manager_init(um) {
        Ok(()) => {},
        Err(status) => { user_manager_release_maps(um); close_fd(srv); return Err(status) }
    }
    let rm = RoomManager.spawn()
    match room_manager_init(rm) {
        Ok(()) => {},
        Err(status) => { room_manager_release_maps(rm); user_manager_release_maps(um); close_fd(srv); return Err(status) }
    }
    let (maybe_create_result, create_failed, create_status) = take_string_result(room_manager_create(rm, "lobby"))
    if create_failed {
        room_manager_release_maps(rm)
        user_manager_release_maps(um)
        close_fd(srv)
        return Err(create_status)
    }
    let create_result = maybe_create_result.unwrap()
    if create_result != "ok" {
        println("FATAL: Failed to initialize lobby: " + create_result)
        room_manager_release_maps(rm)
        user_manager_release_maps(um)
        close_fd(srv)
        return Err(1)
    }
    println("MimiChat v0.1.0 server started on port " + to_string(config.port))
    println("History file: " + config.history_file)
    println("Max clients: " + to_string(config.max_clients))
    Ok((srv, um, rm))
}

func run_server_loop(srv_fd: i64, user_mgr: UserManager, room_mgr: RoomManager, config: ServerConfig) -> i32 {
    let mut client_count = 0
    while true {
        let cfd = accept(srv_fd)
        if cfd < 0 { println("Accept failed, retrying..."); sleep(100) }
        else {
            client_count = client_count + 1
            println("New connection (#" + to_string(client_count) + "), fd=" + to_string(cfd))
            let _ = spawn handle_connection(cfd, user_mgr, room_mgr, config.history_file)
        }
    }
    0
}

func parse_server_args(args: List<string>) -> ServerConfig {
    let mut config = default_server_config()
    let mut i = 0
    while i < len(args) {
        let arg = args[i]
        if arg == "--port" && i + 1 < len(args) { let p = safe_parse_int(args[i + 1], config.port); config.port = p; i = i + 2 }
        else if arg == "--max-clients" && i + 1 < len(args) { let m = safe_parse_int(args[i + 1], config.max_clients); config.max_clients = m; i = i + 2 }
        else if arg == "--history-file" && i + 1 < len(args) { config.history_file = args[i + 1]; i = i + 2 }
        else if arg == "--max-history" && i + 1 < len(args) { let h = safe_parse_int(args[i + 1], config.max_history); config.max_history = h; i = i + 2 }
        else { i = i + 1 }
    }
    config
}

func print_server_usage() {
    println("Usage: mimichat server [options]")
    println("Options:")
    println("  --port <port>           Server port (default: 7777)")
    println("  --max-clients <n>       Max concurrent clients (default: 64)")
    println("  --history-file <path>   Message history file (default: mimichat_history.json)")
    println("  --max-history <n>       Max stored messages (default: 1000)")
}

// ═══════════════════════════════════════════════════════════════════════════════
// Section 9: Client — Receive & Display
// ═══════════════════════════════════════════════════════════════════════════════

func client_cmd(cmd_type: string) -> string {
    "{\"cmd\":\"" + escape_json_string(cmd_type) + "\"}"
}

func client_cmd_str(cmd_type: string, key: string, val: string) -> string {
    "{\"cmd\":\"" + escape_json_string(cmd_type) + "\",\"" + escape_json_string(key) + "\":\"" + escape_json_string(val) + "\"}"
}

func client_cmd_str2(cmd_type: string, k1: string, v1: string, k2: string, v2: string) -> string {
    "{\"cmd\":\"" + escape_json_string(cmd_type) + "\",\"" + escape_json_string(k1) + "\":\"" + escape_json_string(v1) + "\",\"" + escape_json_string(k2) + "\":\"" + escape_json_string(v2) + "\"}"
}

func client_receiver(fd: i64) -> i32 {
    while true {
        let data = recv(fd, 4096)
        if len(data) == 0 {
            println(""); println("╔══════════════════════════════════════╗"); println("║  Disconnected from server.           ║"); println("╚══════════════════════════════════════╝")
            exit(0); return 1
        }
        display_server_message(data)
    }
    0
}

func display_server_message(json_str: string) {
    if !json_is_valid(json_str) { println("Received invalid data: " + json_str); return }
    let msg_type = json_get_string(json_str, "type")
    let text = json_get_string(json_str, "text")
    let ts_raw = json_get_int(json_str, "ts")
    let time_str = format_timestamp(ts_raw)
    if msg_type == SVR_CHAT() {
        let from = json_get_string(json_str, "from")
        let room = json_get_string(json_str, "room")
        println(time_str + " [" + room + "] <" + from + "> " + text)
    } else if msg_type == SVR_PRIVATE() {
        let from = json_get_string(json_str, "from")
        println(time_str + " [PRIV] <" + from + "> " + text)
    } else if msg_type == SVR_SYSTEM() {
        println(time_str + " [SYS] " + text)
    } else if msg_type == SVR_JOIN() {
        let user = json_get_string(json_str, "user")
        let room = json_get_string(json_str, "room")
        println(time_str + " [JOIN] " + user + " joined " + room)
    } else if msg_type == SVR_LEAVE() {
        let user = json_get_string(json_str, "user")
        let room = json_get_string(json_str, "room")
        println(time_str + " [LEAVE] " + user + " left " + room)
    } else if msg_type == SVR_NICK() {
        let old_n = json_get_string(json_str, "old")
        let new_n = json_get_string(json_str, "new")
        println(time_str + " [NICK] " + old_n + " is now known as " + new_n)
    } else if msg_type == SVR_ERROR() {
        println(time_str + " [ERR] " + text)
    } else if msg_type == SVR_OK() {
        println(time_str + " [OK] " + text)
    } else if msg_type == SVR_PONG() { }
    else if msg_type == SVR_ROOMS() {
        let rooms_json = json_get_string(json_str, "rooms")
        if json_is_valid(rooms_json) {
            println(time_str + " [ROOMS] Available rooms:")
            let room_list = from_json::<List<string>>(rooms_json)
            for r in room_list { println("    - " + r) }
        }
    } else if msg_type == SVR_USERS() {
        let users_json = json_get_string(json_str, "users")
        if json_is_valid(users_json) {
            println(time_str + " [USERS] Online users:")
            let user_list = from_json::<List<string>>(users_json)
            for u in user_list { println("    - " + u) }
        }
    } else if msg_type == SVR_MOTD() {
        println(time_str + " [MOTD] " + text)
    } else if msg_type == SVR_HISTORY() { }
    else { println(time_str + " [???] " + json_str) }
}

func print_client_banner(host: string, port: i32) {
    println("")
    println("╔══════════════════════════════════════╗")
    println("║        MimiChat Client v0.1.0        ║")
    println("║  Connecting to " + host + ":" + to_string(port))
    println("╚══════════════════════════════════════╝")
    println("Type /help for commands.")
}

func connect_socket(host: string, port: i32) -> i64 {
    let fd = socket(2, 1, 0) as i64
    if fd < 0 { return -1 as i64 }
    let ret = connect(fd, host, port)
    if ret < 0 { close_fd(fd); return -1 as i64 }
    fd
}

func run_client(host: string, port: i32, nick: string) -> i32 {
    print_client_banner(host, port)
    let fd = connect_socket(host, port)
    if fd < 0 { println("Failed to connect to " + host + ":" + to_string(port)); return 1 }
    send(fd, nick + "\n")
    let welcome = recv(fd, 4096)
    if len(welcome) > 0 { display_server_message(welcome) }
    let recv_task = spawn client_receiver(fd)
    println("")
    while true {
        print("> ")
        let line = input()
        let trimmed = str_trim(line)
        if len(trimmed) == 0 { }
        if trimmed == "/quit" || trimmed == "/exit" {
            send(fd, client_cmd(CMD_QUIT()) + "\n"); sleep(200); close_fd(fd); println("Goodbye!"); return 0
        } else if trimmed == "/help" { send(fd, client_cmd(CMD_HELP()) + "\n") }
        else if trimmed == "/rooms" { send(fd, client_cmd(CMD_ROOMS()) + "\n") }
        else if trimmed == "/users" { send(fd, client_cmd(CMD_USERS()) + "\n") }
        else if trimmed == "/ping" { send(fd, client_cmd(CMD_PING()) + "\n") }
        else if str_starts_with(trimmed, "/join ") { let room = safe_substring(trimmed, 6, len(trimmed)); send(fd, client_cmd_str(CMD_JOIN(), "room", str_trim(room)) + "\n") }
        else if str_starts_with(trimmed, "/leave ") { let room = safe_substring(trimmed, 7, len(trimmed)); send(fd, client_cmd_str(CMD_LEAVE(), "room", str_trim(room)) + "\n") }
        else if str_starts_with(trimmed, "/create ") { let room = safe_substring(trimmed, 8, len(trimmed)); send(fd, client_cmd_str(CMD_CREATE(), "room", str_trim(room)) + "\n") }
        else if str_starts_with(trimmed, "/nick ") { let n2 = safe_substring(trimmed, 6, len(trimmed)); send(fd, client_cmd_str(CMD_NICK(), "name", str_trim(n2)) + "\n") }
        else if str_starts_with(trimmed, "/private ") || str_starts_with(trimmed, "/priv ") || str_starts_with(trimmed, "/whisper ") || str_starts_with(trimmed, "/tell ") {
            let after_cmd = str_split(trimmed, " ")
            if len(after_cmd) >= 3 {
                let target = after_cmd[1]
                let mut msg_text = ""
                let mut mi = 2
                while mi < len(after_cmd) {
                    if mi > 2 { msg_text = msg_text + " " }
                    msg_text = msg_text + after_cmd[mi]
                    mi = mi + 1
                }
                send(fd, client_cmd_str2(CMD_PRIVATE(), "to", target, "text", msg_text) + "\n")
            }
        }
        else if str_starts_with(trimmed, "/msg ") { let msg_text = safe_substring(trimmed, 5, len(trimmed)); send(fd, client_cmd_str(CMD_MSG(), "text", str_trim(msg_text)) + "\n") }
        else if str_starts_with(trimmed, "/") { send(fd, trimmed + "\n") }
        else { send(fd, client_cmd_str(CMD_MSG(), "text", trimmed) + "\n") }
    }
    0
}

func print_client_usage() {
    println("Usage: mimichat client [host] [port] [nick]")
    println("  host    Server hostname (default: 127.0.0.1)")
    println("  port    Server port (default: 7777)")
    println("  nick    Your nickname (default: user_NNNN)")
}

