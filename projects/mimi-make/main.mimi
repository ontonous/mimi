// mimi-make: A lightweight build tool for Mimi projects
//
// Usage: mimi run main.mimi [target]
//
// Known gap: push() inside if/while or through helper functions doesn't work.
// Workaround: parse and push at top level, skip empty rules during iteration.

// === Data types ===

type Rule {
    target: string,
    deps: List<string>,
    commands: List<string>,
}

type BuildFile {
    variables: Record,
    rules: List<Rule>,
}

// === Parser helpers ===

func is_blank(line: string) -> bool {
    str_trim(line) == ""
}

func is_comment(line: string) -> bool {
    if len(line) == 0 { return false }
    str_char_at(line, 0) == "#"
}

func is_variable(line: string) -> bool {
    let trimmed = str_trim(line)
    let eq = str_index_of(trimmed, "=")
    if !eq.is_some() { return false }
    !str_contains(trimmed, ":")
}

func is_continuation(line: string) -> bool {
    if len(line) == 0 { return false }
    str_char_at(line, 0) == "\t"
}

func find_char(s: string, ch: string) -> i32 {
    let result = str_index_of(s, ch)
    if result.is_some() { result.unwrap() } else { -1 }
}

func parse_variable(line: string) -> (string, string) {
    let trimmed = str_trim(line)
    let eq_pos = find_char(trimmed, "=")
    let name = str_trim(str_substring(trimmed, 0, eq_pos))
    let value = str_trim(str_substring(trimmed, eq_pos + 1, len(trimmed)))
    (name, value)
}

func make_rule(line: string) -> Rule {
    let empty = Rule { target: "", deps: [], commands: [] }
    if is_blank(line) || is_comment(line) || is_continuation(line) { return empty }
    if !str_contains(line, ":") { return empty }
    let trimmed = str_trim(line)
    let colon_pos = find_char(trimmed, ":")
    let target = str_trim(str_substring(trimmed, 0, colon_pos))
    let rest = str_trim(str_substring(trimmed, colon_pos + 1, len(trimmed)))
    let deps: List<string> = if is_blank(rest) { [] } else { str_split(rest, " ") }
    Rule { target: target, deps: deps, commands: [] }
}

// === Build file parsing (top-level push only) ===

func empty_rule() -> Rule {
    Rule { target: "", deps: [], commands: [] }
}

func empty_build_file_result() -> Result<BuildFile, i32> {
    match map_new() {
        Ok(vars) => Ok(BuildFile { variables: vars, rules: [] }),
        Err(status) => Err(status)
    }
}

func parse_one_or_blank(lines: List<string>, i: i32, vars: Result<Record, i32>, should_parse: bool) -> Result<(Rule, Record), i32> {
    match vars {
        Ok(root) => if should_parse { parse_one(lines, i, root) } else { Ok((empty_rule(), root)) },
        Err(status) => Err(status)
    }
}

func continue_parse(result: Result<(Rule, Record), i32>) -> (Rule, Result<Record, i32>) {
    match result {
        Ok((rule, vars)) => (rule, Ok(vars)),
        Err(status) => (empty_rule(), Err(status))
    }
}

func parse_build_file(path: string) -> Result<BuildFile, i32> {
    let result = read_file(path)
    if !result.is_ok() {
        println("Error: cannot read " + path)
        return empty_build_file_result()
    }
    let content = result.unwrap()
    let lines = str_split(content, "\n")
    let n = len(lines)
    let mut rules: List<Rule> = []

    // Parse and push at top level (one call per line, max 20 lines)
    let (r0, state0) = match map_new() {
        Ok(vars) => continue_parse(parse_one_or_blank(lines, 0, Ok(vars), n > 0)),
        Err(status) => (empty_rule(), Err(status))
    }
    let (r1, state1) = continue_parse(parse_one_or_blank(lines, 1, state0, n > 1))
    let (r2, state2) = continue_parse(parse_one_or_blank(lines, 2, state1, n > 2))
    let (r3, state3) = continue_parse(parse_one_or_blank(lines, 3, state2, n > 3))
    let (r4, state4) = continue_parse(parse_one_or_blank(lines, 4, state3, n > 4))
    let (r5, state5) = continue_parse(parse_one_or_blank(lines, 5, state4, n > 5))
    let (r6, state6) = continue_parse(parse_one_or_blank(lines, 6, state5, n > 6))
    let (r7, state7) = continue_parse(parse_one_or_blank(lines, 7, state6, n > 7))
    let (r8, state8) = continue_parse(parse_one_or_blank(lines, 8, state7, n > 8))
    let (r9, state9) = continue_parse(parse_one_or_blank(lines, 9, state8, n > 9))
    let (r10, state10) = continue_parse(parse_one_or_blank(lines, 10, state9, n > 10))
    let (r11, state11) = continue_parse(parse_one_or_blank(lines, 11, state10, n > 11))
    let (r12, state12) = continue_parse(parse_one_or_blank(lines, 12, state11, n > 12))
    let (r13, state13) = continue_parse(parse_one_or_blank(lines, 13, state12, n > 13))
    let (r14, state14) = continue_parse(parse_one_or_blank(lines, 14, state13, n > 14))
    let (r15, state15) = continue_parse(parse_one_or_blank(lines, 15, state14, n > 15))
    let (r16, state16) = continue_parse(parse_one_or_blank(lines, 16, state15, n > 16))
    let (r17, state17) = continue_parse(parse_one_or_blank(lines, 17, state16, n > 17))
    let (r18, state18) = continue_parse(parse_one_or_blank(lines, 18, state17, n > 18))
    let (r19, state19) = continue_parse(parse_one_or_blank(lines, 19, state18, n > 19))

    // Push all at top level
    push(rules, r0)
    push(rules, r1)
    push(rules, r2)
    push(rules, r3)
    push(rules, r4)
    push(rules, r5)
    push(rules, r6)
    push(rules, r7)
    push(rules, r8)
    push(rules, r9)
    push(rules, r10)
    push(rules, r11)
    push(rules, r12)
    push(rules, r13)
    push(rules, r14)
    push(rules, r15)
    push(rules, r16)
    push(rules, r17)
    push(rules, r18)
    push(rules, r19)

    match state19 {
        Ok(vars) => Ok(BuildFile { variables: vars, rules: rules }),
        Err(status) => Err(status)
    }
}

func parse_one(lines: List<string>, i: i32, vars: Record) -> Result<(Rule, Record), i32> {
    let line = lines[i]
    let rule = make_rule(line)
    if is_variable(line) {
        let pair = parse_variable(line)
        match map_set(vars, pair.0, pair.1) {
            Ok(updated) => {
                drop(vars)
                Ok((rule, updated))
            }
            Err(status) => {
                drop(vars)
                Err(status)
            }
        }
    } else {
        Ok((rule, vars))
    }
}

// === Build engine ===

func find_rule(rules: List<Rule>, target: string) -> Rule {
    let mut i = 0
    while i < len(rules) {
        let r = rules[i]
        if r.target == target {
            return r
        }
        i = i + 1
    }
    Rule { target: "", deps: [], commands: [] }
}

func count_rules(rules: List<Rule>) -> i32 {
    let mut count = 0
    let mut i = 0
    while i < len(rules) {
        if rules[i].target != "" {
            count = count + 1
        }
        i = i + 1
    }
    count
}

func needs_rebuild(target: string, deps: List<string>) -> bool {
    if !file_exists(target) {
        return true
    }
    let target_stat = file_stat(target)
    let target_time = target_stat.modified

    let mut i = 0
    while i < len(deps) {
        let dep = deps[i]
        if file_exists(dep) {
            let dep_stat = file_stat(dep)
            if dep_stat.modified > target_time {
                return true
            }
        }
        i = i + 1
    }
    false
}

func build_target(target: string, rules: List<Rule>, visited: Record) -> Result<(bool, Record), i32> {
    let v = map_get(visited, target)
    if v.0 {
        return Ok((true, visited))
    }

    let r = find_rule(rules, target)

    if r.target == "" {
        if file_exists(target) {
            return Ok((true, visited))
        }
        println("mimi-make: no rule to make target '" + target + "'")
        return Ok((false, visited))
    }

    let mut i = 0
    while i < len(r.deps) {
        match build_target(r.deps[i], rules, visited) {
            Ok((ok, updated_visited)) => {
                visited = updated_visited
                if !ok {
                    return Ok((false, visited))
                }
            }
            Err(status) => { return Err(status) }
        }
        i = i + 1
    }

    if !needs_rebuild(target, r.deps) {
        return Ok((true, visited))
    }

    i = 0
    while i < len(r.commands) {
        let cmd = r.commands[i]
        println("  > " + cmd)
        let result = exec(cmd)
        if result.exit_code != 0 {
            println("mimi-make: command failed (exit " + to_string(result.exit_code) + ")")
            if len(result.stderr) > 0 {
                println("  stderr: " + result.stderr)
            }
            return Ok((false, visited))
        }
        i = i + 1
    }

    match map_set(visited, target, true) {
        Ok(updated) => {
            drop(visited)
            Ok((true, updated))
        }
        Err(status) => {
            drop(visited)
            Err(status)
        }
    }
}

// === Main ===

func main() -> i32 {
    let build_file = "Makefile"
    let target = "all"

    let (maybe_bf, parse_failed, parse_status) = match parse_build_file(build_file) {
        Ok(parsed) => (Some(parsed), false, 0),
        Err(status) => (None, true, status)
    }
    if parse_failed {
        println("mimi-make: map allocation failed with status " + to_string(parse_status))
        return parse_status
    }
    let bf = maybe_bf.unwrap()
    let rules = bf.rules
    let num_rules = count_rules(rules)
    drop(bf.variables)
    println("mimi-make: found " + to_string(num_rules) + " rules in " + build_file)

    if num_rules == 0 {
        return 1
    }

    println("mimi-make: building '" + target + "'")

    let build_result = match map_new() {
        Ok(visited) => build_target(target, rules, visited),
        Err(status) => Err(status)
    }
    match build_result {
        Ok((ok, visited_after_build)) => {
            drop(visited_after_build)
            if ok {
                println("mimi-make: done")
                0
            } else {
                println("mimi-make: failed")
                1
            }
        }
        Err(status) => {
            println("mimi-make: visited-map update failed with status " + to_string(status))
            status
        }
    }
}
